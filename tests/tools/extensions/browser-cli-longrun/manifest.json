{
  "manifest_version": 3,
  "name": "Browser CLI Long-Run Probe",
  "version": "1.0.0",
  "description": "Test-only MV3 extension page that repaints on a timer and messages its service worker. Used by tests/tools/longrun-stability-gate.py; it is never installed in a product profile.",
  "key": "",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "longrun-probe"
  }
}
