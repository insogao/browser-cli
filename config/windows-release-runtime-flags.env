# Browser CLI Windows release-shape runtime flags (single source of truth).
#
# Consumed by tests/windows-release/harness/*.mjs (and documented in
# docs/windows-release-build-2026-10-28.md). This file records the runtime
# contract for the NON-COMPONENT out/WinRelease build. It does not sign,
# package or launch anything by itself.
#
# Why a runtime flag instead of a GN arg:
#   This Chromium revision has no `enable_features` GN arg, and this repository
#   must not edit Chromium sources for the release build. NetworkServiceSandbox
#   is therefore enabled at the product launch entry point. A public artifact
#   needs its own reviewed decision (see the doc): either the launcher always
#   passes this switch, or a reviewed Chromium patch flips the feature default.
#   Launching out/WinRelease/chrome.exe directly (no switch) leaves the network
#   utility process unsandboxed, exactly like WinDev/official Chrome without a
#   variations seed.

# Feature explicitly enabled for the release-shape build and smoke tests.
# Effect (verified): the network utility process becomes Low IL, AppContainer=1
# with ACG/CIG/extension-point/child-process/font/image-load policies, matching
# official Chrome with the same flag.
WINDOWS_RELEASE_ENABLE_FEATURES="NetworkServiceSandbox"

# Optional, evaluated but NOT enabled by default: pre-launch CIG for the
# network service. It only has an effect when NetworkServiceSandbox is enabled
# and only in non-component/non-ASAN builds, so WinRelease is the first build
# where it is even meaningful. It needs its own compatibility run (proxy,
# certificate, download paths) before a product decision; enabling it silently
# would exceed the "NetworkServiceSandbox only" scope of this validation.
WINDOWS_RELEASE_OPTIONAL_FEATURES=""

# Never enable this in a product build: it sets browser ACG before TSF init,
# Sogou's Xbyak JIT then fails VirtualProtect(PAGE_EXECUTE_READWRITE) and
# SogouPY calls ExitProcess(3). This is the reason
# disable_fieldtrial_testing_config=true is mandatory.
WINDOWS_RELEASE_FORBIDDEN_FEATURES="BrowserDynamicCodeDisabled"

# Flags that must never appear in a release-shape launch/smoke test.
#   --no-sandbox / --disable-gpu-sandbox : removes the security boundary
#   --in-process-gpu / --single-process  : moves GPU attack surface into the
#                                          Medium-IL browser process (and
#                                          --single-process is broken upstream)
#   --headless                           : no TSF/IME path; cannot be used as
#                                          TSF input evidence
#   --use-mock-keychain                  : macOS-only test switch; never on Windows
#   --disable-direct-composition         : not a valid presentation workaround
WINDOWS_RELEASE_FORBIDDEN_SWITCHES="--no-sandbox --disable-gpu-sandbox --in-process-gpu --single-process --headless --use-mock-keychain --disable-direct-composition"

# GPU/presentation shape: default out-of-process GPU. No GPU workaround flag.
WINDOWS_RELEASE_GPU_MODE="out-of-process"

# Every smoke run uses a fresh isolated profile created by the harness
# (fs.mkdtempSync); never the user's real Chrome/Browser CLI profile.
WINDOWS_RELEASE_PROFILE_POLICY="fresh-temp-per-run"
