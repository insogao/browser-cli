+
+namespace {
+// Independent user-data key; address identity is the key, not the value.
+const char kWindowRegistryKey = 0;
+}  // namespace
+
+class WindowOwnershipRegistry::Binding : public TabStripModelObserver {
+ public:
+  Binding(WindowOwnershipRegistry* registry, BrowserWindowInterface* browser)
+      : registry_(registry),
+        model_(browser->GetTabStripModel()),
+        session_id_(browser->GetSessionID()) {
+    record_.session_id = session_id_;
+    if (model_) {
+      model_->AddObserver(this);
+    }
+    close_subscription_ = browser->RegisterBrowserDidClose(
+        base::BindRepeating(&Binding::OnBrowserDidClose,
+                            weak_factory_.GetWeakPtr()));
+  }
+
+  ~Binding() override {
+    if (model_) {
+      model_->RemoveObserver(this);
+    }
+  }
+
+  Binding(const Binding&) = delete;
+  Binding& operator=(const Binding&) = delete;
+
+  const WindowRecord& record() const { return record_; }
+
+  void Set(WindowRecord record) {
+    record_ = std::move(record);
+    ApplyToExistingContents();
+  }
+
+  void Touch(base::TimeTicks now) { record_.last_ack = now; }
+
+  void ApplyToExistingContents() {
+    if (!model_) {
+      return;
+    }
+    const int count = model_->count();
+    for (int i = 0; i < count; ++i) {
+      content::WebContents* contents = model_->GetWebContentsAt(i);
+      if (contents) {
+        ApplyToNewContents(contents);
+      }
+    }
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    switch (change.type()) {
+      case TabStripModelChange::kInserted:
+        if (const TabStripModelChange::Insert* insert = change.GetInsert()) {
+          for (const TabStripModelChange::ContentsWithIndex& item :
+               insert->contents) {
+            if (item.contents) {
+              ApplyToNewContents(item.contents);
+            }
+          }
+        }
+        break;
+      case TabStripModelChange::kRemoved:
+        if (const TabStripModelChange::Remove* remove = change.GetRemove()) {
+          for (const TabStripModelChange::RemovedTab& item :
+               remove->contents) {
+            // A tab moved to another window must not keep this window's
+            // inherited mode. Explicit overrides survive the move by design.
+            if (item.contents &&
+                item.tab_detach_reason ==
+                    tabs::TabInterface::DetachReason::kInsertIntoOtherWindow) {
+              content::ClearInheritedInputOwnership(item.contents);
+            }
+          }
+        }
+        break;
+      case TabStripModelChange::kReplaced:
+        if (const TabStripModelChange::Replace* replace =
+                change.GetReplace()) {
+          ApplyReplace(replace->old_contents, replace->new_contents);
+        }
+        break;
+      case TabStripModelChange::kMoved:
+      case TabStripModelChange::kSelectionOnly:
+        break;
+    }
+  }
+
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override {
+    // Do not RemoveObserver() from here: the model is being destroyed and is
+    // iterating its observer list.
+    model_ = nullptr;
+    record_.dead = true;
+  }
+
+ private:
+  void OnBrowserDidClose(BrowserWindowInterface*) {
+    if (registry_) {
+      registry_->EraseWindow(session_id_);
+    }
+  }
+
+  void ApplyToNewContents(content::WebContents* contents) {
+    if (!record_.IsFresh(base::TimeTicks::Now())) {
+      return;
+    }
+    // kOverridePresent is a normal skip: an explicit tab override always wins.
+    const content::InputOwnershipApplyResult applied =
+        content::SetInputOwnership(contents, record_.mode, record_.version,
+                                   content::InputOwnershipOrigin::kInherited);
+    if (applied.result ==
+        content::InputOwnershipWriteResult::kStaleVersion) {
+      // A tab moved from a window with a higher inherited version: the target
+      // window is now authoritative, so drop the old inherited state and retry.
+      content::ClearInheritedInputOwnership(contents);
+      content::SetInputOwnership(contents, record_.mode, record_.version,
+                                 content::InputOwnershipOrigin::kInherited);
+    }
+  }
+
+  void ApplyReplace(content::WebContents* old_contents,
+                    content::WebContents* new_contents) {
+    if (!new_contents) {
+      return;
+    }
+    if (old_contents) {
+      const content::InputOwnershipSnapshot old =
+          content::GetInputOwnershipSnapshot(old_contents);
+      if (old.origin == content::InputOwnershipOrigin::kExplicit &&
+          old.version != 0) {
+        // A per-tab override must survive prerender/discard replacement.
+        content::SetInputOwnership(new_contents, old.mode, old.version,
+                                   content::InputOwnershipOrigin::kExplicit);
+        return;
+      }
+    }
+    ApplyToNewContents(new_contents);
+  }
+
+  raw_ptr<WindowOwnershipRegistry> registry_;
+  raw_ptr<TabStripModel> model_;
+  const SessionID session_id_;
+  WindowRecord record_;
+  base::CallbackListSubscription close_subscription_;
+  base::WeakPtrFactory<Binding> weak_factory_{this};
+};
+
+WindowOwnershipRegistry::WindowOwnershipRegistry() = default;
+
+WindowOwnershipRegistry::~WindowOwnershipRegistry() = default;
+
+// static
+WindowOwnershipRegistry* WindowOwnershipRegistry::GetForBrowserContext(
+    content::BrowserContext* browser_context) {
+  if (!browser_context || browser_context->IsOffTheRecord()) {
+    return nullptr;
+  }
+  if (auto* existing = GetIfExistsForBrowserContext(browser_context)) {
+    return existing;
+  }
+  auto registry = std::make_unique<WindowOwnershipRegistry>();
+  auto* raw = registry.get();
+  browser_context->SetUserData(&kWindowRegistryKey, std::move(registry));
+  return raw;
+}
+
+// static
+WindowOwnershipRegistry* WindowOwnershipRegistry::GetIfExistsForBrowserContext(
+    content::BrowserContext* browser_context) {
+  if (!browser_context) {
+    return nullptr;
+  }
+  return static_cast<WindowOwnershipRegistry*>(
+      browser_context->GetUserData(&kWindowRegistryKey));
+}
+
+WindowOwnershipRegistry::Binding* WindowOwnershipRegistry::GetBinding(
+    const SessionID& session_id) const {
+  auto it = bindings_.find(session_id);
+  return it == bindings_.end() ? nullptr : it->second.get();
+}
+
+WindowOwnershipRegistry::Binding*
+WindowOwnershipRegistry::GetOrCreateBinding(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return nullptr;
+  }
+  const SessionID& session_id = browser->GetSessionID();
+  if (!session_id.is_valid()) {
+    return nullptr;
+  }
+  if (Binding* existing = GetBinding(session_id)) {
+    return existing;
+  }
+  auto binding = std::make_unique<Binding>(this, browser);
+  Binding* raw = binding.get();
+  bindings_[session_id] = std::move(binding);
+  return raw;
+}
+
+WindowApplyResult WindowOwnershipRegistry::SetOwnership(
+    BrowserWindowInterface* browser,
+    content::InputOwnershipMode mode,
+    uint64_t version) {
+  WindowApplyResult result;
+  Binding* binding = GetOrCreateBinding(browser);
+  if (!binding) {
+    result.result = content::InputOwnershipWriteResult::kUnknownTarget;
+    return result;
+  }
+  const WindowRecord& current = binding->record();
+  if (current.dead) {
+    result.result = content::InputOwnershipWriteResult::kUnknownTarget;
+    result.record = current;
+    return result;
+  }
+  if (current.version != 0 && version < current.version) {
+    result.result = content::InputOwnershipWriteResult::kStaleVersion;
+    result.record = current;
+    return result;
+  }
+  if (current.version != 0 && version == current.version &&
+      mode != current.mode) {
+    result.result = content::InputOwnershipWriteResult::kVersionConflict;
+    result.record = current;
+    return result;
+  }
+
+  WindowRecord next = current;
+  next.mode = mode;
+  next.version = version;
+  next.last_ack = base::TimeTicks::Now();
+  next.dead = false;
+  binding->Set(next);
+  result.result = content::InputOwnershipWriteResult::kAccepted;
+  result.record = binding->record();
+  return result;
+}
+
+WindowApplyResult WindowOwnershipRegistry::Heartbeat(
+    BrowserWindowInterface* browser,
+    uint64_t version) {
+  WindowApplyResult result;
+  Binding* binding = browser ? GetBinding(browser->GetSessionID()) : nullptr;
+  if (!binding || binding->record().dead) {
+    result.result = content::InputOwnershipWriteResult::kUnknownTarget;
+    return result;
+  }
+  const WindowRecord& current = binding->record();
+  if (version < current.version) {
+    result.result = content::InputOwnershipWriteResult::kStaleVersion;
+    result.record = current;
+    return result;
+  }
+  if (version > current.version) {
+    result.result = content::InputOwnershipWriteResult::kVersionUnknown;
+    result.record = current;
+    return result;
+  }
+
+  binding->Touch(base::TimeTicks::Now());
+  if (binding->record().IsFresh(base::TimeTicks::Now())) {
+    binding->ApplyToExistingContents();
+  }
+  // `ApplyToExistingContents` deliberately skips explicit tabs through the
+  // content kOverridePresent result; touch their liveness separately.
+  if (TabStripModel* model = browser->GetTabStripModel()) {
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      const content::InputOwnershipSnapshot snapshot =
+          content::GetInputOwnershipSnapshot(contents);
+      if (snapshot.origin == content::InputOwnershipOrigin::kExplicit) {
+        content::TouchInputOwnership(contents);
+      }
+    }
+  }
+
+  result.result = content::InputOwnershipWriteResult::kAccepted;
+  result.record = binding->record();
+  return result;
+}
+
+bool WindowOwnershipRegistry::GetOwnership(BrowserWindowInterface* browser,
+                                           WindowRecord* out) const {
+  if (!browser || !out) {
+    return false;
+  }
+  Binding* binding = GetBinding(browser->GetSessionID());
+  if (!binding || binding->record().dead || binding->record().version == 0) {
+    return false;
+  }
+  *out = binding->record();
+  return true;
+}
+
+void WindowOwnershipRegistry::EraseWindow(const SessionID& session_id) {
+  bindings_.erase(session_id);
+}
+
+}  // namespace extensions::browser_cli_input_ownership
