+#include "base/time/time.h"
+#include "components/sessions/core/session_id.h"
+#include "content/public/browser/input_ownership.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace extensions::browser_cli_input_ownership {
+
+// Last accepted window snapshot. This is a cache of the extension-owned truth,
+// never a second source of truth: per-WebContents state remains authoritative.
+struct WindowRecord {
+  content::InputOwnershipMode mode = content::InputOwnershipMode::kAssist;
+  uint64_t version = 0;
+  base::TimeTicks last_ack;
+  SessionID session_id = SessionID::InvalidValue();
+  bool dead = false;
+
+  bool IsFresh(base::TimeTicks now) const {
+    return !dead && version != 0 && !last_ack.is_null() &&
+           now - last_ack <= content::InputOwnershipStaleAfter();
+  }
+};
+
+struct WindowApplyResult {
+  content::InputOwnershipWriteResult result =
+      content::InputOwnershipWriteResult::kFeatureDisabled;
+  WindowRecord record;
+};
+
+// Per-BrowserContext registry of window snapshots and their tab-strip
+// observers. It is created lazily by the first successful
+// setOwnership({windowId}); feature-off/untrusted callers never create it.
+class WindowOwnershipRegistry : public base::SupportsUserData::Data {
+ public:
+  static WindowOwnershipRegistry* GetForBrowserContext(
+      content::BrowserContext* browser_context);
+  static WindowOwnershipRegistry* GetIfExistsForBrowserContext(
+      content::BrowserContext* browser_context);
+
+  WindowOwnershipRegistry();
+  ~WindowOwnershipRegistry() override;
+
+  WindowOwnershipRegistry(const WindowOwnershipRegistry&) = delete;
+  WindowOwnershipRegistry& operator=(const WindowOwnershipRegistry&) = delete;
+
+  WindowApplyResult SetOwnership(BrowserWindowInterface* browser,
+                                 content::InputOwnershipMode mode,
+                                 uint64_t version);
+  WindowApplyResult Heartbeat(BrowserWindowInterface* browser,
+                              uint64_t version);
+  bool GetOwnership(BrowserWindowInterface* browser, WindowRecord* out) const;
+  void EraseWindow(const SessionID& session_id);
+
+ private:
+  class Binding;
+
+  Binding* GetBinding(const SessionID& session_id) const;
+  Binding* GetOrCreateBinding(BrowserWindowInterface* browser);
+
+  std::map<SessionID, std::unique_ptr<Binding>> bindings_;
+};
+
+}  // namespace extensions::browser_cli_input_ownership
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_INPUT_OWNERSHIP_BROWSER_CLI_INPUT_OWNERSHIP_WINDOW_BINDINGS_H_
