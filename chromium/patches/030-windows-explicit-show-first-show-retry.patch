+
+// Shows and activates `widget`, and repeats both calls exactly once while the
+// window is still not visible.
+//
+// Windows resolves the first ShowWindow call of a window against STARTUPINFO's
+// wShowWindow when the process was started with STARTF_USESHOWWINDOW (the same
+// rule the SW_HIDE correction in HWNDMessageHandler::Show documents): a request
+// whose state differs from that startup value is silently ignored and leaves
+// the HWND hidden. A browser process started by a hidden-console host (node's
+// windowsHide, a Windows service, a CI runner) therefore ignores the first
+// Show() of a managed window whose creation-time show the policy denied. The
+// ignored call is not an error; the next Show() is a regular ShowWindow and is
+// honored. The retry runs only while the window is still invisible, so a
+// window the first Show already presented is never touched twice, and both
+// attempts re-check the shared policy through the host gates.
+bool ShowAndActivateWithFirstShowRetry(Widget* widget) {
+  widget->Show();
+  widget->Activate();
+  if (widget->IsVisible()) {
+    return true;
+  }
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+            << " transition=presentation-retry"
+            << " window_id=" << WindowIdForWidget(widget)
+            << " reason=first-showwindow-not-honored native=win-hwnd";
+  widget->Show();
+  widget->Activate();
+  return widget->IsVisible();
 }
 
 }  // namespace
@@ -67,6 +96,16 @@
   return !policy->AllowPresentation(
       ForegroundOrigin::kUnknown,
       BrowserCliPresentationAction::kShowAndActivate, window_id);
+}
+
+bool BrowserCliPresentForUserExplicitAction(Widget* widget) {
+  // A non-top-level widget resolves to window id 0, which never establishes
+  // per-window HUMAN ownership; fail closed instead of presenting it.
+  if (!widget || !widget->is_top_level()) {
+    return false;
+  }
+  ScopedForegroundOrigin user_scope(ForegroundOrigin::kUserExplicit);
+  return ShowAndActivateWithFirstShowRetry(widget);
 }
 
