diff --git a/ui/views/widget/browser_cli_presentation_win.cc b/ui/views/widget/browser_cli_presentation_win.cc
new file mode 100644
index 00000000..5373b09c
--- /dev/null
+++ b/ui/views/widget/browser_cli_presentation_win.cc
@@ -0,0 +1,92 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/widget/browser_cli_presentation_win.h"
+
+#include "base/logging.h"
+#include "base/win/windows_handle_util.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/views/widget/widget.h"
+
+namespace views {
+namespace {
+
+// Resolves the policy key of `widget`'s top-level native window. Returns 0
+// when the widget or its HWND cannot be resolved; the managed policy denies
+// window id 0 for every presenting action (fail closed).
+uint64_t WindowIdForWidget(Widget* widget) {
+  if (!widget || !widget->is_top_level()) {
+    return 0;
+  }
+  aura::Window* native_window = widget->GetNativeWindow();
+  if (!native_window) {
+    return 0;
+  }
+  aura::WindowTreeHost* host = native_window->GetHost();
+  return host ? BrowserCliWindowIdForHwnd(host->GetAcceleratedWidget()) : 0;
+}
+
+}  // namespace
+
+uint64_t BrowserCliWindowIdForHwnd(HWND hwnd) {
+  // HWNDs are 32-bit significant on 64-bit Windows; the policy key stays a
+  // plain 64-bit value so both platforms speak the same vocabulary.
+  return static_cast<uint64_t>(base::win::HandleToUint32(hwnd));
+}
+
+bool BrowserCliAllowsPresentation(Widget* widget,
+                                  BrowserCliPresentationAction action) {
+  const uint64_t window_id = WindowIdForWidget(widget);
+  const bool allow = BrowserCliPresentationPolicy::Get()->AllowPresentation(
+      CurrentForegroundOrigin(), action, window_id);
+  if (!allow) {
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host decision=deny"
+              << " action=" << static_cast<int>(action)
+              << " window_id=" << window_id
+              << " reason=policy-denied native=win-hwnd";
+  }
+  return allow;
+}
+
+bool BrowserCliShouldSuppressWindowPosChange(HWND hwnd) {
+  BrowserCliPresentationPolicy* policy = BrowserCliPresentationPolicy::Get();
+  if (!policy->IsManagedModeEnabled()) {
+    return false;
+  }
+  const uint64_t window_id = BrowserCliWindowIdForHwnd(hwnd);
+  // Mirror the macOS AppKit hard stop, which is only armed for windows the
+  // user does not own: a HUMAN-owned or assist-leased window must keep
+  // answering the user's native window controls (taskbar, system menu). The
+  // origin is deliberately unknown here; no producer attributed this request.
+  if (policy->IsUserExplicitOwned(window_id) ||
+      policy->IsForegroundAssistLeased(window_id)) {
+    return false;
+  }
+  return !policy->AllowPresentation(
+      ForegroundOrigin::kUnknown,
+      BrowserCliPresentationAction::kShowAndActivate, window_id);
+}
+
+void BrowserCliReleaseWindowState(HWND hwnd) {
+  const uint64_t window_id = BrowserCliWindowIdForHwnd(hwnd);
+  BrowserCliPresentationPolicy* policy = BrowserCliPresentationPolicy::Get();
+  policy->ReleaseUserExplicitOwnership(window_id, "window-destroyed");
+  policy->ReleaseForegroundAssist(
+      window_id, ForegroundAssistReleaseReason::kWindowDestroyed);
+}
+
+bool AllowProgrammaticWindowChangeFromCurrentOrigin(
+    gfx::NativeWindow native_window,
+    BrowserCliPresentationAction action) {
+  Widget* widget = Widget::GetWidgetForNativeWindow(native_window);
+  if (!widget) {
+    // No views host: stock behavior, exactly like the macOS definition.
+    return true;
+  }
+  return BrowserCliPresentationPolicy::Get()->AllowPresentation(
+      CurrentForegroundOrigin(), action, WindowIdForWidget(widget));
+}
+
+}  // namespace views
diff --git a/ui/views/widget/browser_cli_presentation_win.h b/ui/views/widget/browser_cli_presentation_win.h
new file mode 100644
index 00000000..40de2ecb
--- /dev/null
+++ b/ui/views/widget/browser_cli_presentation_win.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_VIEWS_WIDGET_BROWSER_CLI_PRESENTATION_WIN_H_
+#define UI_VIEWS_WIDGET_BROWSER_CLI_PRESENTATION_WIN_H_
+
+#include <stdint.h>
+
+#include "base/win/windows_types.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/views_export.h"
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+
+namespace views {
+
+class Widget;
+
+// Windows native presentation gateway (patch 016). This file maps native HWND
+// lifecycle and window operations onto the shared
+// BrowserCliPresentationPolicy; it never makes a presentation decision of its
+// own. All functions must be called on the browser UI thread.
+
+// Per-window stable key for policy bookkeeping, derived from the HWND.
+// HWND values are reused by the OS after destroy, so a key is only meaningful
+// for a live window; callers must release ownership on destruction.
+VIEWS_EXPORT uint64_t BrowserCliWindowIdForHwnd(HWND hwnd);
+
+// Evaluates `action` for `widget`'s window with the origin currently scoped on
+// this thread. A null or non-top-level widget resolves to window id 0, which
+// the managed policy denies; managed mode off keeps stock behavior.
+VIEWS_EXPORT bool BrowserCliAllowsPresentation(
+    Widget* widget,
+    BrowserCliPresentationAction action);
+
+// Whether a WINDOWPOS change that carries SWP_SHOWWINDOW must have that flag
+// stripped. Returns false while managed presentation is disabled (stock
+// behavior) and true when the HWND cannot be resolved in managed mode (fail
+// closed).
+VIEWS_EXPORT bool BrowserCliShouldSuppressWindowPosChange(HWND hwnd);
+
+// Releases the per-window USER_EXPLICIT/HUMAN ownership and any foreground
+// assist lease when the HWND is destroyed, so a recycled HWND can never
+// inherit the previous window's state. Mirrors the macOS host destructor at
+// ui/views/cocoa/native_widget_mac_ns_window_host.mm.
+VIEWS_EXPORT void BrowserCliReleaseWindowState(HWND hwnd);
+
+// Windows definition of the free function declared in
+// browser_cli_presentation_policy.h. Returns true when `native_window` has no
+// views host (stock behavior).
+VIEWS_EXPORT bool AllowProgrammaticWindowChangeFromCurrentOrigin(
+    gfx::NativeWindow native_window,
+    BrowserCliPresentationAction action);
+
+}  // namespace views
+
+#endif  // UI_VIEWS_WIDGET_BROWSER_CLI_PRESENTATION_WIN_H_
