+++ b/ui/views/widget/browser_cli_presentation_win_unittest.cc
@@ -0,0 +1,137 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/widget/browser_cli_presentation_win.h"
+
+#include <windows.h>
+
+#include <memory>
+
+#include "base/run_loop.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/test/widget_test.h"
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+#include "ui/views/widget/widget.h"
+
+namespace views {
+namespace {
+
+// Windows tests for the Browser CLI native presentation gateway. The tests
+// create real HWNDs because the suppression path is a native window-procedure
+// behavior that no pure test can exercise. No test makes a window visible:
+// the gateway decisions and the native SWP_SHOWWINDOW strip are asserted while
+// the HWND stays hidden.
+class BrowserCliPresentationWinTest : public test::DesktopWidgetTest {
+ public:
+  void SetUp() override {
+    test::DesktopWidgetTest::SetUp();
+    BrowserCliPresentationPolicy::Get()->ResetForTesting();
+    BrowserCliPresentationPolicy::Get()->SetManagedModeEnabledForTesting(true);
+  }
+
+  void TearDown() override {
+    BrowserCliPresentationPolicy::Get()->ResetForTesting();
+    test::DesktopWidgetTest::TearDown();
+  }
+
+  std::unique_ptr<Widget> CreateWidget() {
+    auto widget = std::make_unique<Widget>();
+    Widget::InitParams params =
+        CreateParams(Widget::InitParams::CLIENT_OWNS_WIDGET,
+                     Widget::InitParams::TYPE_WINDOW);
+    widget->Init(std::move(params));
+    return widget;
+  }
+
+  static HWND HwndForWidget(Widget* widget) {
+    return widget->GetNativeWindow()->GetHost()->GetAcceleratedWidget();
+  }
+
+  static uint64_t WindowIdForWidget(Widget* widget) {
+    return BrowserCliWindowIdForHwnd(HwndForWidget(widget));
+  }
+};
+
+TEST_F(BrowserCliPresentationWinTest,
+       UnownedManagedWindowDeniesPresentation) {
+  std::unique_ptr<Widget> widget = CreateWidget();
+
+  EXPECT_FALSE(BrowserCliAllowsPresentation(
+      widget.get(), BrowserCliPresentationAction::kShowAndActivate));
+  EXPECT_FALSE(::IsWindowVisible(HwndForWidget(widget.get())));
+}
+
+TEST_F(BrowserCliPresentationWinTest,
+       UserExplicitOwnershipAllowsPresentation) {
+  std::unique_ptr<Widget> widget = CreateWidget();
+  const uint64_t window_id = WindowIdForWidget(widget.get());
+  ASSERT_NE(window_id, 0u);
+
+  // The query is made from an explicitly scoped trusted path. The default
+  // kUnknown origin is denied on a HUMAN-owned window by the shared policy.
+  ScopedForegroundOrigin trusted_scope(ForegroundOrigin::kInternal);
+  EXPECT_FALSE(BrowserCliAllowsPresentation(
+      widget.get(), BrowserCliPresentationAction::kShowAndActivate));
+  EXPECT_FALSE(::IsWindowVisible(HwndForWidget(widget.get())));
+
+  ASSERT_TRUE(BrowserCliPresentationPolicy::Get()->AllowPresentation(
+      ForegroundOrigin::kUserExplicit,
+      BrowserCliPresentationAction::kShowAndActivate, window_id));
+  ASSERT_TRUE(
+      BrowserCliPresentationPolicy::Get()->IsUserExplicitOwned(window_id));
+  EXPECT_TRUE(BrowserCliAllowsPresentation(
+      widget.get(), BrowserCliPresentationAction::kShowAndActivate));
+  EXPECT_FALSE(::IsWindowVisible(HwndForWidget(widget.get())));
+}
+
+TEST_F(BrowserCliPresentationWinTest,
+       AgentAssistWithoutLeaseDeniesPresentation) {
+  std::unique_ptr<Widget> widget = CreateWidget();
+
+  ScopedForegroundOrigin agent_scope(ForegroundOrigin::kAgentAssist);
+  EXPECT_FALSE(BrowserCliAllowsPresentation(
+      widget.get(), BrowserCliPresentationAction::kShowAndActivate));
+}
+
+TEST_F(BrowserCliPresentationWinTest,
+       UnresolvableWindowSuppressesNativeChange) {
+  EXPECT_TRUE(BrowserCliShouldSuppressWindowPosChange(nullptr));
+  EXPECT_FALSE(BrowserCliAllowsPresentation(
+      nullptr, BrowserCliPresentationAction::kShowAndActivate));
+}
+
+TEST_F(BrowserCliPresentationWinTest, ExternalWindowPosShowIsSuppressed) {
+  std::unique_ptr<Widget> widget = CreateWidget();
+  HWND hwnd = HwndForWidget(widget.get());
+  ASSERT_TRUE(BrowserCliShouldSuppressWindowPosChange(hwnd));
+  ASSERT_FALSE(::IsWindowVisible(hwnd));
+
+  // An external process (or any caller below the views gateway) can call
+  // SetWindowPos directly. The native hard stop must strip SWP_SHOWWINDOW.
+  ::SetWindowPos(hwnd, nullptr, 0, 0, 0, 0,
+                 SWP_SHOWWINDOW | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER);
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_FALSE(::IsWindowVisible(hwnd));
+}
+
+TEST_F(BrowserCliPresentationWinTest,
+       ActivateMessageDoesNotCreateUserExplicitOwnership) {
+  std::unique_ptr<Widget> widget = CreateWidget();
+  const uint64_t window_id = WindowIdForWidget(widget.get());
+  ASSERT_FALSE(
+      BrowserCliPresentationPolicy::Get()->IsUserExplicitOwned(window_id));
+
+  ::PostMessageW(HwndForWidget(widget.get()), WM_ACTIVATE, WA_ACTIVE, 0);
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_FALSE(
+      BrowserCliPresentationPolicy::Get()->IsUserExplicitOwned(window_id));
+}
