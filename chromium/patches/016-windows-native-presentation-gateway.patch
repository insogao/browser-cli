new file mode 100644
index 00000000..8de71737
--- /dev/null
+++ b/chrome/browser/browser_cli/user_explicit_presentation_win.cc
@@ -0,0 +1,75 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/user_explicit_presentation.h"
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/logging.h"
+#include "base/notreached.h"
+#include "chrome/browser/browser_cli/user_explicit_show.h"
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+
+namespace browser_cli {
+namespace {
+
+// Structured producer log, matching the macOS producer vocabulary. The
+// presentation policy adds its own BROWSER_CLI_PRESENTATION decision log for
+// every actual request, so an allow/deny pair can always be correlated.
+void LogProducerOutcome(const char* result,
+                        const char* reason,
+                        bool managed_mode) {
+  LOG(INFO) << "BROWSER_CLI_USER_EXPLICIT_SHOW stage=producer"
+            << " result=" << result << " reason=" << reason
+            << " managed=" << (managed_mode ? "yes" : "no")
+            << " native=win-hwnd";
+}
+
+}  // namespace
+
+bool HandleUserExplicitShowRequest(
+    const base::CommandLine& command_line,
+    const base::FilePath& /*current_directory*/) {
+  const UserExplicitShowRequestClass request_class =
+      ClassifyUserExplicitShowRequest(command_line);
+  if (request_class == UserExplicitShowRequestClass::kNotRequested) {
+    return false;
+  }
+
+  const bool managed_mode =
+      views::BrowserCliPresentationPolicy::Get()->IsManagedModeEnabled();
+
+  // Patch 016 wires the shared policy and the native suppression, but not a
+  // native presentation path: every plan that would have to touch a window
+  // fails closed without creating, showing or activating one. The
+  // reusable-window lookup is therefore intentionally not performed; both
+  // presenting plans have the same not-implemented outcome.
+  switch (PlanUserExplicitShow(request_class, managed_mode,
+                               /*has_reusable_window=*/false)) {
+    case UserExplicitShowPlan::kNoAction:
+      if (request_class ==
+          UserExplicitShowRequestClass::kBlockedByLaunchArguments) {
+        // Never ride a URL / app / incognito launch into a USER_EXPLICIT
+        // presentation. The caller continues ordinary command-line processing,
+        // which creates only background-managed windows.
+        LogProducerOutcome("denied", "launch-arguments-not-user-explicit",
+                           managed_mode);
+      } else {
+        // Stock Chromium already presents its own windows; the producer must
+        // not add a duplicate visibility path or a duplicate window.
+        LogProducerOutcome("noop", "unmanaged-stock-behavior", managed_mode);
+      }
+      return false;
+
+    case UserExplicitShowPlan::kPresentExistingWindow:
+    case UserExplicitShowPlan::kCreateWindowThenPresent:
+      LogProducerOutcome("failed", "windows-gateway-not-implemented",
+                         managed_mode);
+      return true;
+  }
+
+  NOTREACHED();
+}
+
+}  // namespace browser_cli
