+void RootCompositorFrameSinkImpl::ActivatePendingRootFrameIfNeeded() {
+  const SurfaceId& root_surface_id = display_->CurrentSurfaceId();
+  if (!root_surface_id.is_valid())
+    return;
+
+  Surface* root_surface = support_->frame_sink_manager()
+                              ->surface_manager()
+                              ->GetSurfaceForId(root_surface_id);
+  if (!root_surface || !root_surface->HasPendingFrame())
+    return;
+
+  TRACE_EVENT0("viz",
+               "RootCompositorFrameSinkImpl::ActivatePendingRootFrameIfNeeded");
+  // A copy request can only be serviced by an aggregation, i.e. by a real
+  // display frame. If the root frame is still blocked on surface
+  // synchronization (for example a browser window whose toolbar surface never
+  // paints while the window is occluded), the display has no active root
+  // surface to draw and the request would stay queued until its deadline
+  // expires - which can take thousands of frames. Activate the pending frame
+  // now, using the same fallback semantics as an expired deadline, so the next
+  // display frame aggregates the embedded surfaces and services the request.
+  root_surface->ActivatePendingFrameForDeadline();
+}
