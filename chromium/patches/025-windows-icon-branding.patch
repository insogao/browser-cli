diff --git a/build/config/chrome_build.gni b/build/config/chrome_build.gni
index 4163d980..18bb4d82 100644
--- a/build/config/chrome_build.gni
+++ b/build/config/chrome_build.gni
@@ -107,6 +107,14 @@ declare_args() {
 declare_args() {
   # The path to the BRANDING file in chrome/app/theme.
   branding_file_path = "//chrome/app/theme/$branding_path_component/BRANDING"
+
+  # Browser CLI: directory (relative to //chrome) holding the Windows .ico
+  # assets. Empty selects the active Chromium branding directory. The Windows
+  # .rc files cannot derive their icon path from branding_file_path (they only
+  # branch on GOOGLE_CHROME_BRANDING), so a custom Windows brand needs this
+  # explicit directory. Files are generated by
+  # scripts/generate-windows-icons.py from the approved source.
+  browser_cli_win_icon_dir = ""
 }
 
 # Whether to enable built-in branding assets (logos & marketing snippets) for
diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 5c5a5f93..96df9a97 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -77,6 +77,8 @@ declare_args() {
   # assets `app.icns` and `Assets.car`. Empty selects the active Chromium
   # branding directory. Set to a custom directory to use custom artwork; the
   # assets are generated by scripts/generate-icons.sh from the approved source.
+  # The Windows counterpart `browser_cli_win_icon_dir` is declared in
+  # //build/config/chrome_build.gni so that //chrome/app can read it too.
   mac_app_icon_dir = ""
 }
 
@@ -260,6 +262,14 @@ if (!is_android && !is_mac) {
 
       defines += [ "CHROME_EXE_MAIN" ]
 
+      # Browser CLI: chrome_exe.rc selects its icon from
+      # BROWSER_CLI_WIN_ICON_DIR when defined; the .rc files cannot derive the
+      # path from branding_file_path. Empty keeps the stock Chromium icons.
+      if (browser_cli_win_icon_dir != "") {
+        defines +=
+            [ "BROWSER_CLI_WIN_ICON_DIR=\"//chrome/$browser_cli_win_icon_dir/\"" ]
+      }
+
       if (win_console_app) {
         defines += [ "WIN_CONSOLE_APP" ]
       } else {
diff --git a/chrome/app/BUILD.gn b/chrome/app/BUILD.gn
index eddd25c9..e228962f 100644
--- a/chrome/app/BUILD.gn
+++ b/chrome/app/BUILD.gn
@@ -61,6 +61,17 @@ source_set("chrome_dll_resources") {
       "//build:branding_buildflags",
       "//printing/buildflags",
     ]
+
+    # Browser CLI: chrome_dll.rc selects its icon from BROWSER_CLI_WIN_ICON when
+    # it is defined. The .rc preprocessor does not concatenate adjacent string
+    # literals, so the full path has to arrive as one macro value. Empty keeps
+    # the stock Chromium icons.
+    defines = []
+    if (browser_cli_win_icon_dir != "") {
+      defines += [
+        "BROWSER_CLI_WIN_ICON=\"theme\\\\browser_cli\\\\win\\\\chrome.ico\"",
+      ]
+    }
   }
 }
 
diff --git a/chrome/app/chrome_dll.rc b/chrome/app/chrome_dll.rc
index 02e08e0d..d3cd2e2a 100644
--- a/chrome/app/chrome_dll.rc
+++ b/chrome/app/chrome_dll.rc
@@ -173,6 +173,10 @@ IDR_X004_DEV        ICON                        "theme\google_chrome\win\chrome_
 IDR_X005_BETA       ICON                        "theme\google_chrome\win\chrome_beta.ico"
 #elif BUILDFLAG(GOOGLE_CHROME_FOR_TESTING_BRANDING)
 IDR_MAINFRAME       ICON                        "theme\google_chrome\google_chrome_for_testing\win\chrome.ico"
+#elif defined(BROWSER_CLI_WIN_ICON)
+// Browser CLI: the full icon path arrives as one macro value because the .rc
+// preprocessor does not concatenate adjacent string literals.
+IDR_MAINFRAME       ICON                        BROWSER_CLI_WIN_ICON
 #else
 IDR_MAINFRAME       ICON                        "theme\chromium\win\chromium.ico"
 #endif
