+  // callbacks that were already pending.
+  completions.clear();
+  const base::TimeTicks success_timestamp =
+      failure_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      late_token + 1, MakeSuccessfulTimingDetails(success_timestamp));
+  ASSERT_EQ(completions.size(), kPressureLimit);
+  for (const RecordedCompletion& completion : completions) {
+    EXPECT_NE(completion.frame_token, late_token);
