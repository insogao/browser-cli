+// Regression test for windows that keep committing frames that are never
+// presented (a managed window whose native presentation is suppressed): the
+// callback queue must stay bounded instead of growing until the
+// kMaxBufferSize DCHECK kills the renderer.
+TEST(LayerTreeViewTest, PresentationCallbackQueueBoundedWhenNeverPresented) {
+  base::test::TaskEnvironment task_environment;
+
+  cc::TestTaskGraphRunner test_task_graph_runner;
+  std::unique_ptr<PageScheduler> dummy_page_scheduler =
+      scheduler::CreateDummyPageScheduler();
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  LayerTreeView layer_tree_view(
+      &layer_tree_view_delegate,
+      dummy_page_scheduler->CreateWidgetScheduler(/*delegate=*/nullptr));
+
+  layer_tree_view.Initialize(
+      cc::LayerTreeSettings(),
+      blink::scheduler::GetSingleThreadTaskRunnerForTesting(),
+      /*compositor_thread=*/nullptr, &test_task_graph_runner);
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  // Simulate 500 frames at the throttled ~1 Hz rate of a window that is never
+  // presented. Every frame is added a moment before the failure feedback for
+  // the previous frame arrives. Without the pressure limit this would trip the
+  // kMaxBufferSize DCHECK after 60 frames.
+  constexpr uint32_t kExtraFrames = 500;
+  for (uint32_t token = kPressureLimit + 1;
+       token <= kPressureLimit + kExtraFrames; ++token) {
+    AddRecordingCallbacks(layer_tree_view, token, token, completions);
+    layer_tree_view.DidPresentCompositorFrame(
+        token - 1, MakeFailedTimingDetails(base::TimeTicks::Now()));
+  }
+
+  // Every frame from kPressureLimit to kPressureLimit + kExtraFrames - 1
+  // received a failed presentation, which completed its callbacks with the
+  // failed details. The callbacks for the first kPressureLimit - 1 tokens and
+  // for the last token are still pending, so the queue stayed at the pressure
+  // limit instead of growing towards kMaxBufferSize.
+  ASSERT_EQ(completions.size(), static_cast<size_t>(kExtraFrames));
+  for (const RecordedCompletion& completion : completions) {
+    EXPECT_TRUE(completion.failed);
+  }
+  EXPECT_EQ(completions.front().frame_token, kPressureLimit);
+  EXPECT_EQ(completions.back().frame_token,
+            kPressureLimit + kExtraFrames - 1);
+}
