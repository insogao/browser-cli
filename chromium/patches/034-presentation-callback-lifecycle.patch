+  // The remaining callbacks are still pending and are completed by a later
+  // successful presentation.
+  completions.clear();
+  const base::TimeTicks success_timestamp =
+      failure_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      kPressureLimit, MakeSuccessfulTimingDetails(success_timestamp));
+  ASSERT_EQ(completions.size(), kPressureLimit - 1);
+  for (const RecordedCompletion& completion : completions) {
+    EXPECT_NE(completion.frame_token, failed_token);
+    EXPECT_FALSE(completion.failed);
+    EXPECT_EQ(completion.timestamp, success_timestamp);
+  }
