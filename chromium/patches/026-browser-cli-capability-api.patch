diff --git a/chrome/common/extensions/api/browser_cli.json b/chrome/common/extensions/api/browser_cli.json
new file mode 100644
index 0000000000000000000000000000000000000000..6ee7ba4ac8ebd8b2ded71be6e2cb9df29c2fcceb
--- /dev/null
+++ b/chrome/common/extensions/api/browser_cli.json
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Browser CLI capability discovery.
+//
+// This API exists so a single extension build (BrowserPilot) can decide at
+// runtime whether it is running inside Browser CLI or inside stock Chrome,
+// without inspecting the User-Agent, the product name or any other spoofable
+// signal. Its presence is the capability signal: stock Chrome does not generate
+// this namespace at all, so `chrome.browserCli` is simply undefined there and
+// the extension takes its generic path.
+//
+// It is allowlisted to trusted extension ids only (see _api_features.json), so
+// web pages and arbitrary extensions can never read it.
+[
+  {
+    "namespace": "browserCli",
+    "description": "none",
+    "types": [
+      {
+        "id": "Capabilities",
+        "type": "object",
+        "description": "Capabilities the running browser guarantees to an automation extension.",
+        "properties": {
+          "product": {
+            "type": "string",
+            "description": "Product name of the host browser, for logging only. Never infer capabilities from it; use the explicit flags below."
+          },
+          "browserVersion": {
+            "type": "string",
+            "description": "Full host browser version, for example \"156.0.8067.0\"."
+          },
+          "protocolVersion": {
+            "type": "integer",
+            "description": "Version of this capability contract. A caller that does not understand the value must degrade instead of guessing."
+          },
+          "managedMode": {
+            "type": "boolean",
+            "description": "True when the browser runs with managed background presentation enabled, so the AI presentation policy is in force."
+          },
+          "backgroundWindows": {
+            "type": "boolean",
+            "description": "True when extension-created windows can stay off the desktop and keep rendering."
+          },
+          "backgroundCapture": {
+            "type": "boolean",
+            "description": "True when a background window can be captured without being brought to the foreground."
+          },
+          "hardFocusIsolation": {
+            "type": "boolean",
+            "description": "True when automation origins are hard-denied focus on a window the user owns."
+          },
+          "foregroundAssist": {
+            "type": "boolean",
+            "description": "True when the browser exposes a foreground assist lease for login, captcha or confirmation."
+          },
+          "maxConcurrentWindows": {
+            "type": "integer",
+            "description": "Recommended upper bound for concurrently driven windows. The scheduler owns enforcement; this is the browser's recommendation."
+          }
+        }
+      }
+    ],
+    "functions": [
+      {
+        "name": "getCapabilities",
+        "type": "function",
+        "description": "Returns the capability descriptor of the running host browser.",
+        "parameters": [],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [
+            {
+              "$ref": "Capabilities",
+              "name": "capabilities"
+            }
+          ]
+        }
+      }
+    ]
+  }
+]
