diff --git a/chrome/browser/extensions/api/browser_cli/browser_cli_api.cc b/chrome/browser/extensions/api/browser_cli/browser_cli_api.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b757c65751ca5ee9bc8b028059808f803eb78b55
--- /dev/null
+++ b/chrome/browser/extensions/api/browser_cli/browser_cli_api.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/browser_cli/browser_cli_api.h"
+
+#include <string>
+
+#include "base/values.h"
+#include "chrome/common/extensions/api/browser_cli.h"
+#include "components/version_info/version_info.h"
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+
+namespace extensions {
+
+namespace browser_cli = api::browser_cli;
+
+namespace {
+
+// Bumped whenever the meaning of a capability field changes. A caller that does
+// not understand the value must degrade instead of guessing: guessing is the
+// exact failure mode this API exists to prevent.
+constexpr int kCapabilityProtocolVersion = 1;
+
+// Recommended ceiling for concurrently driven windows. The scheduler owns
+// enforcement (development plan Phase 7, requirement 8); this value only tells
+// the extension what the browser has been validated for.
+constexpr int kMaxConcurrentWindows = 8;
+
+}  // namespace
+
+BrowserCliGetCapabilitiesFunction::BrowserCliGetCapabilitiesFunction() = default;
+BrowserCliGetCapabilitiesFunction::~BrowserCliGetCapabilitiesFunction() =
+    default;
+
+ExtensionFunction::ResponseAction BrowserCliGetCapabilitiesFunction::Run() {
+  // Every capability below is answered from live state rather than from a build
+  // flag. The presentation policy is inert unless
+  // --browser-cli-background-presentation is on the command line, so this single
+  // reading decides every enhanced capability at once: without managed mode
+  // there is no presentation gate, no origin attribution and no lease, and
+  // claiming any of them would be a lie.
+  const bool managed_mode =
+      views::BrowserCliPresentationPolicy::Get()->IsManagedModeEnabled();
+
+  browser_cli::Capabilities capabilities;
+  capabilities.product = std::string(version_info::GetProductName());
+  capabilities.browser_version = std::string(version_info::GetVersionNumber());
+  capabilities.protocol_version = kCapabilityProtocolVersion;
+  capabilities.managed_mode = managed_mode;
+  capabilities.background_windows = managed_mode;
+  capabilities.background_capture = managed_mode;
+  capabilities.hard_focus_isolation = managed_mode;
+  capabilities.foreground_assist = managed_mode;
+
+  // A generic browser can still drive one window at a time. Reporting 1 instead
+  // of 0 keeps "no enhanced capability" and "zero windows allowed" distinct.
+  capabilities.max_concurrent_windows =
+      managed_mode ? kMaxConcurrentWindows : 1;
+
+  return RespondNow(ArgumentList(
+      browser_cli::GetCapabilities::Results::Create(capabilities)));
+}
+
+}  // namespace extensions
