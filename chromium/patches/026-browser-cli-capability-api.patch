@@ -0,0 +1,43 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_BROWSER_CLI_API_H_
+#define CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_BROWSER_CLI_API_H_
+
+#include "extensions/browser/extension_function.h"
+#include "extensions/browser/extension_function_histogram_value.h"
+
+namespace extensions {
+
+// chrome.browserCli.getCapabilities (development plan Phase 7).
+//
+// Answers "is this Browser CLI, and which capabilities does it actually
+// guarantee right now?" without handing a web page any observable signal.
+//
+// The reply is derived from live browser state, not from a build flag alone:
+// `managedMode` reads the presentation policy, so a run without
+// --browser-cli-background-presentation reports false for every enhanced
+// capability and the extension falls back to its generic path.
+class BrowserCliGetCapabilitiesFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("browserCli.getCapabilities",
+                             BROWSERCLI_GETCAPABILITIES)
+
+  BrowserCliGetCapabilitiesFunction();
+
+  BrowserCliGetCapabilitiesFunction(const BrowserCliGetCapabilitiesFunction&) =
+      delete;
+  BrowserCliGetCapabilitiesFunction& operator=(
+      const BrowserCliGetCapabilitiesFunction&) = delete;
+
+ protected:
+  ~BrowserCliGetCapabilitiesFunction() override;
+
+  // ExtensionFunction:
+  ResponseAction Run() override;
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_BROWSER_CLI_API_H_
