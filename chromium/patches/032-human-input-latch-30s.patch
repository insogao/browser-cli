diff --git a/content/browser/input_ownership/input_ownership_decider.cc b/content/browser/input_ownership/input_ownership_decider.cc
--- a/content/browser/input_ownership/input_ownership_decider.cc
+++ b/content/browser/input_ownership/input_ownership_decider.cc
@@ -36,7 +36,13 @@
 // Every human input event immediately suppresses all debugger input for this
 // long (refreshed on each human event). The pause is not debounced: as soon as
 // a human touches the tab, automation must stop changing the page.
-constexpr base::TimeDelta kHumanInputPause = base::Seconds(1);
+//
+// Patch 032: 30s is a liveness latch, not a one-second grace. If the extension
+// service worker is unresponsive (or its heartbeat never arrives), automation
+// must not re-grab the page after 1s. A responsive trusted extension clears the
+// latch explicitly with a new per-tab kExplicit setOwnership(); window
+// heartbeats/inherited writes never clear it.
+constexpr base::TimeDelta kHumanInputPause = base::Seconds(30);
 
 // Human presence is *reported* at most once per window; this only affects the
 // reporting counter, never the pause above.
@@ -520,7 +526,12 @@
         return result;
       }
       // Idempotent replay (same version, same mode): only refresh last_update
-      // so a replayed setOwnership() also acts as a heartbeat.
+      // so a replayed setOwnership() also acts as a heartbeat. An explicit
+      // per-tab replay is also the trusted acknowledgement that clears the
+      // human latch; an inherited window write must not.
+      if (origin == InputOwnershipOrigin::kExplicit) {
+        human_pause_until_ = base::TimeTicks();
+      }
       last_update_ = now;
       stale_ = false;
       result.result = InputOwnershipWriteResult::kAccepted;
@@ -533,11 +544,20 @@
   // change clears the grants (and stale gesture/scope state); a pure version
   // bump also clears them, because the embedder is re-establishing the whole
   // target state (design §1.2).
+  const bool explicit_new_state =
+      origin == InputOwnershipOrigin::kExplicit &&
+      (origin_ != InputOwnershipOrigin::kExplicit || version > version_);
   mode_ = mode;
   version_ = version;
   origin_ = origin;
   ClearDebuggerSessions();
   ClearAutomationEventWindow();
+  // Only a trusted per-tab explicit write may release the human latch. A
+  // window heartbeat / inherited write must never clear it, otherwise a dead
+  // service worker's periodic snapshot could hand the page back to AI.
+  if (explicit_new_state) {
+    human_pause_until_ = base::TimeTicks();
+  }
   last_update_ = now;
   stale_ = false;
 
diff --git a/content/public/browser/input_ownership.h b/content/public/browser/input_ownership.h
