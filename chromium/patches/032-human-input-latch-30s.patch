diff --git a/content/browser/input_ownership/input_ownership_controller_unittest.cc b/content/browser/input_ownership/input_ownership_controller_unittest.cc
--- a/content/browser/input_ownership/input_ownership_controller_unittest.cc
+++ b/content/browser/input_ownership/input_ownership_controller_unittest.cc
@@ -624,10 +624,61 @@
 
   // Human input keeps working during the pause.
   EXPECT_TRUE(HumanKey(Type::kKeyDown, now + base::Milliseconds(500)));
-  // ... and refreshes the pause: the debugger is still blocked at 1.4s.
-  EXPECT_FALSE(Mouse(Type::kMouseDown, SessionA(), now + base::Milliseconds(1400)));
-  // 1s after the last human event (now+500ms+1s) AI input resumes in AI mode.
-  EXPECT_TRUE(Mouse(Type::kMouseDown, SessionA(), now + base::Milliseconds(1600)));
+  // ... and refreshes the 30s latch: the debugger is still blocked at 29s.
+  EXPECT_FALSE(Mouse(Type::kMouseDown, SessionA(), now + base::Seconds(29)));
+  // 30s after the last human event (now+500ms+30s) AI input resumes in AI mode.
+  EXPECT_TRUE(Mouse(Type::kMouseDown, SessionA(),
+                    now + base::Seconds(30) + base::Milliseconds(600)));
+}
+
+// Patch 032: a dead/unresponsive extension must not regain input after 1s.
+// The 30s latch can only be released early by a trusted per-tab explicit write;
+// inherited window snapshots never release it.
+TEST_F(InputOwnershipDeciderTest, ExplicitUpdateClearsHumanLatchInheritedDoesNot) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAi, 1,
+                                  InputOwnershipOrigin::kInherited, now)
+                .result);
+  EXPECT_TRUE(HumanMouse(Type::kMouseMove, now));
+  EXPECT_TRUE(decider_.IsDebuggerInputPaused(now + base::Seconds(2)));
+
+  // A window snapshot arriving while the latch is active must not clear it.
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAi, 2,
+                                  InputOwnershipOrigin::kInherited,
+                                  now + base::Seconds(2))
+                .result);
+  EXPECT_TRUE(decider_.IsDebuggerInputPaused(now + base::Seconds(2)));
+
+  // A trusted per-tab explicit write does release it.
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAi, 1,
+                                  InputOwnershipOrigin::kExplicit,
+                                  now + base::Seconds(3))
+                .result);
+  EXPECT_FALSE(decider_.IsDebuggerInputPaused(now + base::Seconds(3)));
+}
+
+// An explicit idempotent write (same version/mode) is the trusted
+// acknowledgement that releases the human latch without a version bump.
+TEST_F(InputOwnershipDeciderTest, ExplicitIdempotentWriteClearsHumanLatch) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAssist, 1,
+                                  InputOwnershipOrigin::kExplicit, now)
+                .result);
+  EXPECT_TRUE(HumanMouse(Type::kMouseMove, now));
+  EXPECT_TRUE(decider_.IsDebuggerInputPaused(now + base::Seconds(2)));
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAssist, 1,
+                                  InputOwnershipOrigin::kExplicit,
+                                  now + base::Seconds(2))
+                .result);
+  EXPECT_FALSE(decider_.IsDebuggerInputPaused(now + base::Seconds(2)));
+  EXPECT_EQ(1u, decider_.snapshot().version);
 }
 
