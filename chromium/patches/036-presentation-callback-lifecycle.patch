+// Regression test for windows that keep committing frames that are never
+// presented (a managed window whose native presentation is suppressed): the
+// callback queue must stay bounded and every callback must still complete
+// exactly once, in frame token order, instead of growing towards the
+// kMaxBufferSize hard limit.
+TEST(LayerTreeViewTest, PresentationCallbackQueueBoundedWhenNeverPresented) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  // A burst of frames is registered before any feedback arrives.
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  // The failed feedbacks arrive out of order (viz may coalesce them while a
+  // window is not presented).
+  const base::TimeTicks timestamp = base::TimeTicks::Now();
+  for (uint32_t i = 0; i < kPressureLimit; ++i) {
+    const uint32_t token = (i * 7) % kPressureLimit + 1;
+    layer_tree_view.DidPresentCompositorFrame(
+        token, MakeFailedTimingDetails(timestamp + base::Microseconds(i)));
+  }
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit,
+                               /*failed=*/true);
+
+  // Simulate 500 further frames at the throttled ~1 Hz rate of a window that
+  // is never presented. Every frame's callback completes exactly once, in
+  // order, so the queue stays at a single pending entry instead of growing
+  // towards the kMaxBufferSize hard limit.
+  constexpr uint32_t kExtraFrames = 500;
+  for (uint32_t token = kPressureLimit + 1;
+       token <= kPressureLimit + kExtraFrames; ++token) {
+    AddRecordingCallbacks(layer_tree_view, token, token, completions);
+    layer_tree_view.DidPresentCompositorFrame(
+        token, MakeFailedTimingDetails(timestamp +
+                                       base::Microseconds(token)));
+  }
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit + kExtraFrames,
+                               /*failed=*/true);
+}
+
+// Verifies that losing the frame sink completes the pending callbacks with a
+// failed presentation: no feedback can arrive for those frame tokens any more.
+// Remembered failures of the lost sink are dropped so a replacement sink
+// cannot complete a callback with stale details.
+TEST(LayerTreeViewTest, FrameSinkLossCompletesPresentationCallbacks) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+  layer_tree_view.DidPresentCompositorFrame(
+      31, MakeFailedTimingDetails(base::TimeTicks::Now()));
+
+  layer_tree_view.DidLoseLayerTreeFrameSink();
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit,
+                               /*failed=*/true);
+  for (const RecordedCompletion& completion : completions) {
+    EXPECT_FALSE(completion.timestamp.is_null());
+  }
+
+  // The remembered failure for token 31 belongs to the lost frame sink. The
+  // replacement sink may reuse frame token 31, so registering it must not
+  // complete it with the stale failure.
+  completions.clear();
+  AddRecordingCallbacks(layer_tree_view, 31, 31, completions);
+  EXPECT_TRUE(completions.empty());
+
+  const base::TimeTicks success_timestamp = base::TimeTicks::Now();
+  layer_tree_view.DidPresentCompositorFrame(
+      32, MakeSuccessfulTimingDetails(success_timestamp));
+  ASSERT_EQ(completions.size(), 1u);
+  EXPECT_EQ(completions[0].frame_token, 31u);
+  EXPECT_FALSE(completions[0].failed);
+  EXPECT_EQ(completions[0].timestamp, success_timestamp);
+
+  // A replacement frame sink may restart its frame token sequence.
+  completions.clear();
+  AddRecordingCallbacks(layer_tree_view, 1, 2, completions);
+  const base::TimeTicks restarted_timestamp =
+      success_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      2, MakeSuccessfulTimingDetails(restarted_timestamp));
+  ExpectCompletedTokensInOrder(completions, 1, 2, /*failed=*/false);
+}
+
+// The threaded renderer never calls DidLoseLayerTreeFrameSink(); cc requests a
+// new frame sink instead. That request has the same lifecycle meaning for the
+// presentation callbacks of the previous sink.
+TEST(LayerTreeViewTest,
+     FrameSinkReplacementClearsPendingPresentationCallbacks) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+  layer_tree_view.DidPresentCompositorFrame(
+      31, MakeFailedTimingDetails(base::TimeTicks::Now()));
+
+  // A widget that was never visible buffers the request, but the callbacks of
+  // the previous frame sink are completed before that.
+  layer_tree_view.RequestNewLayerTreeFrameSink();
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit,
+                               /*failed=*/true);
+
+  completions.clear();
+  AddRecordingCallbacks(layer_tree_view, 31, 31, completions);
+  EXPECT_TRUE(completions.empty());
+
+  const base::TimeTicks success_timestamp = base::TimeTicks::Now();
+  layer_tree_view.DidPresentCompositorFrame(
+      32, MakeSuccessfulTimingDetails(success_timestamp));
+  ASSERT_EQ(completions.size(), 1u);
+  EXPECT_EQ(completions[0].frame_token, 31u);
+  EXPECT_FALSE(completions[0].failed);
+  EXPECT_EQ(completions[0].timestamp, success_timestamp);
+}
+
+// Simulates rapid show/hide cycles: every visibility change loses the frame
+// sink and the replacement sink restarts its frame token sequence. Every
+// registered callback must run exactly once.
+TEST(LayerTreeViewTest, RepeatedFrameSinkLossRunsEveryCallbackOnce) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  constexpr int kCycles = 5;
+  for (int cycle = 0; cycle < kCycles; ++cycle) {
+    AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+    // A failure for a frame whose callback never gets registered (the frame
+    // sink is lost first) must not survive into the next cycle.
+    layer_tree_view.DidPresentCompositorFrame(
+        kPressureLimit + 1,
+        MakeFailedTimingDetails(base::TimeTicks::Now()));
+    layer_tree_view.DidLoseLayerTreeFrameSink();
+  }
+
+  ASSERT_EQ(completions.size(),
+            static_cast<size_t>(kCycles) * kPressureLimit);
+  for (size_t i = 0; i < completions.size(); ++i) {
+    SCOPED_TRACE(testing::Message() << "completion index " << i);
+    EXPECT_EQ(completions[i].frame_token,
+              static_cast<uint32_t>(i % kPressureLimit + 1));
+    EXPECT_TRUE(completions[i].failed);
+  }
+}
