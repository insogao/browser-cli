+// Verifies that once the callback queue is at the pressure limit, failed
+// presentation feedbacks complete the known-failed prefix of the queue in frame
+// token order. Callbacks must never run out of registration order: consumers
+// such as paint timing and event timing assume increasing frame order.
+TEST(LayerTreeViewTest, FailedPresentationCompletesKnownFailedPrefixInOrder) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  const base::TimeTicks timestamp = base::TimeTicks::Now();
+  // A failure for a later frame token does not complete it while an earlier
+  // frame is still pending, because that would run its callback before the
+  // callback of the earlier frame.
+  layer_tree_view.DidPresentCompositorFrame(
+      kPressureLimit / 2, MakeFailedTimingDetails(timestamp));
+  EXPECT_TRUE(completions.empty());
+
+  // Failed feedbacks that arrive out of order still complete the queue in
+  // token order: only the contiguous prefix whose failure is known runs.
+  layer_tree_view.DidPresentCompositorFrame(
+      1, MakeFailedTimingDetails(timestamp + base::Microseconds(1)));
+  ExpectCompletedTokensInOrder(completions, 1, 1, /*failed=*/true);
+  layer_tree_view.DidPresentCompositorFrame(
+      3, MakeFailedTimingDetails(timestamp + base::Microseconds(2)));
+  ExpectCompletedTokensInOrder(completions, 1, 1, /*failed=*/true);
+  layer_tree_view.DidPresentCompositorFrame(
+      2, MakeFailedTimingDetails(timestamp + base::Microseconds(3)));
+  ExpectCompletedTokensInOrder(completions, 1, 3, /*failed=*/true);
+  ASSERT_EQ(completions.size(), 3u);
+  EXPECT_EQ(completions[1].timestamp, timestamp + base::Microseconds(3));
+  EXPECT_EQ(completions[2].timestamp, timestamp + base::Microseconds(2));
+
+  // A later successful presentation completes the remaining callbacks,
+  // including the frame whose failure was remembered but never consumed: a
+  // success supersedes a remembered failure.
+  completions.clear();
+  const base::TimeTicks success_timestamp =
+      timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      kPressureLimit, MakeSuccessfulTimingDetails(success_timestamp));
+  ExpectCompletedTokensInOrder(completions, 4, kPressureLimit,
+                               /*failed=*/false);
+  for (const RecordedCompletion& completion : completions) {
+    EXPECT_EQ(completion.timestamp, success_timestamp);
+  }
+}
