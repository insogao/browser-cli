+void LayerTreeView::CompleteFailedPresentationCallbacksInOrder() {
+  // Complete only from the front of the queue, so callbacks always run in
+  // frame token order. A successful presentation completes a prefix of the
+  // queue for the same reason, and consumers such as paint timing assign
+  // presentation times to pending paint records in frame order.
+  while (!presentation_callbacks_.empty()) {
+    const uint32_t frame_token = presentation_callbacks_.front().first;
+    std::optional<viz::FrameTimingDetails> failed_details =
+        TakeRememberedFailedPresentation(frame_token);
+    if (!failed_details) {
+      break;
+    }
+    // Move the callbacks out before running them: a callback may register a
+    // new presentation callback and invalidate the front entry.
+    std::vector<base::OnceCallback<void(const viz::FrameTimingDetails&)>>
+        callbacks = std::move(presentation_callbacks_.front().second);
+    presentation_callbacks_.pop_front();
+    for (auto& callback : callbacks) {
+      std::move(callback).Run(*failed_details);
+    }
+  }
+}
+
+void LayerTreeView::RememberFailedPresentationCallbacks(
+    uint32_t frame_token,
+    const viz::FrameTimingDetails& failed_details) {
+  for (auto& entry : failed_presentation_callbacks_) {
+    if (entry.first == frame_token) {
+      // Feedback is one-shot per frame token; a duplicate replaces the
+      // remembered details instead of growing the queue.
+      entry.second = failed_details;
+      return;
+    }
+  }
+  if (failed_presentation_callbacks_.size() >=
+      kMaxRememberedFailedPresentationCallbacks) {
+    // The bound is only reachable when failed feedbacks keep arriving for frame
+    // tokens that never get a callback. Drop the oldest entry; the hard
+    // kMaxBufferSize DCHECK remains the fail-closed backstop for the callback
+    // queue itself.
+    failed_presentation_callbacks_.pop_front();
+  }
+  failed_presentation_callbacks_.emplace_back(frame_token, failed_details);
+}
+
+void LayerTreeView::ForgetFailedPresentationCallbacksUpTo(
+    uint32_t frame_token) {
+  for (auto it = failed_presentation_callbacks_.begin();
+       it != failed_presentation_callbacks_.end();) {
+    if (it->first <= frame_token) {
+      it = failed_presentation_callbacks_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+std::optional<viz::FrameTimingDetails>
+LayerTreeView::TakeRememberedFailedPresentation(uint32_t frame_token) {
+  for (auto it = failed_presentation_callbacks_.begin();
+       it != failed_presentation_callbacks_.end(); ++it) {
+    if (it->first != frame_token) {
+      continue;
+    }
+    std::optional<viz::FrameTimingDetails> failed_details =
+        std::move(it->second);
+    failed_presentation_callbacks_.erase(it);
+    return failed_details;
+  }
+  return std::nullopt;
+}
+
+void LayerTreeView::CompleteAllPresentationCallbacksOnFailure() {
+  // Remembered failures belong to the lost frame sink as well; drop them so a
+  // replacement frame sink cannot complete a callback with stale details. The
+  // replacement sink may also restart its frame token sequence, so a
+  // remembered successful token must be forgotten too.
+  failed_presentation_callbacks_.clear();
+  latest_presented_frame_token_.reset();
+  presentation_callbacks_stalled_ = false;
+  if (presentation_callbacks_.empty()) {
+    return;
+  }
+  viz::FrameTimingDetails failed_details;
+  failed_details.presentation_feedback = gfx::PresentationFeedback::Failure();
+  // Move the queue out before running callbacks: a callback may add a new
+  // presentation callback.
+  base::circular_deque<std::pair<
+      uint32_t,
+      std::vector<base::OnceCallback<void(const viz::FrameTimingDetails&)>>>>
+      callbacks = std::move(presentation_callbacks_);
+  presentation_callbacks_.clear();
+  for (auto& entry : callbacks) {
+    for (auto& callback : entry.second) {
+      std::move(callback).Run(failed_details);
+    }
+  }
+}
