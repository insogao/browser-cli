+// Verifies that a success supersedes remembered failures for all frame tokens
+// up to the presented one, and that a failed feedback for an already
+// superseded frame token cannot fail a late callback registration.
+TEST(LayerTreeViewTest, SuccessSupersedesRememberedFailuresUpToItsToken) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  const base::TimeTicks failure_timestamp = base::TimeTicks::Now();
+  layer_tree_view.DidPresentCompositorFrame(
+      20, MakeFailedTimingDetails(failure_timestamp));
+
+  const base::TimeTicks success_timestamp =
+      failure_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      kPressureLimit, MakeSuccessfulTimingDetails(success_timestamp));
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit,
+                               /*failed=*/false);
+
+  // A delayed failed feedback for a frame that the success already covered is
+  // stale: it is not remembered, so a late callback for that token is
+  // completed by the next successful presentation instead.
+  completions.clear();
+  layer_tree_view.DidPresentCompositorFrame(
+      20, MakeFailedTimingDetails(failure_timestamp +
+                                  base::Microseconds(10)));
+  AddRecordingCallbacks(layer_tree_view, 20, 20, completions);
+  EXPECT_TRUE(completions.empty());
+
+  const base::TimeTicks next_success_timestamp =
+      success_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      kPressureLimit + 1,
+      MakeSuccessfulTimingDetails(next_success_timestamp));
+  ASSERT_EQ(completions.size(), 1u);
+  EXPECT_EQ(completions[0].frame_token, 20u);
+  EXPECT_FALSE(completions[0].failed);
+  EXPECT_EQ(completions[0].timestamp, next_success_timestamp);
+}
+
+// Verifies that a callback whose failure feedback was processed before the
+// callback was registered is completed immediately when no callback for an
+// earlier frame is pending and the queue has been stuck without successful
+// presentations.
+TEST(LayerTreeViewTest,
+     LatePresentationCallbackCompletesWithFailureWhenInOrder) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  // The failure feedback for the next frame token arrives before the task that
+  // registers its presentation callback.
+  const uint32_t late_token = kPressureLimit + 1;
+  const base::TimeTicks failure_timestamp = base::TimeTicks::Now();
+  layer_tree_view.DidPresentCompositorFrame(
+      late_token, MakeFailedTimingDetails(failure_timestamp));
+  ASSERT_TRUE(completions.empty());
+
+  // Failed feedbacks for the pending prefix drain it in order. No successful
+  // presentation happened, so the queue is still stuck when the late callback
+  // is registered.
+  for (uint32_t token = 1; token <= kPressureLimit; ++token) {
+    layer_tree_view.DidPresentCompositorFrame(
+        token, MakeFailedTimingDetails(failure_timestamp +
+                                       base::Microseconds(token)));
+  }
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit,
+                               /*failed=*/true);
+
+  AddRecordingCallbacks(layer_tree_view, late_token, late_token, completions);
+  ASSERT_EQ(completions.size(), kPressureLimit + 1);
+  EXPECT_EQ(completions.back().frame_token, late_token);
+  EXPECT_TRUE(completions.back().failed);
+  EXPECT_EQ(completions.back().timestamp, failure_timestamp);
+
+  // The callback was run instead of queued: a later success does not run it a
+  // second time.
+  layer_tree_view.DidPresentCompositorFrame(
+      late_token + 1,
+      MakeSuccessfulTimingDetails(failure_timestamp + base::Microseconds(600)));
+  EXPECT_EQ(completions.size(), kPressureLimit + 1);
+}
+
+// Verifies that a late callback registration is not completed out of order
+// while callbacks for earlier frames are still pending. The failed prefix is
+// drained in frame token order once the earlier failures are known.
+TEST(LayerTreeViewTest, LatePresentationCallbackWaitsForEarlierFrames) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  const uint32_t late_token = kPressureLimit + 1;
+  const base::TimeTicks failure_timestamp = base::TimeTicks::Now();
+  layer_tree_view.DidPresentCompositorFrame(
+      late_token, MakeFailedTimingDetails(failure_timestamp));
+
+  // The late registration is queued, not completed, because callbacks for
+  // earlier frame tokens are still pending.
+  AddRecordingCallbacks(layer_tree_view, late_token, late_token, completions);
+  EXPECT_TRUE(completions.empty());
+
+  for (uint32_t token = 1; token <= kPressureLimit; ++token) {
+    layer_tree_view.DidPresentCompositorFrame(
+        token, MakeFailedTimingDetails(failure_timestamp +
+                                       base::Microseconds(token)));
+  }
+  ExpectCompletedTokensInOrder(completions, 1, late_token, /*failed=*/true);
+  EXPECT_EQ(completions.back().timestamp, failure_timestamp);
+}
+
+// A duplicated failed presentation for the same frame token does not leave a
+// second remembered entry behind: the token is remembered once, with the most
+// recent details.
+TEST(LayerTreeViewTest, DuplicateFailedPresentationIsRememberedOnce) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  const base::TimeTicks first_failure_timestamp = base::TimeTicks::Now();
+  const base::TimeTicks second_failure_timestamp =
+      first_failure_timestamp + base::Microseconds(1);
+  layer_tree_view.DidPresentCompositorFrame(
+      31, MakeFailedTimingDetails(first_failure_timestamp));
+  layer_tree_view.DidPresentCompositorFrame(
+      31, MakeFailedTimingDetails(second_failure_timestamp));
+
+  for (uint32_t token = 1; token <= kPressureLimit; ++token) {
+    layer_tree_view.DidPresentCompositorFrame(
+        token, MakeFailedTimingDetails(first_failure_timestamp +
+                                       base::Microseconds(token)));
+  }
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit,
+                               /*failed=*/true);
+
+  // The late registration is completed with the most recent remembered
+  // failure.
+  AddRecordingCallbacks(layer_tree_view, 31, 31, completions);
+  ASSERT_EQ(completions.size(), kPressureLimit + 1);
+  EXPECT_EQ(completions.back().frame_token, 31u);
+  EXPECT_TRUE(completions.back().failed);
+  EXPECT_EQ(completions.back().timestamp, second_failure_timestamp);
+
+  // The duplicate did not leave a second entry behind: registering the token
+  // again queues it instead of completing it with a stale failure again.
+  AddRecordingCallbacks(layer_tree_view, 31, 31, completions);
+  EXPECT_EQ(completions.size(), kPressureLimit + 1);
+}
