+// Asserts that `completions` are exactly the frame tokens [first, last] in
+// increasing order.
+void ExpectCompletedTokensInOrder(
+    const std::vector<RecordedCompletion>& completions,
+    uint32_t first,
+    uint32_t last,
+    bool failed) {
+  ASSERT_EQ(completions.size(), static_cast<size_t>(last - first + 1));
+  for (size_t i = 0; i < completions.size(); ++i) {
+    SCOPED_TRACE(testing::Message() << "completion index " << i);
+    EXPECT_EQ(completions[i].frame_token, static_cast<uint32_t>(first + i));
+    EXPECT_EQ(completions[i].failed, failed);
+  }
+}
