+viz::FrameTimingDetails MakeFailedTimingDetails(base::TimeTicks timestamp) {
+  viz::FrameTimingDetails timing_details;
+  timing_details.presentation_feedback = gfx::PresentationFeedback(
+      timestamp, base::TimeDelta(), gfx::PresentationFeedback::kFailure);
+  return timing_details;
+}
+
+viz::FrameTimingDetails MakeSuccessfulTimingDetails(base::TimeTicks timestamp) {
+  viz::FrameTimingDetails timing_details;
+  timing_details.presentation_feedback =
+      gfx::PresentationFeedback(timestamp, base::TimeDelta(), 0);
+  return timing_details;
+}
+
+struct RecordedCompletion {
+  uint32_t frame_token;
+  base::TimeTicks timestamp;
+  bool failed;
+};
+
+// Registers a callback for each token in [first, last] that records how it was
+// completed.
+void AddRecordingCallbacks(LayerTreeView& layer_tree_view,
+                           uint32_t first,
+                           uint32_t last,
+                           std::vector<RecordedCompletion>& completions) {
+  for (uint32_t token = first; token <= last; ++token) {
+    layer_tree_view.AddPresentationCallback(
+        token,
+        base::BindLambdaForTesting(
+            [&completions, token](
+                const viz::FrameTimingDetails& frame_timing_details) {
+              completions.push_back(
+                  {token, frame_timing_details.presentation_feedback.timestamp,
+                   frame_timing_details.presentation_feedback.failed()});
+            }));
+  }
+}
