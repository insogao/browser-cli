+// Verifies that a failed presentation below the pressure limit does not
+// complete any callback: a later successful presentation can still complete
+// them, as documented for AddPresentationCallback().
+TEST(LayerTreeViewTest, FailedPresentationBelowPressureKeepsCallbacks) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, 3, completions);
+
+  const base::TimeTicks failure_timestamp = base::TimeTicks::Now();
+  layer_tree_view.DidPresentCompositorFrame(
+      2, MakeFailedTimingDetails(failure_timestamp));
+  EXPECT_TRUE(completions.empty());
+
+  const base::TimeTicks success_timestamp =
+      failure_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      4, MakeSuccessfulTimingDetails(success_timestamp));
+  ExpectCompletedTokensInOrder(completions, 1, 3, /*failed=*/false);
+  for (const RecordedCompletion& completion : completions) {
+    EXPECT_EQ(completion.timestamp, success_timestamp);
+  }
+}
