+// Counterexample for remembered failed presentations that arrive out of token
+// order: remembered failures are stored in arrival order, not token order.
+// Failure feedback for 44 is processed before failure feedback for 43, so a
+// cleanup that only pops the front entry leaves the stale token 43 behind. A
+// success for 43 proves it was presented, so a callback for 43 registered
+// afterwards must not be completed with that stale failure.
+TEST(LayerTreeViewTest,
+     RememberedFailuresOutOfOrderCannotFailLateCallbackAfterSuccess) {
+  base::test::TaskEnvironment task_environment;
+  StubLayerTreeViewDelegate layer_tree_view_delegate;
+  TestCompositor compositor(&layer_tree_view_delegate);
+  LayerTreeView& layer_tree_view = compositor.view;
+
+  std::vector<RecordedCompletion> completions;
+  AddRecordingCallbacks(layer_tree_view, 1, kPressureLimit, completions);
+
+  // Failed feedbacks arrive in the order 44, 43 while the queue is at the
+  // pressure limit and neither callback is registered yet, so the remembered
+  // failures are [44, 43].
+  const base::TimeTicks failure_timestamp = base::TimeTicks::Now();
+  layer_tree_view.DidPresentCompositorFrame(
+      44, MakeFailedTimingDetails(failure_timestamp));
+  layer_tree_view.DidPresentCompositorFrame(
+      43, MakeFailedTimingDetails(failure_timestamp + base::Microseconds(1)));
+  ASSERT_TRUE(completions.empty());
+
+  // Frame 43 is presented. The success supersedes the remembered failure for
+  // token 43 even though it is not at the front of the remembered FIFO.
+  const base::TimeTicks success_timestamp =
+      failure_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      43, MakeSuccessfulTimingDetails(success_timestamp));
+  ExpectCompletedTokensInOrder(completions, 1, kPressureLimit,
+                               /*failed=*/false);
+  for (const RecordedCompletion& completion : completions) {
+    EXPECT_EQ(completion.timestamp, success_timestamp);
+  }
+
+  // The callback for the presented token 43 is registered late. It must not be
+  // completed with the stale remembered failure; it waits for a following
+  // successful presentation, as documented for AddPresentationCallback().
+  completions.clear();
+  AddRecordingCallbacks(layer_tree_view, 43, 43, completions);
+  EXPECT_TRUE(completions.empty());
+
+  const base::TimeTicks next_success_timestamp =
+      success_timestamp + base::Microseconds(5);
+  layer_tree_view.DidPresentCompositorFrame(
+      45, MakeSuccessfulTimingDetails(next_success_timestamp));
+  ASSERT_EQ(completions.size(), 1u);
+  EXPECT_EQ(completions[0].frame_token, 43u);
+  EXPECT_FALSE(completions[0].failed);
+  EXPECT_EQ(completions[0].timestamp, next_success_timestamp);
+}
