+// The already-existing browser window an explicit `show` reuses. Empty (null
+// widget, id 0) when no eligible window exists; the producer then fails closed
+// instead of creating one.
+struct ReusableWindow {
+  raw_ptr<views::Widget> widget = nullptr;
+  uint64_t window_id = 0;
+  bool user_owned = false;
+};
+
 // Structured producer log, matching the macOS producer vocabulary. The
 // presentation policy adds its own BROWSER_CLI_PRESENTATION decision log for
 // every actual request, so an allow/deny pair can always be correlated.
 void LogProducerOutcome(const char* result,
                         const char* reason,
-                        bool managed_mode) {
+                        bool managed_mode,
+                        uint64_t window_id) {
   LOG(INFO) << "BROWSER_CLI_USER_EXPLICIT_SHOW stage=producer"
             << " result=" << result << " reason=" << reason
+            << " window_id=" << window_id
             << " managed=" << (managed_mode ? "yes" : "no")
             << " native=win-hwnd";
 }
 
+// Iterates browser windows in activation order (most recently active first).
+// Prefers a window the user already owns. Only top-level browser windows are
+// eligible.
+ReusableWindow FindReusableWindow() {
+  ReusableWindow candidate;
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  if (!collection) {
+    return candidate;
+  }
+  views::BrowserCliPresentationPolicy* policy =
+      views::BrowserCliPresentationPolicy::Get();
+  collection->ForEach(
+      [&candidate, policy](BrowserWindowInterface* browser) {
+        ui::BaseWindow* base_window =
+            browser ? browser->GetWindow() : nullptr;
+        if (!base_window) {
+          return true;
+        }
+        views::Widget* widget = views::Widget::GetWidgetForNativeWindow(
+            base_window->GetNativeWindow());
+        if (!widget || !widget->is_top_level()) {
+          return true;
+        }
+        aura::Window* native_window = widget->GetNativeWindow();
+        aura::WindowTreeHost* host =
+            native_window ? native_window->GetHost() : nullptr;
+        if (!host) {
+          return true;
+        }
+        const uint64_t window_id = views::BrowserCliWindowIdForHwnd(
+            host->GetAcceleratedWidget());
+        if (window_id == 0) {
+          return true;
+        }
+        const bool user_owned = policy->IsUserExplicitOwned(window_id);
+        if (!candidate.widget) {
+          // First eligible window in activation order: the fallback candidate.
+          candidate.widget = widget;
+          candidate.window_id = window_id;
+          candidate.user_owned = user_owned;
+        }
+        if (user_owned) {
+          // Never present some other background window when the user already
+          // owns one; take it and stop iterating.
+          candidate.widget = widget;
+          candidate.window_id = window_id;
+          candidate.user_owned = true;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return candidate;
+}
+
