+  // Browser CLI: TSF stays enabled in every mode, including managed background
+  // runs. A managed window can be handed to the user at any moment (HUMAN /
+  // ASSIST), and at that point the user must be able to type in their own
+  // language; this revision has no IMM32 fallback, so skipping TSF means no
+  // input method at all.
+  //
+  // Disabling it is now an explicit diagnostic switch and nothing else:
+  //   --browser-cli-tsf=disabled
+  // It exists so the "does this IME break startup" question can still be
+  // answered on a suspect machine. It must never be tied to a window
+  // presentation switch again: those two concerns are independent.
+  if (base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "browser-cli-tsf") == "disabled") {
+    LOG(INFO) << "BROWSER_CLI_IME stage=tsf decision=skip"
+                 " reason=diagnostic-switch";
+    return E_FAIL;
+  }
+
+  // Browser CLI: an unusable IME must degrade to "no IME support" instead of
+  // terminating the browser process. See InitializeTsfBridgeGuarded().
   auto delegate = std::make_unique<TSFBridgeImpl>();
-  HRESULT hr = delegate->Initialize();
+  bool ime_threw = false;
