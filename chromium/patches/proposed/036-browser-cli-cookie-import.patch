+++ b/chrome/browser/browser_cli/cookie_import/cookie_import_policy.h
@@ -0,0 +1,141 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_COOKIE_IMPORT_COOKIE_IMPORT_POLICY_H_
+#define CHROME_BROWSER_BROWSER_CLI_COOKIE_IMPORT_COOKIE_IMPORT_POLICY_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_inclusion_status.h"
+
+namespace browser_cli {
+
+// Wire contract shared with the BrowserPilot source extension and its native
+// messaging host relay. Keep these values byte-identical to
+// D:/work/wt/bp-rc-p1/scripts/import/contract.mjs (contract v2).
+inline constexpr char kContractId[] = "browser-cli.cookie-import/v2";
+inline constexpr char kSessionSchema[] = "browser-cli.cookie-import.session/v2";
+inline constexpr int kProtocolVersion = 2;
+inline constexpr int kMaxCookiesPerJob = 20000;
+inline constexpr int kMaxSelectedDomains = 1000;
+inline constexpr int kMaxValueBytes = 8192;
+inline constexpr int kMaxNameBytes = 4096;
+inline constexpr int kMaxDomainBytes = 255;
+inline constexpr int kMaxPathBytes = 1024;
+inline constexpr int kMaxPartitionSiteBytes = 2048;
+inline constexpr int kMaxJobBytes = 16 * 1024 * 1024;
+inline constexpr int kMaxChunks = 64;
+inline constexpr int kMaxFrameBytes = 512 * 1024;
+inline constexpr int kMaxDescriptorBytes = 16 * 1024;
+inline constexpr int kMaxTicketFailures = 5;
+inline constexpr int kMaxSessionsPerHour = 10;
+inline constexpr base::TimeDelta kTicketTtl = base::Minutes(5);
+inline constexpr base::TimeDelta kJobTtl = base::Minutes(10);
+inline constexpr base::TimeDelta kConsentMaxAge = base::Minutes(10);
+inline constexpr base::TimeDelta kClockSkew = base::Minutes(2);
+inline constexpr base::TimeDelta kTicketFailureWindow = base::Minutes(1);
+inline constexpr base::TimeDelta kRateLimitBlock = base::Minutes(1);
+
+// The source and target must agree on this exact normalization: uppercase,
+// strip the BCLI- prefix and separators, map O->0 and I/L->1.
+inline constexpr char kTicketPrefix[] = "BCLI";
+inline constexpr char kTicketAlphabet[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+inline constexpr int kTicketLength = 32;
+inline constexpr int kTicketBytes = 20;
+
+struct CookieRecord {
+  // Domain cookies keep their leading dot; host-only cookies do not.
+  std::string domain;
+  bool host_only = false;
+  std::string path;
+  std::string name;
+  std::string value;
+  bool secure = false;
+  bool http_only = false;
+  std::string same_site;  // no_restriction | lax | strict | unspecified
+  bool session = false;
+  double expiration_date = 0;  // Seconds since the Unix epoch.
+  bool has_partition_key = false;
+  std::string top_level_site;
+  bool has_cross_site_ancestor = false;
+};
+
+struct ImportJob {
+  std::string job_nonce;
+  std::string source_browser;
+  std::string profile_label;
+  std::string extension_version;
+  base::Time consent_at;
+  std::string domains_digest;
+  std::vector<std::string> domains;  // Normalized, unique, selection order.
+  std::vector<CookieRecord> cookies;
+  int session_cookies = 0;
+  int partitioned_cookies = 0;
+};
+
+struct ApprovalRequest {
+  std::string source_browser;
+  std::string profile_label;
+  std::vector<std::string> domains;
+  int cookie_count = 0;
+  int session_cookie_count = 0;
+  int selected_domain_count = 0;
+};
+
+// Ticket helpers.
+std::string GenerateTicket();
+std::string NormalizeTicket(std::string_view raw);
+bool IsValidTicket(std::string_view raw);
+std::string FormatTicket(std::string_view normalized_ticket);
+std::string Sha256Hex(std::string_view value);
+std::string TicketHash(std::string_view normalized_ticket);
+std::string DomainsDigest(const std::vector<std::string>& domains);
+std::string JobDigest(std::string_view payload);
+
+// Domain helpers.
+std::string NormalizeDomain(std::string_view domain);
+bool IsValidDomain(std::string_view domain);
+bool DomainMatchesSelection(std::string_view cookie_domain,
+                            const std::vector<std::string>& selected_domains);
+bool IsPublicSuffixDomain(std::string_view bare_domain);
+std::string NormalizeTopLevelSite(std::string_view raw);
+
+// Parses and validates one contract-v2 job. On failure, |error| receives a
+// stable code (never a cookie value/name/domain). The parser does not apply the
+// Public Suffix List; that is enforced per cookie at write time so a single
+// bad record becomes a counted failure instead of a whole-job rejection.
+std::optional<ImportJob> ParseImportJob(const base::DictValue& payload,
+                                        base::Time now,
+                                        std::string* error);
+
+// Per-cookie policy check used at write time. Returns an empty string on
+// success, otherwise one of the cookie failure codes.
+std::string CookiePolicyFailure(
+    const CookieRecord& cookie,
+    const std::vector<std::string>& selected_domains,
+    base::Time now,
+    bool include_public_suffix_check = true);
+
+// Builds the net::CanonicalCookie that the browser's CookieManager will write.
+// The caller must not write the Cookies SQLite file directly.
+std::optional<net::CanonicalCookie> BuildCanonicalCookie(
+    const CookieRecord& cookie,
+    std::string* failure);
+
+std::string FailureCodeForInclusionStatus(
+    const net::CookieInclusionStatus& status);
+bool IsCookieFailureCode(std::string_view code);
+std::string FailureText(std::string_view code);
+
+}  // namespace browser_cli
+
+#endif  // CHROME_BROWSER_BROWSER_CLI_COOKIE_IMPORT_COOKIE_IMPORT_POLICY_H_
