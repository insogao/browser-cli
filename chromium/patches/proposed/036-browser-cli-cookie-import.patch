+
+constexpr char kImportSwitch[] = "browser-cli-cookie-import";
+constexpr char kSessionDirSwitch[] = "browser-cli-cookie-import-session-dir";
+
+CookieImportService* g_cookie_import_service = nullptr;
+
+std::string NowIso() {
+  return base::TimeFormatAsIso8601(base::Time::Now());
+}
+
+bool GetString(const base::DictValue& dict,
+               std::string_view key,
+               std::string* out) {
+  const std::string* value = dict.FindString(key);
+  if (!value) {
+    return false;
+  }
+  *out = *value;
+  return true;
+}
+
+bool IsLowerHexOfLength(std::string_view value, size_t length) {
+  if (value.size() != length) {
+    return false;
+  }
+  for (char c : value) {
+    if (!base::IsAsciiDigit(c) && !(c >= 'a' && c <= 'f')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsTerminalState(std::string_view state) {
+  return state == "done" || state == "failed" || state == "cancelled" ||
+         state == "denied";
+}
+
+GURL SourceUrlForCookie(const CookieRecord& cookie) {
+  std::string host = cookie.host_only ? cookie.domain : cookie.domain.substr(1);
+  return GURL(
+      base::StrCat({cookie.secure ? "https" : "http", "://", host, "/"}));
+}
+
+}  // namespace
+
+struct CookieImportService::Job {
+  std::string id;
+  ImportJob payload;
+  std::string state = "pending";
+  int applied = 0;
+  int failed = 0;
+  std::map<std::string, int> failures;
+  bool target_user_confirmed = false;
+  bool authorization_simulated = false;
+  std::string authorization_source = "none";
+  std::string confirmed_at;
+  std::string error_code;
+  base::Time created_at;
+  base::Time updated_at;
+  bool cancel_requested = false;
+};
+
+// static
+void CookieImportService::Start(Profile* profile) {
+  if (g_cookie_import_service || !profile) {
+    return;
+  }
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(kImportSwitch)) {
+    return;
+  }
+  g_cookie_import_service = new CookieImportService(profile);
+  g_cookie_import_service->Initialize();
+}
+
+// static
+void CookieImportService::Stop() {
+  if (g_cookie_import_service) {
+    g_cookie_import_service->Shutdown();
+  }
+}
+
+// static
+CookieImportService* CookieImportService::GetForTesting() {
+  return g_cookie_import_service;
+}
+
+CookieImportService::CookieImportService(Profile* profile)
+    : profile_(profile) {}
+
+CookieImportService::~CookieImportService() = default;
+
+void CookieImportService::SetApprovalCallbackForTesting(
+    ApprovalCallback callback) {
+  approval_callback_ = std::move(callback);
+}
+
+std::string CookieImportService::GetTicketForTesting() const {
+  return FormatTicket(ticket_);
+}
+
+std::string CookieImportService::GetStateForTesting() const {
+  return job_ ? job_->state : "idle";
+}
+
+void CookieImportService::Initialize() {
+  ticket_ = GenerateTicket();
+  ticket_hash_ = TicketHash(ticket_);
+  instance_id_ = base::HexEncodeLower(crypto::RandBytesAsVector(16));
+  const std::vector<uint8_t> salt = crypto::RandBytesAsVector(16);
+  profile_hash_ = Sha256Hex(base::StrCat(
+      {base::HexEncodeLower(salt), "|", profile_->GetPath().AsUTF8Unsafe()}));
+  session_expires_at_ = base::Time::Now() + kTicketTtl;
+  pipe_name_ =
+      L"\\\\.\\pipe\\browser-cli-import-" + base::ASCIIToWide(instance_id_);
+
+  // Create the pipe before publishing the descriptor so the native host cannot
+  // find a session whose pipe does not exist yet.
+  pipe_server_ = std::make_unique<CookieImportPipeServer>(pipe_name_, this);
+  if (!pipe_server_->Start()) {
+    LOG(ERROR) << "cookie import: could not create the named pipe";
+    Shutdown();
+    return;
+  }
+
+  cookie_manager_ = profile_->GetDefaultStoragePartition()
+                        ->GetCookieManagerForBrowserProcess();
+  if (!WriteDescriptor()) {
+    LOG(ERROR) << "cookie import: could not write session descriptor";
+    Shutdown();
+    return;
+  }
+
+  ShowCookieImportSessionDialog(base::UTF8ToUTF16(FormatTicket(ticket_)),
+                                base::BindOnce(&CookieImportService::Shutdown,
+                                               weak_factory_.GetWeakPtr()));
+  session_timer_.Start(FROM_HERE, kTicketTtl,
+                       base::BindOnce(&CookieImportService::OnSessionTimeout,
+                                      weak_factory_.GetWeakPtr()));
+}
+
+bool CookieImportService::WriteDescriptor() {
+  base::FilePath session_dir;
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kSessionDirSwitch)) {
+    session_dir = base::FilePath::FromUTF8Unsafe(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            kSessionDirSwitch));
+  } else if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &session_dir)) {
+    return false;
+  } else {
+    session_dir = session_dir.Append(FILE_PATH_LITERAL("BrowserCLI"))
+                      .Append(FILE_PATH_LITERAL("import"))
+                      .Append(FILE_PATH_LITERAL("sessions"));
+  }
+  if (!base::CreateDirectory(session_dir)) {
+    return false;
+  }
+  session_dir_ = session_dir.AsUTF8Unsafe();
+  descriptor_path_ =
+      session_dir.AppendASCII("session-" + instance_id_ + ".json")
+          .AsUTF8Unsafe();
+
+  const base::Process current = base::Process::Current();
+  base::DictValue descriptor;
+  descriptor.Set("schema", kSessionSchema);
+  descriptor.Set("protocolVersion", kProtocolVersion);
+  descriptor.Set("targetProduct", "Browser CLI");
+  descriptor.Set("targetVersion",
+                 std::string(version_info::GetVersionNumber()));
+  descriptor.Set("targetPid", static_cast<int>(current.Pid()));
+  descriptor.Set("targetStartTimeMs",
+                 static_cast<double>(
+                     current.CreationTime().InMillisecondsSinceUnixEpoch()));
+  descriptor.Set("targetInstanceId", instance_id_);
+  descriptor.Set("profileHash", profile_hash_);
+  descriptor.Set("ticketHash", ticket_hash_);
+  descriptor.Set("transport", "named-pipe");
+  descriptor.Set("pipeName", base::WideToUTF8(pipe_name_));
+  descriptor.Set("createdAt", NowIso());
+  descriptor.Set("expiresAt", base::TimeFormatAsIso8601(session_expires_at_));
+
+  std::string json;
+  if (!base::JSONWriter::Write(descriptor, &json)) {
+    return false;
+  }
+  return base::WriteFile(base::FilePath::FromUTF8Unsafe(descriptor_path_),
+                         json);
+}
+
+void CookieImportService::RemoveDescriptor() {
+  if (!descriptor_path_.empty()) {
+    base::DeleteFile(base::FilePath::FromUTF8Unsafe(descriptor_path_));
+    descriptor_path_.clear();
+  }
+}
+
+void CookieImportService::Shutdown() {
+  if (shutting_down_) {
+    return;
+  }
+  shutting_down_ = true;
+  session_timer_.Stop();
+  job_timer_.Stop();
+  if (job_ && !IsTerminalState(job_->state)) {
+    job_->cancel_requested = true;
+  }
+  if (pipe_server_) {
+    pipe_server_->Stop();
+    pipe_server_.reset();
+  }
+  RemoveDescriptor();
+  if (g_cookie_import_service == this) {
+    g_cookie_import_service = nullptr;
+  }
+  // Posted pipe callbacks are already queued on the UI thread. Delete after
+  // them so a late OnImportPipe* callback cannot use a dangling delegate.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+}
+
+void CookieImportService::Send(base::DictValue message) {
+  if (pipe_server_) {
+    pipe_server_->Send(std::move(message));
+  }
+}
+
+void CookieImportService::SendError(const std::string& code) {
+  base::DictValue message;
+  message.Set("type", "error");
+  message.Set("code", code);
+  Send(std::move(message));
+}
+
+bool CookieImportService::IsRateLimited() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  while (!failed_auth_attempts_.empty() &&
+         now - failed_auth_attempts_.front() > kTicketFailureWindow) {
+    failed_auth_attempts_.pop_front();
+  }
+  if (now < rate_limited_until_) {
+    return true;
+  }
+  if (failed_auth_attempts_.size() >= static_cast<size_t>(kMaxTicketFailures)) {
+    rate_limited_until_ = now + kRateLimitBlock;
+    return true;
+  }
+  return false;
+}
+
+void CookieImportService::RecordAuthFailure() {
+  failed_auth_attempts_.push_back(base::TimeTicks::Now());
+  if (failed_auth_attempts_.size() >= static_cast<size_t>(kMaxTicketFailures)) {
+    rate_limited_until_ = base::TimeTicks::Now() + kRateLimitBlock;
+  }
+}
+
+void CookieImportService::OnImportPipeConnected(uint32_t client_pid) {
+  client_pid_ = client_pid;
+}
+
+void CookieImportService::OnImportPipeDisconnected() {
+  if (job_ && !IsTerminalState(job_->state)) {
+    job_->cancel_requested = true;
+    job_->state = "cancelled";
+    job_->updated_at = base::Time::Now();
+  }
+  Shutdown();
+}
+
+void CookieImportService::OnImportPipeMessage(base::DictValue message) {
+  std::string type;
+  if (!GetString(message, "type", &type)) {
+    SendError("protocol-mismatch");
+    return;
+  }
+  if (type == "hello") {
+    HandleHello(message);
+    return;
+  }
+  if (!hello_received_) {
+    SendError("protocol-mismatch");
+    return;
+  }
+  if (type == "job-begin") {
+    HandleJobBegin(message);
+  } else if (type == "job-chunk") {
+    HandleJobChunk(message);
+  } else if (type == "job-commit") {
+    HandleJobCommit(message);
+  } else if (type == "cancel") {
+    HandleCancel(message);
+  } else if (type == "close") {
+    Shutdown();
+  } else {
+    SendError("protocol-mismatch");
+  }
+}
+
+void CookieImportService::HandleHello(const base::DictValue& message) {
+  if (IsRateLimited()) {
+    SendError("rate-limited");
+    Shutdown();
+    return;
+  }
+  if (base::Time::Now() > session_expires_at_) {
+    SendError("ticket-expired");
+    Shutdown();
+    return;
+  }
+  if (consumed_) {
+    SendError("ticket-consumed");
+    return;
+  }
+  const std::optional<int> protocol = message.FindInt("protocol");
+  std::string ticket;
+  if (!protocol || *protocol != kProtocolVersion ||
+      !GetString(message, "ticket", &ticket)) {
+    SendError("protocol-mismatch");
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  while (!hello_attempts_.empty() &&
+         now - hello_attempts_.front() > base::Hours(1)) {
+    hello_attempts_.pop_front();
+  }
+  if (hello_attempts_.size() >= static_cast<size_t>(kMaxSessionsPerHour)) {
+    SendError("rate-limited");
+    Shutdown();
+    return;
+  }
+  hello_attempts_.push_back(now);
+
+  // The ticket is bound to the native-host relay process. Fail closed if the
+  // pipe client identity is unknown or does not match the claimed host PID.
+  const std::optional<int> host_pid = message.FindInt("hostPid");
+  if (!host_pid || client_pid_ == 0 ||
+      static_cast<uint32_t>(*host_pid) != client_pid_) {
+    RecordAuthFailure();
+    SendError("host-identity-mismatch");
+    return;
+  }
+  if (!IsValidTicket(ticket) ||
+      !base::EqualsCaseInsensitiveASCII(NormalizeTicket(ticket), ticket_)) {
+    RecordAuthFailure();
+    SendError("ticket-invalid");
+    return;
+  }
+
+  // Bind the ticket to the job announced in hello. job-begin must repeat the
+  // exact same job nonce, digest, size and chunk count.
+  std::string job_nonce;
+  std::string job_digest;
+  const std::optional<int> total_bytes = message.FindInt("totalBytes");
+  const std::optional<int> chunk_count = message.FindInt("chunkCount");
+  if (!GetString(message, "jobNonce", &job_nonce) ||
+      !IsLowerHexOfLength(job_nonce, 32) ||
+      !GetString(message, "jobDigest", &job_digest) ||
+      !IsLowerHexOfLength(job_digest, 64) || !total_bytes ||
+      *total_bytes <= 0 || *total_bytes > kMaxJobBytes || !chunk_count ||
+      *chunk_count <= 0 || *chunk_count > kMaxChunks) {
+    RecordAuthFailure();
+    SendError("protocol-mismatch");
+    return;
+  }
+
+  consumed_ = true;
+  hello_received_ = true;
+  hello_job_nonce_ = std::move(job_nonce);
+  hello_job_digest_ = std::move(job_digest);
+  hello_total_bytes_ = static_cast<size_t>(*total_bytes);
+  hello_chunk_count_ = static_cast<size_t>(*chunk_count);
+  session_timer_.Stop();
+  RemoveDescriptor();
+
+  base::DictValue capabilities;
+  capabilities.Set("cookieStoreWrite", true);
+  capabilities.Set("persistAcrossRestart", true);
+  capabilities.Set("partitionedCookies", true);
+  capabilities.Set("sessionCookies", true);
+  capabilities.Set("sessionCookiePersistence", "not_guaranteed");
+  capabilities.Set("maxCookiesPerJob", kMaxCookiesPerJob);
+  capabilities.Set("maxValueBytes", kMaxValueBytes);
+  capabilities.Set("ticketTtlSeconds",
+                   static_cast<int>(kTicketTtl.InSeconds()));
+
+  base::DictValue ready;
+  ready.Set("type", "ready");
+  ready.Set("protocol", kProtocolVersion);
+  ready.Set("sessionId", instance_id_);
+  ready.Set("targetPid", static_cast<int>(base::Process::Current().Pid()));
+  ready.Set("targetProduct", "Browser CLI");
+  ready.Set("targetVersion", std::string(version_info::GetVersionNumber()));
+  ready.Set("native", true);
+  ready.Set("capabilities", std::move(capabilities));
+  Send(std::move(ready));
+}
+
+void CookieImportService::HandleJobBegin(const base::DictValue& message) {
+  if (job_) {
+    SendError("target-busy");
+    return;
+  }
+  std::string job_nonce;
+  std::string job_digest;
+  if (!GetString(message, "jobNonce", &job_nonce) ||
+      !GetString(message, "jobDigest", &job_digest) ||
+      !IsLowerHexOfLength(job_nonce, 32) ||
+      !IsLowerHexOfLength(job_digest, 64)) {
+    SendError("protocol-mismatch");
+    return;
+  }
+  const std::optional<int> total_bytes = message.FindInt("totalBytes");
+  const std::optional<int> chunk_count = message.FindInt("chunkCount");
+  if (!total_bytes || *total_bytes <= 0 || *total_bytes > kMaxJobBytes ||
+      !chunk_count || *chunk_count <= 0 || *chunk_count > kMaxChunks) {
+    SendError("too-large");
+    return;
+  }
+  if (job_nonce != hello_job_nonce_ || job_digest != hello_job_digest_ ||
+      static_cast<size_t>(*total_bytes) != hello_total_bytes_ ||
+      static_cast<size_t>(*chunk_count) != hello_chunk_count_) {
+    SendError("job-binding-mismatch");
+    return;
+  }
+  job_nonce_ = std::move(job_nonce);
+  job_digest_ = std::move(job_digest);
+  total_bytes_ = static_cast<size_t>(*total_bytes);
+  chunk_count_ = static_cast<size_t>(*chunk_count);
+  received_bytes_ = 0;
+  next_chunk_ = 0;
+  chunks_.clear();
+}
+
+void CookieImportService::HandleJobChunk(const base::DictValue& message) {
+  std::string job_nonce;
+  std::string data;
+  const std::optional<int> index = message.FindInt("index");
+  if (!GetString(message, "jobNonce", &job_nonce) || job_nonce != job_nonce_ ||
+      !index || *index < 0 || static_cast<size_t>(*index) != next_chunk_ ||
+      !GetString(message, "data", &data)) {
+    SendError("chunk-missing");
+    return;
+  }
+  std::string decoded;
+  if (!base::Base64Decode(data, &decoded, base::Base64DecodePolicy::kStrict)) {
+    SendError("chunk-missing");
+    return;
+  }
+  if (decoded.size() > static_cast<size_t>(kMaxFrameBytes) ||
+      received_bytes_ + decoded.size() > kMaxJobBytes ||
+      received_bytes_ + decoded.size() > total_bytes_) {
+    SendError("too-large");
+    return;
+  }
+  received_bytes_ += decoded.size();
+  ++next_chunk_;
+  chunks_.push_back(std::move(decoded));
+}
+
+void CookieImportService::HandleJobCommit(const base::DictValue& message) {
+  std::string job_nonce;
+  if (!GetString(message, "jobNonce", &job_nonce) || job_nonce != job_nonce_ ||
+      chunks_.size() != chunk_count_) {
+    SendError("chunk-missing");
+    return;
+  }
+  if (job_) {
+    SendError("target-busy");
+    return;
+  }
+  std::string payload;
+  payload.reserve(received_bytes_);
+  for (const std::string& chunk : chunks_) {
+    payload.append(chunk);
+  }
+  chunks_.clear();
+  chunks_.shrink_to_fit();
+  if (payload.size() != total_bytes_) {
+    SendError("chunk-missing");
+    return;
+  }
+  if (!base::EqualsCaseInsensitiveASCII(JobDigest(payload), job_digest_)) {
+    SendError("job-digest-mismatch");
+    return;
+  }
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(payload, base::JSON_PARSE_RFC,
+                                 /*max_depth=*/64);
+  if (!parsed) {
+    SendError("protocol-mismatch");
+    return;
+  }
+  std::string error;
+  std::optional<ImportJob> import_job =
+      ParseImportJob(*parsed, base::Time::Now(), &error);
+  if (!import_job.has_value()) {
+    SendError("protocol-mismatch");
+    return;
+  }
+
+  Job job;
+  job.id = base::HexEncodeLower(crypto::RandBytesAsVector(12));
+  job.payload = std::move(*import_job);
+  job.state = "awaiting_authorization";
+  job.created_at = base::Time::Now();
+  job.updated_at = job.created_at;
+  job_ = std::make_unique<Job>(std::move(job));
+
+  base::DictValue accepted;
+  accepted.Set("type", "accepted");
+  accepted.Set("jobId", job_->id);
+  accepted.Set("state", job_->state);
+  accepted.Set("totals", BuildTotals());
+  accepted.Set("native", true);
+  accepted.Set("authorization", BuildAuthorization());
+  Send(std::move(accepted));
+  SendStatus();
+  job_timer_.Start(FROM_HERE, kJobTtl,
+                   base::BindOnce(&CookieImportService::OnJobTimeout,
+                                  weak_factory_.GetWeakPtr()));
+  StartApproval();
+}
+
+void CookieImportService::HandleCancel(const base::DictValue& message) {
+  std::string job_nonce;
+  if (GetString(message, "jobNonce", &job_nonce) && job_nonce != job_nonce_) {
+    SendError("job-binding-mismatch");
+    return;
+  }
+  if (!job_) {
+    SendError("job-binding-mismatch");
+    return;
+  }
+  if (IsTerminalState(job_->state)) {
+    base::DictValue response;
+    response.Set("type", "cancel-ok");
+    response.Set("state", job_->state);
+    Send(std::move(response));
+    return;
+  }
+  job_->cancel_requested = true;
+  if (job_->state == "pending" || job_->state == "awaiting_authorization") {
+    job_->state = "cancelled";
+    job_->updated_at = base::Time::Now();
+    SendStatus();
+    FinishJob();
+    return;
+  }
+  base::DictValue response;
+  response.Set("type", "cancel-ok");
+  response.Set("state", job_->state);
+  Send(std::move(response));
+}
+
+void CookieImportService::StartApproval() {
+  if (!job_) {
+    return;
+  }
+  ApprovalRequest request;
+  request.source_browser = job_->payload.source_browser;
+  request.profile_label = job_->payload.profile_label;
+  request.domains = job_->payload.domains;
+  request.cookie_count = static_cast<int>(job_->payload.cookies.size());
+  request.session_cookie_count = job_->payload.session_cookies;
+  request.selected_domain_count =
+      static_cast<int>(job_->payload.domains.size());
+  base::OnceCallback<void(bool)> callback = base::BindOnce(
+      &CookieImportService::OnApprovalResult, weak_factory_.GetWeakPtr());
+  if (!approval_callback_.is_null()) {
+    approval_callback_.Run(request, std::move(callback));
+    return;
+  }
+  ShowCookieImportApprovalDialog(request, std::move(callback));
+}
+
+void CookieImportService::OnApprovalResult(bool approved) {
+  if (!job_ || IsTerminalState(job_->state)) {
+    return;
+  }
+  job_->updated_at = base::Time::Now();
+  if (!approved) {
+    job_->state = "denied";
+    job_->error_code = "authorization-denied";
+    job_->authorization_source = "target-browser-dialog";
+    job_->target_user_confirmed = false;
+    job_->authorization_simulated = false;
+    job_timer_.Stop();
+    SendStatus();
+    return;
+  }
+  job_->state = "applying";
+  job_->target_user_confirmed = true;
+  job_->authorization_simulated = !approval_callback_.is_null();
+  job_->authorization_source = approval_callback_.is_null()
+                                   ? "target-browser-dialog"
+                                   : "test-approval-callback";
+  job_->confirmed_at = NowIso();
+  last_progress_sent_ = 0;
+  SendStatus();
+  ApplyNextCookie(0);
+}
+
+void CookieImportService::ApplyNextCookie(size_t index) {
+  // A timeout, denial or cancel may have made the job terminal while a
+  // CookieManager callback was still in flight; stop writing in that case.
+  if (!job_ || IsTerminalState(job_->state)) {
+    return;
+  }
+  if (job_->cancel_requested) {
+    job_->state = "cancelled";
+    job_->updated_at = base::Time::Now();
+    FinishJob();
+    return;
+  }
+  if (index >= job_->payload.cookies.size()) {
+    FinishJob();
+    return;
+  }
+  const CookieRecord& cookie = job_->payload.cookies[index];
+  std::string failure =
+      CookiePolicyFailure(cookie, job_->payload.domains, base::Time::Now());
+  if (!failure.empty()) {
+    CountFailure(failure);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CookieImportService::ApplyNextCookie,
+                                  weak_factory_.GetWeakPtr(), index + 1));
+    return;
+  }
+  std::string build_failure;
+  std::optional<net::CanonicalCookie> canonical =
+      BuildCanonicalCookie(cookie, &build_failure);
+  if (!canonical) {
+    CountFailure(build_failure);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CookieImportService::ApplyNextCookie,
+                                  weak_factory_.GetWeakPtr(), index + 1));
+    return;
+  }
+  if (!cookie_manager_) {
+    job_->state = "failed";
+    job_->error_code = "cookie-store-unavailable";
+    job_->updated_at = base::Time::Now();
+    FinishJob();
+    return;
+  }
+  // CookieManager::SetCanonicalCookie is the browser-process mojo front end
+  // for the network service's net::CookieStore::SetCanonicalCookieAsync. The
+  // network service owns schema, encryption and locking; this process never
+  // writes the Cookies SQLite file directly.
+  net::CookieOptions options = net::CookieOptions::MakeAllInclusive();
+  cookie_manager_->SetCanonicalCookie(
+      *canonical, SourceUrlForCookie(cookie), options,
+      base::BindOnce(&CookieImportService::OnCookieSet,
+                     weak_factory_.GetWeakPtr(), index));
+}
+
+void CookieImportService::OnCookieSet(size_t index,
+                                      net::CookieAccessResult result) {
+  if (!job_) {
+    return;
+  }
+  if (result.status.IsInclude()) {
+    ++job_->applied;
+  } else {
+    CountFailure(FailureCodeForInclusionStatus(result.status));
+  }
+  job_->updated_at = base::Time::Now();
+  if (job_->applied + job_->failed - last_progress_sent_ >= 25) {
+    last_progress_sent_ = job_->applied + job_->failed;
+    SendStatus();
+  }
+  ApplyNextCookie(index + 1);
+}
+
+void CookieImportService::CountFailure(const std::string& code) {
+  if (!job_) {
+    return;
+  }
+  const std::string safe_code = IsCookieFailureCode(code) ? code : "internal";
+  ++job_->failures[safe_code];
+  ++job_->failed;
+}
+
+void CookieImportService::FinishJob() {
+  if (!job_) {
+    return;
+  }
+  job_timer_.Stop();
+  if (job_->state == "failed" || job_->state == "denied") {
+    // Keep a terminal state decided earlier (timeout, denial, store failure).
+  } else if (job_->cancel_requested) {
+    job_->state = "cancelled";
+  } else if (!job_->error_code.empty() &&
+             job_->error_code == "cookie-store-unavailable") {
+    job_->state = "failed";
+  } else if (job_->applied == 0 && job_->failed > 0) {
+    job_->state = "failed";
+    job_->error_code = job_->failures.begin()->first;
+  } else {
+    job_->state = "done";
+  }
+  job_->updated_at = base::Time::Now();
+  SendStatus();
+  RemoveDescriptor();
+  if (!cookie_manager_) {
+    return;
+  }
+  cookie_manager_->FlushCookieStore(base::BindOnce(
+      &CookieImportService::OnFlushDone, weak_factory_.GetWeakPtr()));
+}
+
+void CookieImportService::OnFlushDone() {
+  if (!job_) {
+    return;
+  }
+  job_->updated_at = base::Time::Now();
+  SendStatus();
+}
+
+void CookieImportService::OnJobTimeout() {
+  if (!job_ || IsTerminalState(job_->state)) {
+    return;
+  }
+  job_->state = "failed";
+  job_->error_code = "timeout";
+  job_->updated_at = base::Time::Now();
+  SendStatus();
+  RemoveDescriptor();
+}
+
+void CookieImportService::OnSessionTimeout() {
+  if (hello_received_ || job_) {
+    return;
+  }
+  SendError("ticket-expired");
+  Shutdown();
+}
+
+void CookieImportService::SendStatus() {
+  if (!job_) {
+    return;
+  }
+  base::DictValue message;
+  message.Set("type", "status");
+  message.Set("view", BuildPublicView());
+  Send(std::move(message));
+}
+
+base::DictValue CookieImportService::BuildTotals() const {
+  base::DictValue totals;
+  if (!job_) {
+    totals.Set("cookies", 0);
+    totals.Set("domains", 0);
+    totals.Set("selectedDomains", 0);
+    totals.Set("sessionCookies", 0);
+    totals.Set("partitionedCookies", 0);
+    return totals;
+  }
+  std::set<std::string> cookie_domains;
+  for (const CookieRecord& cookie : job_->payload.cookies) {
+    cookie_domains.insert(NormalizeDomain(cookie.domain));
+  }
+  totals.Set("cookies", static_cast<int>(job_->payload.cookies.size()));
+  totals.Set("domains", static_cast<int>(cookie_domains.size()));
+  totals.Set("selectedDomains", static_cast<int>(job_->payload.domains.size()));
+  totals.Set("sessionCookies", job_->payload.session_cookies);
+  totals.Set("partitionedCookies", job_->payload.partitioned_cookies);
+  return totals;
+}
+
+base::DictValue CookieImportService::BuildAuthorization() const {
+  base::DictValue authorization;
+  authorization.Set("targetUserConfirmed", job_ && job_->target_user_confirmed);
+  authorization.Set("simulated", job_ && job_->authorization_simulated);
+  authorization.Set("source",
+                    job_ ? job_->authorization_source : std::string("none"));
+  if (job_ && job_->target_user_confirmed) {
+    authorization.Set("scopeDigest", job_->payload.domains_digest);
+    if (!job_->confirmed_at.empty()) {
+      authorization.Set("confirmedAt", job_->confirmed_at);
+    }
+  }
+  return authorization;
+}
+
+std::string CookieImportService::ComputeCookieImportedStatus() const {
+  if (!job_) {
+    return "not_started";
+  }
+  const std::string& state = job_->state;
+  if (state == "pending" || state == "awaiting_authorization" ||
+      state == "denied") {
+    return "not_started";
+  }
+  if (job_->applied > 0 && job_->failed == 0 &&
+      (state == "done" || state == "applying")) {
+    return "imported";
+  }
+  if (job_->applied > 0 && job_->failed > 0) {
+    return "partially_imported";
+  }
+  if (job_->applied > 0 && state == "cancelled") {
+    return "partially_imported";
+  }
+  if (job_->applied == 0 && job_->failed > 0) {
+    return "failed";
+  }
+  if (state == "failed") {
+    return "failed";
+  }
+  return "not_started";
+}
+
+base::DictValue CookieImportService::BuildPublicView() const {
+  base::DictValue view;
+  view.Set("contract", kContractId);
+  view.Set("protocolVersion", kProtocolVersion);
+  if (!job_) {
+    return view;
+  }
+  view.Set("jobId", job_->id);
+  view.Set("state", job_->state);
+  view.Set("transport", "named-pipe");
+  view.Set("native", true);
+  view.Set("totals", BuildTotals());
+
+  const int total = static_cast<int>(job_->payload.cookies.size());
+  base::DictValue progress;
+  progress.Set("applied", job_->applied);
+  progress.Set("failed", job_->failed);
+  progress.Set("remaining", std::max(0, total - job_->applied - job_->failed));
+  view.Set("progress", std::move(progress));
+
+  view.Set("authorization", BuildAuthorization());
+
+  base::DictValue data_copied;
+  data_copied.Set("cookies", false);
+  view.Set("dataCopied", std::move(data_copied));
+
+  base::DictValue cookie_imported;
+  cookie_imported.Set("status", ComputeCookieImportedStatus());
+  cookie_imported.Set("applied", job_->applied);
+  cookie_imported.Set("failed", job_->failed);
+  base::DictValue failures;
+  for (const auto& [code, count] : job_->failures) {
+    failures.Set(code, count);
+  }
+  cookie_imported.Set("failures", std::move(failures));
+  view.Set("cookieImported", std::move(cookie_imported));
+
+  base::DictValue session_cookies;
+  session_cookies.Set("count", job_->payload.session_cookies);
+  session_cookies.Set("mayNotSurviveRestart", true);
+  session_cookies.Set(
+      "note",
+      "Session cookies are not guaranteed to survive a browser restart.");
+  view.Set("sessionCookies", std::move(session_cookies));
+
+  base::DictValue login;
+  login.Set("status", "not_verified");
+  login.Set(
+      "note",
+      "Cookie import is not login verification. The user must confirm the "
+      "website in this browser.");
+  view.Set("loginVerified", std::move(login));
+
+  if (!job_->error_code.empty()) {
+    base::DictValue error;
+    error.Set("code", job_->error_code);
+    error.Set("message", FailureText(job_->error_code));
+    view.Set("error", std::move(error));
+  }
+
+  view.Set("createdAt", base::TimeFormatAsIso8601(job_->created_at));
+  view.Set("updatedAt", base::TimeFormatAsIso8601(job_->updated_at));
+  return view;
+}
+
+}  // namespace browser_cli
