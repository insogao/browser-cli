+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_COOKIE_IMPORT_COOKIE_IMPORT_PIPE_SERVER_WIN_H_
+#define CHROME_BROWSER_BROWSER_CLI_COOKIE_IMPORT_COOKIE_IMPORT_PIPE_SERVER_WIN_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/ref_counted.h"
+#include "base/threading/simple_thread.h"
+#include "base/values.h"
+
+namespace browser_cli {
+
+// Windows-only, single-client named-pipe server for the cookie-import target.
+//
+// The server is a raw Win32 pipe rather than a localhost HTTP listener:
+// - the pipe name is generated per process and contains 128 random bits;
+// - the DACL grants access to the object owner (the signed-in user) and
+//   LocalSystem only, and PIPE_REJECT_REMOTE_CLIENTS is set;
+// - FILE_FLAG_FIRST_PIPE_INSTANCE prevents another process from squatting the
+//   name before this process creates it;
+// - the BrowserPilot native host connects as the client and forwards frames
+//   from the source extension. There is no HTTP API and no generic command
+//   channel.
+//
+// All messages are 4-byte little-endian length-prefixed UTF-8 JSON, capped at
+// 512 KiB per frame. The delegate receives messages on the UI thread.
+class CookieImportPipeServer {
+ public:
+  class Delegate {
+   public:
+    virtual ~Delegate() = default;
+    virtual void OnImportPipeConnected(uint32_t client_pid) = 0;
+    virtual void OnImportPipeMessage(base::DictValue message) = 0;
+    virtual void OnImportPipeDisconnected() = 0;
+  };
+
+  CookieImportPipeServer(std::wstring pipe_name, Delegate* delegate);
+  CookieImportPipeServer(const CookieImportPipeServer&) = delete;
+  CookieImportPipeServer& operator=(const CookieImportPipeServer&) = delete;
+  ~CookieImportPipeServer();
+
+  bool Start();
+  void Send(base::DictValue message);
+  void Stop();
+
+  // Public only so the pipe thread implementation in the .cc can subclass
+  // base::SimpleThread with access to the run loop.
+  class Core;
+
+ private:
+  scoped_refptr<Core> core_;
+  std::unique_ptr<base::SimpleThread> thread_;
+  raw_ptr<Delegate> delegate_;
+};
+
+}  // namespace browser_cli
