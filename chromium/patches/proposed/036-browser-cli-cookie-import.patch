+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/cookie_import/cookie_import_policy.h"
+
+#include <string>
+
+#include "base/i18n/time_formatting.h"
+#include "base/json/json_writer.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/cookies/cookie_inclusion_status.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace browser_cli {
+namespace {
+
+base::DictValue MakeCookie() {
+  base::DictValue cookie;
+  cookie.Set("domain", ".example.com");
+  cookie.Set("hostOnly", false);
+  cookie.Set("path", "/");
+  cookie.Set("name", "sid");
+  cookie.Set("value", "synthetic");
+  cookie.Set("secure", true);
+  cookie.Set("httpOnly", true);
+  cookie.Set("sameSite", "lax");
+  cookie.Set("session", false);
+  cookie.Set("expirationDate", 2000000000.0);
+  return cookie;
+}
+
+base::DictValue MakeJob() {
+  base::ListValue domains;
+  domains.Append("example.com");
+  base::ListValue cookies;
+  cookies.Append(MakeCookie());
+
+  base::DictValue source;
+  source.Set("browser", "chrome");
+  source.Set("profileLabel", "Synthetic");
+  source.Set("extensionVersion", "0.3.0");
+
+  base::DictValue consent;
+  consent.Set("kind", "explicit-user-action");
+  consent.Set("at", base::TimeFormatAsIso8601(base::Time::Now()));
+  consent.Set("extensionVersion", "0.3.0");
+  consent.Set("scope", "selected-domains");
+  consent.Set("domainsDigest", DomainsDigest({"example.com"}));
+
+  base::DictValue job;
+  job.Set("contract", kContractId);
+  job.Set("protocolVersion", kProtocolVersion);
+  job.Set("jobNonce", std::string(32, 'a'));
+  job.Set("source", std::move(source));
+  job.Set("consent", std::move(consent));
+  job.Set("domains", std::move(domains));
+  job.Set("cookies", std::move(cookies));
+  return job;
+}
+
+std::optional<ImportJob> Parse(const base::DictValue& job) {
+  std::string error;
+  std::optional<ImportJob> result =
+      ParseImportJob(job, base::Time::Now(), &error);
+  return result;
+}
+
+}  // namespace
+
+TEST(CookieImportPolicyTest, TicketIsFormattedAndHashedOneWay) {
+  const std::string ticket = GenerateTicket();
+  EXPECT_EQ(kTicketLength, static_cast<int>(ticket.size()));
+  EXPECT_TRUE(IsValidTicket(ticket));
+  const std::string formatted = FormatTicket(ticket);
+  EXPECT_EQ("BCLI-", formatted.substr(0, 5));
+  EXPECT_EQ(ticket, NormalizeTicket(formatted));
+  EXPECT_FALSE(IsValidTicket("123456"));
+  const std::string hash = TicketHash(ticket);
+  EXPECT_EQ(64u, hash.size());
+  EXPECT_EQ(hash, TicketHash(formatted));
+  EXPECT_EQ(std::string::npos, hash.find(ticket));
+  EXPECT_EQ(
+      32u,
+      NormalizeTicket("BCLI-0000-0000-0000-0000-0000-0000-0000-0000").size());
+}
+
+TEST(CookieImportPolicyTest, DomainsDigestIsOrderIndependent) {
+  const std::string first = DomainsDigest({"b.example.com", "a.example.com"});
+  const std::string second =
+      DomainsDigest({"a.example.com", "b.example.com", "a.example.com"});
+  EXPECT_EQ(first, second);
+  EXPECT_EQ(64u, first.size());
+}
+
+TEST(CookieImportPolicyTest, ParsesValidJobAndCountsSessionCookies) {
+  base::DictValue job = MakeJob();
+  base::ListValue cookies;
+  base::DictValue session = MakeCookie();
+  session.Set("name", "session");
+  session.Set("session", true);
+  session.Remove("expirationDate");
+  cookies.Append(MakeCookie());
+  cookies.Append(std::move(session));
+  job.Set("cookies", std::move(cookies));
+
+  std::string error;
+  std::optional<ImportJob> parsed =
+      ParseImportJob(job, base::Time::Now(), &error);
+  ASSERT_TRUE(parsed.has_value()) << error;
+  EXPECT_EQ(2u, parsed->cookies.size());
+  EXPECT_EQ(1, parsed->session_cookies);
+  EXPECT_EQ(0, parsed->partitioned_cookies);
+  EXPECT_EQ("chrome", parsed->source_browser);
+}
+
+TEST(CookieImportPolicyTest, RejectsMalformedJobs) {
+  {
+    base::DictValue job = MakeJob();
+    job.Remove("consent");
+    EXPECT_FALSE(Parse(job).has_value());
+  }
+  {
+    base::DictValue job = MakeJob();
+    job.Set("jobNonce", "short");
+    EXPECT_FALSE(Parse(job).has_value());
+  }
+  {
+    base::DictValue job = MakeJob();
+    base::ListValue domains;
+    domains.Append("other.com");
+    job.Set("domains", std::move(domains));
+    base::DictValue consent = std::move(*job.FindDict("consent"));
+    consent.Set("domainsDigest", DomainsDigest({"other.com"}));
+    job.Set("consent", std::move(consent));
+    EXPECT_FALSE(Parse(job).has_value());
+  }
+  {
+    base::DictValue job = MakeJob();
+    base::DictValue consent = std::move(*job.FindDict("consent"));
+    consent.Set("at", "2000-01-01T00:00:00Z");
+    job.Set("consent", std::move(consent));
+    EXPECT_FALSE(Parse(job).has_value());
+  }
+}
+
+TEST(CookieImportPolicyTest, RejectsInvalidCookieAttributes) {
+  auto with_cookie = [](base::DictValue cookie) {
+    base::DictValue job = MakeJob();
+    base::ListValue cookies;
+    cookies.Append(std::move(cookie));
+    job.Set("cookies", std::move(cookies));
+    return job;
+  };
+
+  {
+    base::DictValue cookie = MakeCookie();
+    cookie.Set("hostOnly", true);
+    EXPECT_FALSE(Parse(with_cookie(std::move(cookie))).has_value());
+  }
+  {
+    base::DictValue cookie = MakeCookie();
+    cookie.Set("domain", "example.com");
+    cookie.Set("hostOnly", false);
+    EXPECT_FALSE(Parse(with_cookie(std::move(cookie))).has_value());
+  }
+  {
+    base::DictValue cookie = MakeCookie();
+    cookie.Set("session", true);
+    EXPECT_FALSE(Parse(with_cookie(std::move(cookie))).has_value());
+  }
+  {
+    base::DictValue cookie = MakeCookie();
+    cookie.Set("sameSite", "no_restriction");
+    cookie.Set("secure", false);
+    EXPECT_FALSE(Parse(with_cookie(std::move(cookie))).has_value());
+  }
+  {
+    base::DictValue cookie = MakeCookie();
+    cookie.Set("secure", false);
+    base::DictValue partition;
+    partition.Set("topLevelSite", "https://top.example");
+    partition.Set("hasCrossSiteAncestor", true);
+    cookie.Set("partitionKey", std::move(partition));
+    EXPECT_FALSE(Parse(with_cookie(std::move(cookie))).has_value());
+  }
+  {
+    base::DictValue cookie = MakeCookie();
+    cookie.Set("name", "__Host-sid");
+    EXPECT_FALSE(Parse(with_cookie(std::move(cookie))).has_value());
+  }
+  {
+    base::DictValue cookie = MakeCookie();
+    base::DictValue partition;
+    partition.Set("topLevelSite", "https://top.example/path");
+    partition.Set("hasCrossSiteAncestor", true);
+    cookie.Set("partitionKey", std::move(partition));
+    EXPECT_FALSE(Parse(with_cookie(std::move(cookie))).has_value());
+  }
+}
+
+TEST(CookieImportPolicyTest, PublicSuffixAndDomainSelection) {
+  EXPECT_TRUE(IsPublicSuffixDomain("com"));
+  EXPECT_TRUE(IsPublicSuffixDomain("co.uk"));
+  EXPECT_TRUE(IsPublicSuffixDomain("github.io"));
+  EXPECT_FALSE(IsPublicSuffixDomain("example.com"));
+  EXPECT_FALSE(IsPublicSuffixDomain("foo.github.io"));
+
+  EXPECT_TRUE(DomainMatchesSelection(".example.com", {"example.com"}));
+  EXPECT_TRUE(DomainMatchesSelection("sub.example.com", {"example.com"}));
+  EXPECT_FALSE(DomainMatchesSelection(".example.com", {"sub.example.com"}));
+  EXPECT_FALSE(DomainMatchesSelection("notexample.com", {"example.com"}));
+}
+
+TEST(CookieImportPolicyTest, BuildsHostOnlyAndDomainCanonicalCookies) {
+  CookieRecord host_only;
+  host_only.domain = "example.com";
+  host_only.host_only = true;
+  host_only.path = "/";
+  host_only.name = "sid";
+  host_only.value = "synthetic";
+  host_only.secure = true;
+  host_only.http_only = true;
+  host_only.same_site = "lax";
+  host_only.expiration_date = 2000000000;
+
+  std::string failure;
+  auto cookie = BuildCanonicalCookie(host_only, &failure);
+  ASSERT_TRUE(cookie.has_value()) << failure;
+  EXPECT_TRUE(cookie->IsHostCookie());
+  EXPECT_EQ("example.com", cookie->Domain());
+
+  CookieRecord domain = host_only;
+  domain.domain = ".example.com";
+  domain.host_only = false;
+  cookie = BuildCanonicalCookie(domain, &failure);
+  ASSERT_TRUE(cookie.has_value()) << failure;
+  EXPECT_TRUE(cookie->IsDomainCookie());
+  EXPECT_EQ(".example.com", cookie->Domain());
+
+  CookieRecord partitioned = domain;
+  partitioned.has_partition_key = true;
+  partitioned.top_level_site = "https://top.example";
+  partitioned.has_cross_site_ancestor = true;
+  cookie = BuildCanonicalCookie(partitioned, &failure);
+  ASSERT_TRUE(cookie.has_value()) << failure;
+  EXPECT_TRUE(cookie->IsPartitioned());
+}
+
+TEST(CookieImportPolicyTest, ReportsPublicSuffixAndPrefixFailures) {
+  CookieRecord cookie;
+  cookie.domain = ".com";
+  cookie.host_only = false;
+  cookie.path = "/";
+  cookie.name = "sid";
+  cookie.value = "synthetic";
+  cookie.secure = true;
+  cookie.http_only = true;
+  cookie.same_site = "lax";
+  cookie.expiration_date = 2000000000;
+  EXPECT_EQ("public-suffix-rejected",
+            CookiePolicyFailure(cookie, {"com"}, base::Time::Now()));
+
+  CookieRecord host_only_com = cookie;
+  host_only_com.domain = "com";
+  host_only_com.host_only = true;
+  EXPECT_EQ(std::string(),
+            CookiePolicyFailure(host_only_com, {"com"}, base::Time::Now()));
+
+  CookieRecord bad_prefix = cookie;
+  bad_prefix.domain = ".example.com";
+  bad_prefix.name = "__Host-sid";
+  EXPECT_EQ(
+      "cookie-prefix-rejected",
+      CookiePolicyFailure(bad_prefix, {"example.com"}, base::Time::Now()));
+}
+
+TEST(CookieImportPolicyTest, MapsInclusionStatusToStableCodes) {
+  net::CookieInclusionStatus status;
+  status.AddExclusionReason(
+      net::CookieInclusionStatus::ExclusionReason::EXCLUDE_INVALID_PREFIX);
+  EXPECT_EQ("cookie-prefix-rejected", FailureCodeForInclusionStatus(status));
+
+  status = net::CookieInclusionStatus();
+  status.AddExclusionReason(
+      net::CookieInclusionStatus::ExclusionReason::EXCLUDE_INVALID_DOMAIN);
+  EXPECT_EQ("invalid-domain", FailureCodeForInclusionStatus(status));
+
+  status = net::CookieInclusionStatus();
+  status.AddExclusionReason(net::CookieInclusionStatus::ExclusionReason::
+                                EXCLUDE_SAMESITE_NONE_INSECURE);
+  EXPECT_EQ("samesite-rejected", FailureCodeForInclusionStatus(status));
+}
+
+}  // namespace browser_cli
