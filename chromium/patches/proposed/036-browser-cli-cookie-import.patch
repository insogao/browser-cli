+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//testing/test.gni")
+
+assert(is_win,
+       "The v2 Browser CLI cookie-import target is Windows-only (named pipe).")
+
+# Pure policy helpers (ticket/job validation, PSL/prefix/partition rules and
+# CanonicalCookie construction). Kept separate so the unit test does not need
+# to link the browser-process service, dialogs or the Win32 pipe server.
+source_set("cookie_import_policy") {
+  sources = [
+    "cookie_import_policy.cc",
+    "cookie_import_policy.h",
+  ]
+
+  deps = [
+    "//base",
+    "//crypto",
+    "//net",
+    "//url",
+  ]
+}
+
+source_set("cookie_import") {
+  sources = [
+    "cookie_import_dialog.cc",
+    "cookie_import_dialog.h",
+    "cookie_import_pipe_server_win.cc",
+    "cookie_import_pipe_server_win.h",
+    "cookie_import_service.cc",
+    "cookie_import_service.h",
+  ]
+
+  deps = [
+    ":cookie_import_policy",
+    "//base",
+    "//chrome/browser/profiles:profile",
+    "//components/version_info",
+    "//content/public/browser",
+    "//crypto",
+    "//net",
+    "//services/network/public/mojom",
+    "//ui/base",
+    "//ui/base/mojom:ui_base_types",
+    "//ui/gfx",
+    "//ui/gfx/geometry",
+    "//ui/views",
+    "//url",
+  ]
+
+  libs = [ "advapi32.lib" ]
+}
+
+test("cookie_import_unittests") {
+  sources = [ "cookie_import_policy_unittest.cc" ]
+
+  deps = [
+    ":cookie_import_policy",
+    "//base",
+    "//base:i18n",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+    "//net",
+    "//testing/gtest",
+  ]
+}
diff --git a/chrome/browser/browser_cli/cookie_import/cookie_import_dialog.cc b/chrome/browser/browser_cli/cookie_import/cookie_import_dialog.cc
