+}  // namespace
+
+std::string GenerateTicket() {
+  std::array<uint8_t, kTicketBytes> bytes;
+  crypto::RandBytes(bytes);
+  return Base32Crockford(bytes.data(), bytes.size());
+}
+
+std::string NormalizeTicket(std::string_view raw) {
+  std::string value = base::ToUpperASCII(
+      base::TrimWhitespaceASCII(std::string(raw), base::TRIM_ALL));
+  if (base::StartsWith(value, base::StrCat({kTicketPrefix, "-"}))) {
+    value.erase(0, std::string_view(kTicketPrefix).size() + 1);
+  }
+  std::string normalized;
+  normalized.reserve(value.size());
+  for (char c : value) {
+    if (c == '-' || c == ' ' || c == '\t' || c == '\r' || c == '\n') {
+      continue;
+    }
+    if (c == 'O') {
+      normalized.push_back('0');
+    } else if (c == 'I' || c == 'L') {
+      normalized.push_back('1');
+    } else {
+      normalized.push_back(c);
+    }
+  }
+  return normalized;
+}
+
+bool IsValidTicket(std::string_view raw) {
+  std::string value = NormalizeTicket(raw);
+  if (value.size() != kTicketLength) {
+    return false;
+  }
+  return std::all_of(value.begin(), value.end(), IsTicketAlphabetChar);
+}
+
+std::string FormatTicket(std::string_view normalized_ticket) {
+  std::string value = NormalizeTicket(normalized_ticket);
+  if (!IsValidTicket(value)) {
+    return std::string();
+  }
+  std::string formatted = kTicketPrefix;
+  formatted.push_back('-');
+  for (size_t i = 0; i < value.size(); i += 4) {
+    if (i > 0) {
+      formatted.push_back('-');
+    }
+    formatted.append(value.substr(i, 4));
+  }
+  return formatted;
+}
+
+std::string Sha256Hex(std::string_view value) {
+  return base::HexEncodeLower(crypto::SHA256HashString(value));
+}
+
+std::string TicketHash(std::string_view normalized_ticket) {
+  std::string normalized = NormalizeTicket(normalized_ticket);
+  if (!IsValidTicket(normalized)) {
+    return std::string();
+  }
+  return Sha256Hex(base::StrCat({"browser-cli-ticket-v2:", normalized}));
+}
+
+std::string DomainsDigest(const std::vector<std::string>& domains) {
+  std::set<std::string> unique;
+  for (const std::string& domain : domains) {
+    std::string normalized = NormalizeDomain(domain);
+    if (!normalized.empty()) {
+      unique.insert(std::move(normalized));
+    }
+  }
+  std::string joined;
+  for (const std::string& domain : unique) {
+    if (!joined.empty()) {
+      joined.push_back('\n');
+    }
+    joined.append(domain);
+  }
+  return Sha256Hex(base::StrCat({"browser-cli-domains-v2:", joined}));
+}
+
+std::string JobDigest(std::string_view payload) {
+  return Sha256Hex(payload);
+}
+
+std::string NormalizeDomain(std::string_view domain) {
+  std::string normalized = base::ToLowerASCII(
+      base::TrimWhitespaceASCII(std::string(domain), base::TRIM_ALL));
+  if (!normalized.empty() && normalized[0] == '.') {
+    normalized.erase(0, 1);
+  }
+  return normalized;
+}
+
+bool IsValidDomain(std::string_view domain) {
+  if (domain.empty() || domain.size() > kMaxDomainBytes) {
+    return false;
+  }
+  for (char c : domain) {
+    if (static_cast<unsigned char>(c) >= 0x80) {
+      return false;
+    }
+  }
+  std::string_view bare = domain;
+  if (base::StartsWith(bare, ".")) {
+    bare.remove_prefix(1);
+  }
+  if (bare.empty() || base::EndsWith(bare, ".") ||
+      bare.find("..") != std::string_view::npos) {
+    return false;
+  }
+  for (std::string_view label : base::SplitStringPiece(
+           bare, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (label.empty() || label.size() > 63 || label.front() == '-' ||
+        label.back() == '-') {
+      return false;
+    }
+    for (char c : label) {
+      if (!base::IsAsciiAlphaNumeric(c) && c != '-') {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool DomainMatchesSelection(std::string_view cookie_domain,
+                            const std::vector<std::string>& selected_domains) {
+  std::string cookie = NormalizeDomain(cookie_domain);
+  if (base::StartsWith(cookie, ".")) {
+    cookie.erase(0, 1);
+  }
+  if (cookie.empty()) {
+    return false;
+  }
+  for (const std::string& raw : selected_domains) {
+    std::string selected = NormalizeDomain(raw);
+    if (selected.empty()) {
+      continue;
+    }
+    if (cookie == selected ||
+        base::EndsWith(cookie, base::StrCat({".", selected}))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsPublicSuffixDomain(std::string_view bare_domain) {
+  return net::registry_controlled_domains::GetDomainAndRegistry(
+             bare_domain,
+             net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES)
+      .empty();
+}
+
+std::string NormalizeTopLevelSite(std::string_view raw) {
+  GURL url{std::string(raw)};
+  if (!url.is_valid() || (url.scheme() != "https" && url.scheme() != "http") ||
+      url.host().empty() || url.has_username() || url.has_password() ||
+      !url.port().empty() || (!url.path().empty() && url.path() != "/") ||
+      !url.query().empty() || !url.ref().empty()) {
+    return std::string();
+  }
+  return base::StrCat({url.scheme(), "://", url.host()});
+}
+
+std::optional<ImportJob> ParseImportJob(const base::DictValue& payload,
+                                        base::Time now,
+                                        std::string* error) {
+  *error = std::string();
+  const std::string* contract = payload.FindString("contract");
+  if (!contract || *contract != kContractId) {
+    *error = "protocol-mismatch";
+    return std::nullopt;
+  }
+  ImportJob job;
+  if (!GetRequiredString(payload, "jobNonce", &job.job_nonce) ||
+      job.job_nonce.size() != 32 || !IsLowerHex(job.job_nonce)) {
+    *error = "protocol-mismatch";
+    return std::nullopt;
+  }
+
+  const base::DictValue* source = payload.FindDict("source");
+  if (!source || !GetRequiredString(*source, "browser", &job.source_browser)) {
+    *error = "protocol-mismatch";
+    return std::nullopt;
+  }
+  if (job.source_browser != "chrome" && job.source_browser != "edge" &&
+      job.source_browser != "brave" && job.source_browser != "chromium" &&
+      job.source_browser != "firefox") {
+    *error = "protocol-mismatch";
+    return std::nullopt;
+  }
+  if (const std::string* label = source->FindString("profileLabel")) {
+    job.profile_label = *label;
+    if (job.profile_label.size() > 200) {
+      *error = "protocol-mismatch";
+      return std::nullopt;
+    }
+  }
+  if (const std::string* version = source->FindString("extensionVersion")) {
+    job.extension_version = *version;
+  }
+
+  const base::DictValue* consent = payload.FindDict("consent");
+  if (!consent) {
+    *error = "consent.missing";
+    return std::nullopt;
+  }
+  const std::string* consent_kind = consent->FindString("kind");
+  const std::string* consent_at = consent->FindString("at");
+  const std::string* consent_version = consent->FindString("extensionVersion");
+  const std::string* consent_scope = consent->FindString("scope");
+  if (!consent_kind || *consent_kind != "explicit-user-action" || !consent_at ||
+      !consent_version || consent_version->empty() ||
+      consent_version->size() > 64 || !consent_scope ||
+      *consent_scope != "selected-domains" ||
+      !GetRequiredString(*consent, "domainsDigest", &job.domains_digest) ||
+      job.domains_digest.size() != 64 || !IsLowerHex(job.domains_digest)) {
+    *error = "consent.invalid";
+    return std::nullopt;
+  }
+  if (!base::Time::FromString(consent_at->c_str(), &job.consent_at)) {
+    *error = "consent.at-invalid";
+    return std::nullopt;
+  }
+  if (job.consent_at > now + kClockSkew ||
+      job.consent_at < now - kConsentMaxAge) {
+    *error = "consent.stale";
+    return std::nullopt;
+  }
+
+  const base::ListValue* domains = payload.FindList("domains");
+  if (!domains || domains->empty() || domains->size() > kMaxSelectedDomains) {
+    *error = "domains-invalid";
+    return std::nullopt;
+  }
+  std::set<std::string> seen_domains;
+  for (const base::Value& value : *domains) {
+    if (!value.is_string()) {
+      *error = "domains-invalid";
+      return std::nullopt;
+    }
+    std::string domain = NormalizeDomain(value.GetString());
+    if (!IsValidDomain(domain) || !seen_domains.insert(domain).second) {
+      *error = "domains-invalid";
+      return std::nullopt;
+    }
+    job.domains.push_back(std::move(domain));
+  }
+
+  const base::ListValue* cookies = payload.FindList("cookies");
+  if (!cookies || cookies->empty() || cookies->size() > kMaxCookiesPerJob) {
+    *error = "cookies-invalid";
+    return std::nullopt;
+  }
+  for (const base::Value& value : *cookies) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      *error = "invalid-cookie";
+      return std::nullopt;
+    }
+    CookieRecord cookie;
+    std::string cookie_error;
+    if (!ParseCookieRecord(*dict, now, &cookie, &cookie_error)) {
+      *error = cookie_error.empty() ? "invalid-cookie" : cookie_error;
+      return std::nullopt;
+    }
+    if (!DomainMatchesSelection(cookie.domain, job.domains)) {
+      *error = "invalid-domain";
+      return std::nullopt;
+    }
+    if (cookie.session) {
+      ++job.session_cookies;
+    }
+    if (cookie.has_partition_key) {
+      ++job.partitioned_cookies;
+    }
+    job.cookies.push_back(std::move(cookie));
+  }
+
+  if (!base::EqualsCaseInsensitiveASCII(job.domains_digest,
+                                        DomainsDigest(job.domains))) {
+    *error = "consent.domains-digest-mismatch";
+    return std::nullopt;
+  }
+  return job;
+}
+
+std::string CookiePolicyFailure(
+    const CookieRecord& cookie,
+    const std::vector<std::string>& selected_domains,
+    base::Time now,
+    bool include_public_suffix_check) {
+  std::string field_failure = ValidateCookieRecordFields(cookie, now);
+  if (!field_failure.empty()) {
+    return field_failure;
+  }
+  if (!DomainMatchesSelection(cookie.domain, selected_domains)) {
+    return "invalid-domain";
+  }
+  if (include_public_suffix_check && !cookie.host_only) {
+    std::string bare = NormalizeDomain(cookie.domain);
+    if (base::StartsWith(bare, ".")) {
+      bare.erase(0, 1);
+    }
+    if (IsPublicSuffixDomain(bare)) {
+      return "public-suffix-rejected";
+    }
+  }
+  return std::string();
+}
+
+std::optional<net::CanonicalCookie> BuildCanonicalCookie(
+    const CookieRecord& cookie,
+    std::string* failure) {
+  *failure = std::string();
+  std::string bare = cookie.host_only ? cookie.domain : cookie.domain.substr(1);
+  GURL url(base::StrCat({cookie.secure ? "https" : "http", "://", bare, "/"}));
+  if (!url.is_valid() || url.host().empty() ||
+      !base::EqualsCaseInsensitiveASCII(url.host(), bare)) {
+    *failure = "invalid-url";
+    return std::nullopt;
+  }
+
+  std::optional<net::CookiePartitionKey> partition_key;
+  if (cookie.has_partition_key) {
+    auto expected = net::CookiePartitionKey::FromStorage(
+        cookie.top_level_site, cookie.has_cross_site_ancestor);
+    if (!expected.has_value() || !expected.value().has_value()) {
+      *failure = "partitioned-cookie-rejected";
+      return std::nullopt;
+    }
+    partition_key = std::move(expected.value().value());
+  }
+
+  base::Time expiration;
+  if (!cookie.session) {
+    expiration = base::Time::FromSecondsSinceUnixEpoch(cookie.expiration_date);
+  }
+
+  net::CookieInclusionStatus status;
+  std::unique_ptr<net::CanonicalCookie> canonical =
+      net::CanonicalCookie::CreateSanitizedCookie(
+          url, cookie.name, cookie.value,
+          cookie.host_only ? std::string() : cookie.domain, cookie.path,
+          base::Time::Now(), expiration, base::Time(), cookie.secure,
+          cookie.http_only, SameSiteFromString(cookie.same_site),
+          net::COOKIE_PRIORITY_DEFAULT, partition_key, &status);
+  if (!canonical) {
+    *failure = FailureCodeForInclusionStatus(status);
+    return std::nullopt;
+  }
+  return std::move(*canonical);
+}
+
+std::string FailureCodeForInclusionStatus(
+    const net::CookieInclusionStatus& status) {
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_PREFIX)) {
+    return "cookie-prefix-rejected";
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_PARTITIONED)) {
+    return "partitioned-cookie-rejected";
+  }
+  if (status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_SAMESITE_NONE_INSECURE)) {
+    return "samesite-rejected";
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_DOMAIN) ||
+      status.HasExclusionReason(ExclusionReason::EXCLUDE_DOMAIN_MISMATCH) ||
+      status.HasExclusionReason(ExclusionReason::EXCLUDE_DOMAIN_NON_ASCII)) {
+    return "invalid-domain";
+  }
+  if (status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_NAME_VALUE_PAIR_EXCEEDS_MAX_SIZE) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_DISALLOWED_CHARACTER) ||
+      status.HasExclusionReason(ExclusionReason::EXCLUDE_NO_COOKIE_CONTENT) ||
+      status.HasExclusionReason(ExclusionReason::EXCLUDE_INVALID_PATH) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_ATTRIBUTE_VALUE_EXCEEDS_MAX_SIZE) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_AMBIGUOUS_SERIALIZATION)) {
+    return "invalid-cookie";
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_SECURE_ONLY) ||
+      status.HasExclusionReason(
+          ExclusionReason::EXCLUDE_NONCOOKIEABLE_SCHEME) ||
+      status.HasExclusionReason(ExclusionReason::EXCLUDE_SCHEME_MISMATCH)) {
+    return "invalid-url";
+  }
+  if (status.HasExclusionReason(ExclusionReason::EXCLUDE_FAILURE_TO_STORE)) {
+    return "cookie-store-unavailable";
+  }
+  return "internal";
+}
+
+bool IsCookieFailureCode(std::string_view code) {
+  const std::vector<std::string_view> codes =
+      base::SplitStringPiece(kCookieFailureCodes, " ", base::TRIM_WHITESPACE,
+                             base::SPLIT_WANT_NONEMPTY);
+  return std::find(codes.begin(), codes.end(), code) != codes.end();
+}
+
+std::string FailureText(std::string_view code) {
+  if (code == "invalid-cookie") {
+    return "Cookie fields are invalid.";
+  }
+  if (code == "invalid-domain") {
+    return "Cookie domain is invalid or not selected.";
+  }
+  if (code == "invalid-url") {
+    return "Cookie cannot be mapped to a target URL.";
+  }
+  if (code == "public-suffix-rejected") {
+    return "A Domain cookie on a public suffix is rejected.";
+  }
+  if (code == "cookie-prefix-rejected") {
+    return "Cookie prefix requirements are not met.";
+  }
+  if (code == "partitioned-cookie-rejected") {
+    return "The target rejected the partition key.";
+  }
+  if (code == "samesite-rejected") {
+    return "SameSite=None requires a Secure cookie.";
+  }
+  if (code == "expiry-rejected") {
+    return "Cookie expiration is invalid or in the past.";
+  }
+  if (code == "permission-or-host") {
+    return "The target refused the cookie host.";
+  }
+  if (code == "cookie-store-unavailable") {
+    return "The target cookie store is unavailable.";
+  }
+  if (code == "authorization-denied") {
+    return "The user denied the import in the target browser.";
+  }
+  if (code == "cancelled") {
+    return "The import was cancelled; written cookies are not rolled back.";
+  }
+  if (code == "timeout") {
+    return "The import timed out.";
+  }
+  return "The target failed to write the cookie.";
+}
+
+}  // namespace browser_cli
