+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/cookie_import/cookie_import_dialog.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+
+#if BUILDFLAG(IS_WIN)
+
+namespace browser_cli {
+namespace {
+
+void ConfigureDialog(views::View* view) {
+  auto* layout = view->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  layout->set_inside_border_insets(gfx::Insets(16));
+  layout->set_between_child_spacing(10);
+}
+
+class SessionDialog : public views::DialogDelegate {
+ public:
+  SessionDialog(const std::u16string& ticket, base::OnceClosure on_close)
+      : on_close_(std::move(on_close)) {
+    SetTitle(u"Browser CLI cookie import");
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk));
+    SetButtonLabel(ui::mojom::DialogButton::kOk, u"Close");
+    SetAcceptCallback(
+        base::BindOnce(&SessionDialog::Resolve, base::Unretained(this)));
+    SetCloseCallback(
+        base::BindOnce(&SessionDialog::Resolve, base::Unretained(this)));
+    auto* contents = SetContentsView(std::make_unique<views::View>());
+    ConfigureDialog(contents);
+
+    auto* intro = contents->AddChildView(
+        std::make_unique<views::Label>(u"Paste this "
+                                       u"one-time ticket "
+                                       u"into the "
+                                       u"Browser CLI "
+                                       u"Import source "
+                                       u"extension:"));
+    intro->SetMultiLine(true);
+    intro->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    auto field = std::make_unique<views::Textfield>();
+    field->SetReadOnly(true);
+    field->SetText(ticket);
+    field->SetAccessibleName(u"Browser CLI cookie import ticket");
+    contents->AddChildView(std::move(field));
+    auto* warning = contents->AddChildView(std::make_unique<views::Label>(
+        u"The ticket expires in 5 minutes and can be used once. The source "
+        u"extension can read cookies only for the domains you select; this "
+        u"browser will ask you to approve that exact scope again. Closing "
+        u"this window ends the import session."));
+    warning->SetMultiLine(true);
+    warning->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  }
+
+ private:
+  void Resolve() {
+    if (resolved_) {
+      return;
+    }
+    resolved_ = true;
+    if (on_close_) {
+      std::move(on_close_).Run();
+    }
+  }
+
+  bool resolved_ = false;
+  base::OnceClosure on_close_;
+};
+
+class ApprovalDialog : public views::DialogDelegate {
+ public:
+  ApprovalDialog(const ApprovalRequest& request,
+                 base::OnceCallback<void(bool)> on_result)
+      : on_result_(std::move(on_result)) {
+    SetTitle(u"Allow cookie import into Browser CLI?");
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+               static_cast<int>(ui::mojom::DialogButton::kCancel));
+    SetButtonLabel(ui::mojom::DialogButton::kOk, u"Allow");
+    SetButtonLabel(ui::mojom::DialogButton::kCancel, u"Deny");
+    SetAcceptCallback(
+        base::BindOnce(&ApprovalDialog::Resolve, base::Unretained(this), true));
+    SetCancelCallback(base::BindOnce(&ApprovalDialog::Resolve,
+                                     base::Unretained(this), false));
+    SetCloseCallback(base::BindOnce(&ApprovalDialog::Resolve,
+                                    base::Unretained(this), false));
+    auto* contents = SetContentsView(std::make_unique<views::View>());
+    ConfigureDialog(contents);
+
+    std::u16string source = base::UTF8ToUTF16(
+        request.source_browser + (request.profile_label.empty()
+                                      ? std::string()
+                                      : " / " + request.profile_label));
+    auto* summary = contents->AddChildView(std::make_unique<views::Label>(
+        u"Source: " + source + u"\nCookies: " +
+        base::NumberToString16(request.cookie_count) + u" (" +
+        base::NumberToString16(request.session_cookie_count) +
+        u" session; session cookies are not guaranteed across restart)\n"
+        u"Selected domains: " +
+        base::NumberToString16(request.selected_domain_count)));
+    summary->SetMultiLine(true);
+    summary->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+    std::u16string domains;
+    constexpr size_t kMaxShownDomains = 40;
+    for (size_t i = 0; i < request.domains.size() && i < kMaxShownDomains;
+         ++i) {
+      if (!domains.empty()) {
+        domains.append(u"\n");
+      }
+      domains.append(u"• ");
+      domains.append(base::UTF8ToUTF16(request.domains[i]));
+    }
+    if (request.domains.size() > kMaxShownDomains) {
+      domains.append(u"\n… and ");
+      domains.append(
+          base::NumberToString16(request.domains.size() - kMaxShownDomains));
+      domains.append(u" more");
+    }
+    auto* list = contents->AddChildView(
+        std::make_unique<views::Label>(u"Domains in this import:\n" + domains));
+    list->SetMultiLine(true);
+    list->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+    auto* warning = contents->AddChildView(std::make_unique<views::Label>(
+        u"Only allow this if you started the import in Browser CLI and "
+        u"recognize the source and domains. Cookie import is not login "
+        u"verification; you must check the websites yourself afterwards."));
+    warning->SetMultiLine(true);
+    warning->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  }
+
+ private:
+  void Resolve(bool approved) {
+    if (resolved_) {
+      return;
+    }
+    resolved_ = true;
+    if (on_result_) {
+      std::move(on_result_).Run(approved);
+    }
+  }
+
+  bool resolved_ = false;
+  base::OnceCallback<void(bool)> on_result_;
+};
+
+void ShowDialog(std::unique_ptr<views::DialogDelegate> dialog) {
+  views::Widget* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), /*context=*/nullptr, /*parent=*/nullptr);
+  if (widget) {
+    widget->Show();
+    // The browser may be running without a visible window (managed hidden
+    // mode). The import flow is user-triggered, so bring the consent UI to the
+    // front instead of relying on an existing browser window.
+    widget->Activate();
+  }
+}
+
+}  // namespace
+
+void ShowCookieImportSessionDialog(const std::u16string& ticket,
+                                   base::OnceClosure on_close) {
+  ShowDialog(std::make_unique<SessionDialog>(ticket, std::move(on_close)));
+}
+
+void ShowCookieImportApprovalDialog(const ApprovalRequest& request,
+                                    base::OnceCallback<void(bool)> on_result) {
+  ShowDialog(std::make_unique<ApprovalDialog>(request, std::move(on_result)));
+}
+
+}  // namespace browser_cli
+
+#endif  // BUILDFLAG(IS_WIN)
