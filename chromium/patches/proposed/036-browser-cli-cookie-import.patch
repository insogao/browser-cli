index 0000000..29816de
--- /dev/null
+++ b/chrome/browser/browser_cli/cookie_import/cookie_import_pipe_server_win.cc
@@ -0,0 +1,304 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/cookie_import/cookie_import_pipe_server_win.h"
+
+#include <windows.h>
+
+#include <sddl.h>
+
+#include <algorithm>
+#include <atomic>
+#include <deque>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/memory/ref_counted.h"
+#include "base/synchronization/lock.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/threading/platform_thread.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_cli/cookie_import/cookie_import_policy.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace browser_cli {
+namespace {
+
+constexpr wchar_t kPipeSecurityDescriptor[] = L"D:(A;;GA;;;OW)(A;;GA;;;SY)";
+
+std::string EncodeFrame(const base::DictValue& message) {
+  std::string json;
+  if (!base::JSONWriter::Write(message, &json) ||
+      json.size() > static_cast<size_t>(kMaxFrameBytes)) {
+    return std::string();
+  }
+  std::string frame;
+  frame.resize(4 + json.size());
+  const uint32_t length = static_cast<uint32_t>(json.size());
+  frame[0] = static_cast<char>(length & 0xff);
+  frame[1] = static_cast<char>((length >> 8) & 0xff);
+  frame[2] = static_cast<char>((length >> 16) & 0xff);
+  frame[3] = static_cast<char>((length >> 24) & 0xff);
+  frame.replace(4, json.size(), json);
+  return frame;
+}
+
+}  // namespace
+
+class CookieImportPipeServer::Core
+    : public base::RefCountedThreadSafe<CookieImportPipeServer::Core> {
+ public:
+  Core(std::wstring pipe_name, Delegate* delegate)
+      : pipe_name_(std::move(pipe_name)), delegate_(delegate) {}
+
+  void Enqueue(base::DictValue message) {
+    std::string frame = EncodeFrame(message);
+    if (frame.empty()) {
+      return;
+    }
+    base::AutoLock lock(lock_);
+    if (write_queue_.size() >= 1024) {
+      return;
+    }
+    write_queue_.push_back(std::move(frame));
+  }
+
+  void RequestStop() { stop_.store(true); }
+
+  // Blocks until the pipe has been created (or creation failed).
+  bool WaitForStart() {
+    started_.Wait();
+    return start_ok_.load();
+  }
+
+  void Run();
+
+ private:
+  friend class base::RefCountedThreadSafe<Core>;
+  ~Core() = default;
+
+  bool ProcessBuffer(std::string* buffer);
+  void DrainWrites(HANDLE pipe);
+  void PostMessage(base::DictValue message);
+
+  const std::wstring pipe_name_;
+  const raw_ptr<Delegate> delegate_;
+  std::atomic<bool> stop_{false};
+  std::atomic<bool> start_ok_{false};
+  base::WaitableEvent started_{base::WaitableEvent::ResetPolicy::MANUAL,
+                               base::WaitableEvent::InitialState::NOT_SIGNALED};
+  base::Lock lock_;
+  std::deque<std::string> write_queue_;
+};
+
+void CookieImportPipeServer::Core::PostMessage(base::DictValue message) {
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&Delegate::OnImportPipeMessage,
+                     base::Unretained(delegate_), std::move(message)));
+}
+
+bool CookieImportPipeServer::Core::ProcessBuffer(std::string* buffer) {
+  while (buffer->size() >= 4) {
+    const uint32_t length =
+        static_cast<uint8_t>((*buffer)[0]) |
+        (static_cast<uint32_t>(static_cast<uint8_t>((*buffer)[1])) << 8) |
+        (static_cast<uint32_t>(static_cast<uint8_t>((*buffer)[2])) << 16) |
+        (static_cast<uint32_t>(static_cast<uint8_t>((*buffer)[3])) << 24);
+    if (length == 0 || length > static_cast<uint32_t>(kMaxFrameBytes)) {
+      return false;
+    }
+    if (buffer->size() < 4 + length) {
+      return true;
+    }
+    std::string json = buffer->substr(4, length);
+    buffer->erase(0, 4 + length);
+    std::optional<base::DictValue> message =
+        base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC,
+                                   /*max_depth=*/64);
+    if (!message) {
+      return false;
+    }
+    PostMessage(std::move(*message));
+  }
+  return true;
+}
+
+void CookieImportPipeServer::Core::DrainWrites(HANDLE pipe) {
+  for (;;) {
+    std::string frame;
+    {
+      base::AutoLock lock(lock_);
+      if (write_queue_.empty()) {
+        return;
+      }
+      frame = write_queue_.front();
+    }
+    DWORD written = 0;
+    if (!::WriteFile(pipe, frame.data(), static_cast<DWORD>(frame.size()),
+                     &written, nullptr) ||
+        written == 0) {
+      return;
+    }
+    base::AutoLock lock(lock_);
+    if (!write_queue_.empty()) {
+      if (written >= write_queue_.front().size()) {
+        write_queue_.pop_front();
+      } else {
+        // A byte-mode pipe may accept a prefix; keep the remainder rather than
+        // re-sending bytes that the peer already received.
+        write_queue_.front().erase(0, written);
+        return;
+      }
+    }
+  }
+}
+
+void CookieImportPipeServer::Core::Run() {
+  PSECURITY_DESCRIPTOR security_descriptor = nullptr;
+  SECURITY_ATTRIBUTES security_attributes = {};
+  if (::ConvertStringSecurityDescriptorToSecurityDescriptorW(
+          kPipeSecurityDescriptor, SDDL_REVISION_1, &security_descriptor,
+          nullptr)) {
+    security_attributes.nLength = sizeof(security_attributes);
+    security_attributes.lpSecurityDescriptor = security_descriptor;
+    security_attributes.bInheritHandle = FALSE;
+  }
+
+  HANDLE pipe = ::CreateNamedPipeW(
+      pipe_name_.c_str(), PIPE_ACCESS_DUPLEX | FILE_FLAG_FIRST_PIPE_INSTANCE,
+      PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_REJECT_REMOTE_CLIENTS |
+          PIPE_NOWAIT,
+      /*nMaxInstances=*/1, /*nOutBufferSize=*/64 * 1024,
+      /*nInBufferSize=*/64 * 1024, /*nDefaultTimeOut=*/0,
+      security_descriptor ? &security_attributes : nullptr);
+  if (security_descriptor) {
+    ::LocalFree(security_descriptor);
+  }
+  start_ok_.store(pipe != INVALID_HANDLE_VALUE);
+  started_.Signal();
+  if (pipe == INVALID_HANDLE_VALUE) {
+    return;
+  }
+
+  bool connected = false;
+  std::string buffer;
+  while (!stop_.load()) {
+    if (!connected) {
+      if (::ConnectNamedPipe(pipe, nullptr)) {
+        connected = true;
+        DWORD client_pid = 0;
+        if (!::GetNamedPipeClientProcessId(pipe, &client_pid)) {
+          client_pid = 0;
+        }
+        content::GetUIThreadTaskRunner({})->PostTask(
+            FROM_HERE, base::BindOnce(&Delegate::OnImportPipeConnected,
+                                      base::Unretained(delegate_), client_pid));
+      } else {
+        const DWORD error = ::GetLastError();
+        if (error == ERROR_PIPE_CONNECTED) {
+          connected = true;
+          DWORD client_pid = 0;
+          if (!::GetNamedPipeClientProcessId(pipe, &client_pid)) {
+            client_pid = 0;
+          }
+          content::GetUIThreadTaskRunner({})->PostTask(
+              FROM_HERE,
+              base::BindOnce(&Delegate::OnImportPipeConnected,
+                             base::Unretained(delegate_), client_pid));
+        } else if (error != ERROR_PIPE_LISTENING) {
+          break;
+        }
+      }
+    }
+
+    if (connected) {
+      DrainWrites(pipe);
+      DWORD available = 0;
+      if (!::PeekNamedPipe(pipe, nullptr, 0, nullptr, &available, nullptr)) {
+        break;
+      }
+      while (available > 0 && !stop_.load()) {
+        char chunk[64 * 1024];
+        DWORD to_read =
+            std::min<DWORD>(available, static_cast<DWORD>(sizeof(chunk)));
+        DWORD read = 0;
+        if (!::ReadFile(pipe, chunk, to_read, &read, nullptr) || read == 0) {
+          break;
+        }
+        buffer.append(chunk, read);
+        if (!ProcessBuffer(&buffer)) {
+          stop_.store(true);
+          break;
+        }
+        if (!::PeekNamedPipe(pipe, nullptr, 0, nullptr, &available, nullptr)) {
+          break;
+        }
+      }
+    }
+
+    base::PlatformThread::Sleep(base::Milliseconds(10));
+  }
+
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&Delegate::OnImportPipeDisconnected,
+                                base::Unretained(delegate_)));
+  if (connected) {
+    ::DisconnectNamedPipe(pipe);
+  }
+  ::CloseHandle(pipe);
+}
+
+namespace {
+
+class CookieImportPipeThread : public base::SimpleThread {
+ public:
+  explicit CookieImportPipeThread(
+      scoped_refptr<CookieImportPipeServer::Core> core)
+      : base::SimpleThread("CookieImportPipe"), core_(std::move(core)) {}
+
+  void Run() override { core_->Run(); }
+
+ private:
+  scoped_refptr<CookieImportPipeServer::Core> core_;
+};
+
+}  // namespace
+
+CookieImportPipeServer::CookieImportPipeServer(std::wstring pipe_name,
+                                               Delegate* delegate)
+    : core_(base::MakeRefCounted<Core>(std::move(pipe_name), delegate)),
+      delegate_(delegate) {}
+
+CookieImportPipeServer::~CookieImportPipeServer() {
+  Stop();
+}
+
+bool CookieImportPipeServer::Start() {
+  if (thread_) {
+    return true;
+  }
+  thread_ = std::make_unique<CookieImportPipeThread>(core_);
+  thread_->Start();
+  return core_->WaitForStart();
+}
+
+void CookieImportPipeServer::Send(base::DictValue message) {
+  core_->Enqueue(std::move(message));
+}
+
+void CookieImportPipeServer::Stop() {
+  core_->RequestStop();
+  if (thread_) {
+    thread_->Join();
+    thread_.reset();
+  }
+}
+
+}  // namespace browser_cli
