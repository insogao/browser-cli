+namespace browser_cli {
+
+// In-process cookie-import target for Browser CLI.
+//
+// Started only when the user launches Browser CLI with
+// --browser-cli-cookie-import. It creates one one-time ticket, writes a
+// short-lived session descriptor (ticket hash only) for the BrowserPilot
+// native host, accepts one job over a user-only named pipe, asks the target
+// browser's own user to approve the exact source/domain scope, and then writes
+// cookies through the browser's CookieManager (the mojo front end of
+// net::CookieStore::SetCanonicalCookieAsync in the network service).
+//
+// The service never writes the Cookies SQLite file, never decrypts source
+// cookies, and never reports login verification.
+class CookieImportService : public CookieImportPipeServer::Delegate {
+ public:
+  using ApprovalCallback =
+      base::RepeatingCallback<void(const ApprovalRequest&,
+                                   base::OnceCallback<void(bool)>)>;
+
+  static void Start(Profile* profile);
+  static void Stop();
+  static CookieImportService* GetForTesting();
+
+  CookieImportService(const CookieImportService&) = delete;
+  CookieImportService& operator=(const CookieImportService&) = delete;
+  ~CookieImportService() override;
+
+  // CookieImportPipeServer::Delegate:
+  void OnImportPipeConnected(uint32_t client_pid) override;
+  void OnImportPipeMessage(base::DictValue message) override;
+  void OnImportPipeDisconnected() override;
+
+  void SetApprovalCallbackForTesting(ApprovalCallback callback);
+  std::string GetTicketForTesting() const;
+  std::string GetStateForTesting() const;
+
+ private:
+  struct Job;
+
+  explicit CookieImportService(Profile* profile);
+  void Initialize();
+  void Shutdown();
+
+  bool WriteDescriptor();
+  void RemoveDescriptor();
+
+  void HandleHello(const base::DictValue& message);
+  void HandleJobBegin(const base::DictValue& message);
+  void HandleJobChunk(const base::DictValue& message);
+  void HandleJobCommit(const base::DictValue& message);
+  void HandleCancel(const base::DictValue& message);
+
+  void StartApproval();
+  void OnApprovalResult(bool approved);
+  void StartApplying();
+  void ApplyNextCookie(size_t index);
+  void OnCookieSet(size_t index, net::CookieAccessResult result);
+  void CountFailure(const std::string& code);
+  void FinishJob();
+  void OnFlushDone();
+  void OnJobTimeout();
+  void OnSessionTimeout();
+
+  void Send(base::DictValue message);
+  void SendError(const std::string& code);
+  void SendStatus();
+  base::DictValue BuildPublicView() const;
+  base::DictValue BuildTotals() const;
+  base::DictValue BuildAuthorization() const;
+  std::string ComputeCookieImportedStatus() const;
+
+  bool IsRateLimited();
+  void RecordAuthFailure();
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<network::mojom::CookieManager> cookie_manager_ = nullptr;
+
+  std::string ticket_;
+  std::string ticket_hash_;
+  std::string instance_id_;
+  std::string profile_hash_;
+  std::wstring pipe_name_;
+  std::string session_dir_;
+  std::string descriptor_path_;
+  base::Time session_expires_at_;
+
+  std::unique_ptr<CookieImportPipeServer> pipe_server_;
+
+  bool hello_received_ = false;
+  bool consumed_ = false;
+  bool shutting_down_ = false;
+  uint32_t client_pid_ = 0;
+
+  std::string hello_job_nonce_;
+  std::string hello_job_digest_;
+  size_t hello_total_bytes_ = 0;
+  size_t hello_chunk_count_ = 0;
+  std::string job_nonce_;
+  std::string job_digest_;
+  size_t total_bytes_ = 0;
+  size_t chunk_count_ = 0;
+  size_t received_bytes_ = 0;
+  size_t next_chunk_ = 0;
+  std::vector<std::string> chunks_;
+
+  std::unique_ptr<Job> job_;
+  int last_progress_sent_ = 0;
+
+  ApprovalCallback approval_callback_;
+  base::OneShotTimer session_timer_;
+  base::OneShotTimer job_timer_;
+
+  std::deque<base::TimeTicks> failed_auth_attempts_;
+  std::deque<base::TimeTicks> hello_attempts_;
+  base::TimeTicks rate_limited_until_;
+
+  base::WeakPtrFactory<CookieImportService> weak_factory_{this};
+};
+
+}  // namespace browser_cli
