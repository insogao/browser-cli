+using ExclusionReason = net::CookieInclusionStatus::ExclusionReason;
+
+constexpr char kCookieFailureCodes[] =
+    "invalid-cookie invalid-domain invalid-url public-suffix-rejected "
+    "cookie-prefix-rejected partitioned-cookie-rejected samesite-rejected "
+    "expiry-rejected permission-or-host cookie-store-unavailable target-busy "
+    "profile-locked authorization-denied cancelled timeout internal";
+
+bool IsLowerHex(std::string_view value) {
+  if (value.empty()) {
+    return false;
+  }
+  for (char c : value) {
+    if (!base::IsAsciiDigit(c) && !(c >= 'a' && c <= 'f')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool HasControlCharacters(std::string_view value) {
+  return value.find_first_of("\r\n") != std::string_view::npos ||
+         value.find('\0') != std::string_view::npos;
+}
+
+std::string Base32Crockford(const uint8_t* bytes, size_t length) {
+  uint32_t buffer = 0;
+  int bits = 0;
+  std::string out;
+  out.reserve((length * 8 + 4) / 5);
+  for (size_t i = 0; i < length; ++i) {
+    buffer = (buffer << 8) | bytes[i];
+    bits += 8;
+    while (bits >= 5) {
+      out.push_back(kTicketAlphabet[(buffer >> (bits - 5)) & 31]);
+      bits -= 5;
+    }
+  }
+  if (bits > 0) {
+    out.push_back(kTicketAlphabet[(buffer << (5 - bits)) & 31]);
+  }
+  return out;
+}
+
+bool IsTicketAlphabetChar(char c) {
+  return std::string_view(kTicketAlphabet).find(c) != std::string_view::npos;
+}
+
+std::string NormalizeSameSite(std::string_view same_site) {
+  if (same_site == "no_restriction" || same_site == "lax" ||
+      same_site == "strict" || same_site == "unspecified") {
+    return std::string(same_site);
+  }
+  return std::string();
+}
+
+net::CookieSameSite SameSiteFromString(std::string_view same_site) {
+  if (same_site == "no_restriction") {
+    return net::CookieSameSite::NO_RESTRICTION;
+  }
+  if (same_site == "lax") {
+    return net::CookieSameSite::LAX_MODE;
+  }
+  if (same_site == "strict") {
+    return net::CookieSameSite::STRICT_MODE;
+  }
+  return net::CookieSameSite::UNSPECIFIED;
+}
+
+std::string PrefixFailure(const CookieRecord& cookie) {
+  const std::string& name = cookie.name;
+  auto has_prefix = [&name](std::string_view prefix) {
+    return name.rfind(prefix, 0) == 0;
+  };
+  if (has_prefix("__Host-Http-")) {
+    if (!cookie.secure || !cookie.http_only || cookie.path != "/" ||
+        !cookie.host_only) {
+      return "cookie-prefix-rejected";
+    }
+    return std::string();
+  }
+  if (has_prefix("__Host-")) {
+    if (!cookie.secure || cookie.path != "/" || !cookie.host_only) {
+      return "cookie-prefix-rejected";
+    }
+    return std::string();
+  }
+  if (has_prefix("__Secure-")) {
+    return cookie.secure ? std::string() : "cookie-prefix-rejected";
+  }
+  if (has_prefix("__Http-")) {
+    return cookie.secure && cookie.http_only ? std::string()
+                                             : "cookie-prefix-rejected";
+  }
+  return std::string();
+}
+
+std::string ValidateCookieRecordFields(const CookieRecord& cookie,
+                                       base::Time now) {
+  if (!IsValidDomain(cookie.domain)) {
+    return "invalid-domain";
+  }
+  if (cookie.host_only && base::StartsWith(cookie.domain, ".")) {
+    return "invalid-domain";
+  }
+  if (!cookie.host_only && !base::StartsWith(cookie.domain, ".")) {
+    return "invalid-domain";
+  }
+  if (cookie.name.empty() || cookie.name.size() > kMaxNameBytes ||
+      HasControlCharacters(cookie.name)) {
+    return "invalid-cookie";
+  }
+  if (cookie.value.size() > kMaxValueBytes ||
+      cookie.value.find('\0') != std::string::npos) {
+    return "invalid-cookie";
+  }
+  if (!base::StartsWith(cookie.path, "/") ||
+      cookie.path.size() > kMaxPathBytes || HasControlCharacters(cookie.path)) {
+    return "invalid-cookie";
+  }
+  if (cookie.same_site.empty()) {
+    return "samesite-rejected";
+  }
+  if (cookie.session) {
+    if (cookie.expiration_date != 0) {
+      return "expiry-rejected";
+    }
+  } else if (!(cookie.expiration_date > 0) ||
+             !(base::Time::FromSecondsSinceUnixEpoch(cookie.expiration_date) >
+               now)) {
+    return "expiry-rejected";
+  }
+  if (cookie.has_partition_key) {
+    if (cookie.top_level_site.empty() ||
+        cookie.top_level_site.size() > kMaxPartitionSiteBytes ||
+        !cookie.secure) {
+      return "partitioned-cookie-rejected";
+    }
+  }
+  if (cookie.same_site == "no_restriction" && !cookie.secure) {
+    return "samesite-rejected";
+  }
+  return PrefixFailure(cookie);
+}
+
+bool GetRequiredString(const base::DictValue& dict,
+                       std::string_view key,
+                       std::string* out) {
+  const std::string* value = dict.FindString(key);
+  if (!value) {
+    return false;
+  }
+  *out = *value;
+  return true;
+}
+
+bool ParseCookieRecord(const base::DictValue& dict,
+                       base::Time now,
+                       CookieRecord* cookie,
+                       std::string* error) {
+  if (!GetRequiredString(dict, "domain", &cookie->domain) ||
+      !GetRequiredString(dict, "path", &cookie->path) ||
+      !GetRequiredString(dict, "name", &cookie->name) ||
+      !GetRequiredString(dict, "value", &cookie->value) ||
+      !GetRequiredString(dict, "sameSite", &cookie->same_site)) {
+    *error = "invalid-cookie";
+    return false;
+  }
+  std::optional<bool> host_only = dict.FindBool("hostOnly");
+  std::optional<bool> secure = dict.FindBool("secure");
+  std::optional<bool> http_only = dict.FindBool("httpOnly");
+  std::optional<bool> session = dict.FindBool("session");
+  if (!host_only || !secure || !http_only || !session) {
+    *error = "invalid-cookie";
+    return false;
+  }
+  cookie->host_only = *host_only;
+  cookie->secure = *secure;
+  cookie->http_only = *http_only;
+  cookie->session = *session;
+  cookie->same_site = NormalizeSameSite(cookie->same_site);
+  if (cookie->same_site.empty()) {
+    *error = "samesite-rejected";
+    return false;
+  }
+  if (!cookie->session) {
+    std::optional<double> expiration = dict.FindDouble("expirationDate");
+    if (!expiration || !(*expiration > 0)) {
+      *error = "expiry-rejected";
+      return false;
+    }
+    cookie->expiration_date = *expiration;
+  } else if (dict.contains("expirationDate")) {
+    *error = "expiry-rejected";
+    return false;
+  }
+  const base::DictValue* partition = dict.FindDict("partitionKey");
+  if (dict.contains("partitionKey") && !partition) {
+    *error = "partitioned-cookie-rejected";
+    return false;
+  }
+  if (partition) {
+    std::string top_level_site;
+    std::optional<bool> cross_site =
+        partition->FindBool("hasCrossSiteAncestor");
+    if (!GetRequiredString(*partition, "topLevelSite", &top_level_site) ||
+        !cross_site) {
+      *error = "partitioned-cookie-rejected";
+      return false;
+    }
+    cookie->has_partition_key = true;
+    cookie->top_level_site = NormalizeTopLevelSite(top_level_site);
+    cookie->has_cross_site_ancestor = *cross_site;
+    if (cookie->top_level_site.empty()) {
+      *error = "partitioned-cookie-rejected";
+      return false;
+    }
+  }
+  *error = ValidateCookieRecordFields(*cookie, now);
+  return error->empty();
+}
