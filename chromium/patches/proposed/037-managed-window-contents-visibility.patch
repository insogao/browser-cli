+#if BUILDFLAG(IS_WIN)
+// Browser CLI: keeps the renderer visibility model consistent with a managed
+// window's native presentation state.
+//
+// A managed background window (--browser-cli-background-presentation without
+// USER_EXPLICIT/HUMAN ownership and without a foreground-assist lease) never
+// reaches the desktop: DesktopWindowTreeHostWin::Show() returns before showing
+// the content window and HWNDMessageHandler::OnWindowPosChanging() strips
+// SWP_SHOWWINDOW. That denial only changes the native window. WebContents
+// starts out VISIBLE and WebContentsImpl::PrimaryMainFrameCommitted() re-shows
+// the RenderWidgetHostView on every navigation commit, so the renderer keeps
+// committing main frames that no display will ever present. viz throttles
+// BeginFrames for such undrawn frames to about 1 Hz; each frame still registers
+// a presentation-time callback (PaintTiming / ReportTimeSwapPromise) that is
+// never consumed, and after about 60 s Blink's
+// LayerTreeView::AddCallback() DCHECK (61 > 60) kills the renderer.
+//
+// Returns true when |browser|'s window is a managed background window, |widget|
+// is not natively visible, and the same policy call the native host gate just
+// made denies presentation. A USER_EXPLICIT show and a live assist lease are
+// allowed by that call, so they never enter this state.
+bool BrowserCliShouldKeepContentsHidden(BrowserWindowInterface* browser,
+                                        views::Widget* widget) {
+  if (!views::BrowserCliPresentationPolicy::Get()->IsManagedModeEnabled()) {
+    return false;
+  }
+  if (!browser || !widget || widget->IsVisible()) {
+    return false;
+  }
+  return !views::BrowserCliAllowsPresentation(
+      widget, views::BrowserCliPresentationAction::kShowAndActivate);
+}
+
+// Hides every tab of a managed background window. WebContents that are already
+// hidden are left untouched so no observer sees a duplicate WasHidden().
+void BrowserCliHideContentsForUnpresentedWindow(
+    BrowserWindowInterface* browser) {
+  TabStripModel* tab_strip_model = browser->GetTabStripModel();
+  if (!tab_strip_model) {
+    return;
+  }
+  for (int index = 0; index < tab_strip_model->count(); ++index) {
+    content::WebContents* contents =
+        tab_strip_model->GetWebContentsAt(index);
+    if (contents && !contents->IsBeingDestroyed() &&
+        contents->GetVisibility() != content::Visibility::HIDDEN) {
+      contents->WasHidden();
+    }
+  }
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+            << " transition=managed-contents-hidden"
+            << " reason=native-presentation-denied native=win-hwnd";
+}
+#endif  // BUILDFLAG(IS_WIN)
