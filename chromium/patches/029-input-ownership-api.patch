+InputOwnershipApplyResult InputOwnershipDecider::SetOwnership(
+    InputOwnershipMode mode,
+    uint64_t version,
+    base::TimeTicks now) {
+  InputOwnershipApplyResult result;
+  if (!IsFeatureEnabled()) {
+    result.result = InputOwnershipWriteResult::kFeatureDisabled;
+    result.snapshot = snapshot();
+    return result;
+  }
+  Refresh(now);
+  result.snapshot = snapshot();
+
+  if (version == 0) {
+    result.result = InputOwnershipWriteResult::kInvalidArgument;
+    return result;
+  }
+  if (version < version_) {
+    result.result = InputOwnershipWriteResult::kStaleVersion;
+    return result;
+  }
+  if (version == version_) {
+    if (mode != mode_) {
+      result.result = InputOwnershipWriteResult::kVersionConflict;
+      return result;
+    }
+    // Idempotent replay (same version, same mode): only refresh last_update so
+    // a replayed setOwnership() also acts as a heartbeat.
+    last_update_ = now;
+    stale_ = false;
+    result.result = InputOwnershipWriteResult::kAccepted;
+    result.snapshot = snapshot();
+    return result;
+  }
+
+  // A newer version always wins. A mode change clears the grants (and stale
+  // gesture/scope state); a pure version bump also clears them, because the
+  // embedder is re-establishing the whole target state (design §1.2).
+  mode_ = mode;
+  version_ = version;
+  ClearDebuggerSessions();
+  ClearAutomationEventWindow();
+  last_update_ = now;
+  stale_ = false;
+
+  result.result = InputOwnershipWriteResult::kAccepted;
+  result.snapshot = snapshot();
+  return result;
+}
+
+InputOwnershipApplyResult InputOwnershipDecider::Heartbeat(
+    uint64_t version,
+    base::TimeTicks now) {
+  InputOwnershipApplyResult result;
+  if (!IsFeatureEnabled()) {
+    result.result = InputOwnershipWriteResult::kFeatureDisabled;
+    result.snapshot = snapshot();
+    return result;
+  }
+  Refresh(now);
+  result.snapshot = snapshot();
+
+  if (version < version_) {
+    result.result = InputOwnershipWriteResult::kStaleVersion;
+    return result;
+  }
+  if (version > version_) {
+    // Only SetOwnership() may advance the version.
+    result.result = InputOwnershipWriteResult::kVersionUnknown;
+    return result;
+  }
+
+  // A heartbeat never changes the mode, never advances the version and never
+  // clears grants; it only proves the embedder is still alive.
+  last_update_ = now;
+  stale_ = false;
+  result.result = InputOwnershipWriteResult::kAccepted;
+  result.snapshot = snapshot();
+  return result;
+}
+
+InputOwnershipGrantInfo InputOwnershipDecider::GrantDebuggerInput(
+    InputOwnershipSessionToken session,
+    int actions,
+    base::TimeDelta ttl,
+    base::TimeTicks now) {
+  InputOwnershipGrantInfo info;
+  if (!IsFeatureEnabled()) {
+    return info;
+  }
+  if (session == nullptr || actions <= 0 || ttl <= base::TimeDelta()) {
+    RevokeDebuggerSession(session);
+    return info;
+  }
+  Refresh(now);
+  PurgeExpired(now);
+
+  // A grant is a fresh, self-contained budget: it replaces any previous grant
+  // for this session (never accumulates), the deadline is fixed once here and
+  // no subsequent input event can extend it. It does not touch the mode, the
+  // version or last_update.
+  DebuggerSessionState& state = debugger_sessions_[session];
+  state = DebuggerSessionState();
+  state.grant_remaining = std::min(actions, kMaxGrantActions);
+  state.grant_deadline = now + std::min(ttl, kMaxGrantTtl);
+
+  info.granted = true;
+  info.remaining = state.grant_remaining;
+  info.expires_at = state.grant_deadline;
+  return info;
+}
+
+InputOwnershipCommandScope InputOwnershipDecider::BeginCommand(
+    InputOwnershipSessionToken session,
+    const std::string& command_id,
+    base::TimeDelta max_duration,
+    base::TimeTicks now) {
+  InputOwnershipCommandScope scope;
+  if (!IsFeatureEnabled()) {
+    scope.result = InputOwnershipWriteResult::kFeatureDisabled;
+    return scope;
+  }
+  if (session == nullptr || command_id.empty() ||
+      max_duration <= base::TimeDelta()) {
+    scope.result = InputOwnershipWriteResult::kInvalidArgument;
+    return scope;
+  }
+  Refresh(now);
+  PurgeExpired(now);
+
+  // Idempotent retry: the same command id inside the same session returns the
+  // existing scope without billing another unit.
+  if (DebuggerSessionState* state = FindSession(session)) {
+    auto it = state->command_scopes.find(command_id);
+    if (it != state->command_scopes.end()) {
+      scope.result = InputOwnershipWriteResult::kAccepted;
+      scope.scope_id = it->second.scope_id;
+      scope.deadline = it->second.deadline;
+      scope.grant_remaining = state->grant_remaining;
+      return scope;
+    }
+  }
+
+  switch (EffectiveMode(now)) {
+    case InputOwnershipMode::kAi:
+      // AI needs no budget at all; the scope is implicit.
+      scope.result = InputOwnershipWriteResult::kAccepted;
+      scope.grant_remaining = -1;
+      return scope;
+    case InputOwnershipMode::kHuman:
+      // HUMAN never accepts automation input; the extension must not even try.
+      scope.result = InputOwnershipWriteResult::kGrantRequired;
+      return scope;
+    case InputOwnershipMode::kAssist:
+      break;
+  }
+
+  if (IsDebuggerInputPaused(now)) {
+    scope.result = InputOwnershipWriteResult::kGrantRequired;
+    return scope;
+  }
+
+  DebuggerSessionState* state = FindSession(session);
+  if (!state || state->command_scopes.size() >= kMaxCommandScopesPerSession ||
+      !ConsumeGrant(*state, now)) {
+    scope.result = InputOwnershipWriteResult::kGrantRequired;
+    return scope;
+  }
+
+  // Reserve the unit now; the scope itself is bounded by both the caller's
+  // duration and the absolute grant deadline.
+  const base::TimeTicks deadline =
+      CapToGrant(*state, now + std::min(max_duration, kMaxCommandScope));
+  CommandScopeState& entry = state->command_scopes[command_id];
+  entry.scope_id = base::NumberToString(next_scope_id_++);
+  entry.deadline = deadline;
+
+  scope.result = InputOwnershipWriteResult::kAccepted;
+  scope.scope_id = entry.scope_id;
+  scope.deadline = deadline;
+  scope.grant_remaining = state->grant_remaining;
+  return scope;
+}
+
+InputOwnershipWriteResult InputOwnershipDecider::EndCommand(
+    InputOwnershipSessionToken session,
+    const std::string& command_id,
+    bool cancelled,
+    base::TimeTicks now) {
+  if (!IsFeatureEnabled()) {
+    return InputOwnershipWriteResult::kFeatureDisabled;
+  }
+  if (session == nullptr || command_id.empty()) {
+    return InputOwnershipWriteResult::kInvalidArgument;
+  }
+  DebuggerSessionState* state = FindSession(session);
+  if (!state) {
+    return InputOwnershipWriteResult::kUnknownCommand;
+  }
+  auto it = state->command_scopes.find(command_id);
+  if (it == state->command_scopes.end()) {
+    return InputOwnershipWriteResult::kUnknownCommand;
+  }
+
+  // `ok` and `failed` keep the reserved unit spent (the delivery attempt was
+  // made). `cancelled` refunds it only when the scope never authorized input
+  // and the grant is still live.
+  const bool refund = cancelled && it->second.authorized_events == 0 &&
+                      state->grant_remaining < kMaxGrantActions &&
+                      !state->grant_deadline.is_null() &&
+                      now < state->grant_deadline;
+  state->command_scopes.erase(it);
+  if (refund) {
+    ++state->grant_remaining;
+  }
+  // `state` may be dangling if the bucket was erased by a nested call; nothing
+  // else touches it.
+  if (state->IsIdle() && state->grant_remaining == 0) {
+    debugger_sessions_.erase(session);
+  }
+  return InputOwnershipWriteResult::kAccepted;
+}
+
+bool InputOwnershipDecider::DebuggerSessionState::HasLiveScope(
+    base::TimeTicks now) const {
+  for (const auto& [id, scope] : command_scopes) {
+    if (now < scope.deadline) {
+      return true;
+    }
+  }
+  return false;
+}
+
+InputOwnershipDecider::CommandScopeState*
+InputOwnershipDecider::DebuggerSessionState::FindLiveScope(base::TimeTicks now) {
+  for (auto& [id, scope] : command_scopes) {
+    if (now < scope.deadline) {
+      return &scope;
+    }
+  }
+  return nullptr;
+}
+
+void InputOwnershipDecider::DebuggerSessionState::NoteScopeAuthorized(
+    base::TimeTicks now) {
+  if (CommandScopeState* scope = FindLiveScope(now)) {
+    ++scope->authorized_events;
+  }
+}
