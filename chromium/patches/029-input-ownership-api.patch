+ExtensionDebuggerSession GetExtensionDebuggerSessionForTab(
+    content::BrowserContext* browser_context,
+    const ExtensionId& extension_id,
+    content::WebContents* web_contents) {
+  // Browser CLI (patch 029): the input ownership API needs the caller's own
+  // chrome.debugger session to bind an input grant to it. The client host owns
+  // the exact DevToolsAgentHost that `chrome.debugger.attach` used, so return
+  // that host together with the client instead of re-resolving the tab through
+  // `DevToolsAgentHost::GetForTab` (which yields the tab-target host, a
+  // different object with a different DevToolsSession).
+  ExtensionDebuggerSession result;
+  if (!web_contents || !browser_context) {
+    return result;
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  for (ExtensionDevToolsClientHost* client_host : GetAttachedClientHosts()) {
+    if (!client_host || client_host->extension_id() != extension_id) {
+      continue;
+    }
+    if (client_host->profile() != profile) {
+      continue;
+    }
+    if (client_host->agent_host()->GetWebContents() != web_contents) {
+      continue;
+    }
+    result.agent_host = client_host->agent_host();
+    result.client = client_host;
+    return result;
+  }
+  return result;
+}
+
 }  // namespace extensions
