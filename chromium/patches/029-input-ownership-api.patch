+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/common/extensions/api/browser_cli_input_ownership_availability.h"
+
+#include "extensions/common/mojom/context_type.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace extensions::browser_cli_input_ownership_availability {
+namespace {
+
+// A top-level API feature: if this ever becomes a child of another feature
+// ("browserCli.inputOwnership" style), extensions/renderer/feature_cache.cc
+// skips it and the namespace is never installed into extension bindings.
+constexpr char kNamespaceName[] = "browserCliInputOwnership";
+
+}  // namespace
+
+TEST(BrowserCliInputOwnershipAvailabilityTest, RegistersTopLevelNamespace) {
+  const Feature::FeatureDelegatedAvailabilityCheckMap map =
+      CreateAvailabilityCheckMap();
+  EXPECT_NE(map.end(), map.find(kNamespaceName));
+  EXPECT_EQ(1u, map.size());
+}
+
+TEST(BrowserCliInputOwnershipAvailabilityTest, FeatureOffHidesNamespace) {
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      /*feature_enabled=*/false, /*managed_mode=*/true,
+      mojom::ContextType::kPrivilegedExtension));
+}
+
+TEST(BrowserCliInputOwnershipAvailabilityTest, ManagedModeOffHidesNamespace) {
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      /*feature_enabled=*/true, /*managed_mode=*/false,
+      mojom::ContextType::kPrivilegedExtension));
+}
+
+TEST(BrowserCliInputOwnershipAvailabilityTest, OnlyPrivilegedExtensionAllowed) {
+  EXPECT_TRUE(IsInputOwnershipNamespaceAvailable(
+      /*feature_enabled=*/true, /*managed_mode=*/true,
+      mojom::ContextType::kPrivilegedExtension));
+
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      true, true, mojom::ContextType::kUnprivilegedExtension));
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      true, true, mojom::ContextType::kContentScript));
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      true, true, mojom::ContextType::kWebPage));
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      true, true, mojom::ContextType::kPrivilegedWebPage));
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      true, true, mojom::ContextType::kWebUi));
+  EXPECT_FALSE(IsInputOwnershipNamespaceAvailable(
+      true, true, mojom::ContextType::kUnspecified));
+}
+
+}  // namespace extensions::browser_cli_input_ownership_availability
