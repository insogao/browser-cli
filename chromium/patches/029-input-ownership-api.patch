+// ---------------------------------------------------------------------------
+// grantInput
+// ---------------------------------------------------------------------------
+
+BrowserCliInputOwnershipGrantInputFunction::BrowserCliInputOwnershipGrantInputFunction() =
+    default;
+
+BrowserCliInputOwnershipGrantInputFunction::
+    ~BrowserCliInputOwnershipGrantInputFunction() = default;
+
+ExtensionFunction::ResponseAction
+BrowserCliInputOwnershipGrantInputFunction::Run() {
+  std::string trust_error;
+  if (!PrepareCall(this, &trust_error)) {
+    return RespondNow(Error(trust_error));
+  }
+  auto params = api_io::GrantInput::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+  const api_io::Target& target = params->request.target;
+  if (!target.tab_id.has_value() || target.window_id.has_value()) {
+    return RespondNow(Error(kInvalidTarget));
+  }
+  if (params->request.actions <= 0 || params->request.ttl_ms <= 0) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+
+  api_io::GrantResult result;
+  result.granted = false;
+  result.actions = params->request.actions;
+
+  content::WebContents* web_contents = nullptr;
+  std::string reason;
+  if (!ResolveTab(browser_context(), include_incognito_information(), target,
+                  &web_contents, &reason)) {
+    result.reason = reason;
+    return RespondNow(
+        ArgumentList(api_io::GrantInput::Results::Create(result)));
+  }
+
+  ResolvedDebuggerSession session;
+  if (!ResolveDebuggerSession(this, web_contents, &session, &reason)) {
+    result.reason = reason;
+    return RespondNow(
+        ArgumentList(api_io::GrantInput::Results::Create(result)));
+  }
+
+  const content::InputOwnershipGrantInfo grant = content::GrantDebuggerInput(
+      web_contents, session.token, params->request.actions,
+      base::Milliseconds(params->request.ttl_ms));
+  result.granted = grant.granted;
+  result.actions = grant.remaining > 0 ? grant.remaining : result.actions;
+  if (grant.granted) {
+    result.expires_at = static_cast<double>(ToEpochMs(grant.expires_at));
+  } else {
+    result.reason = kInvalidArgument;
+  }
+  return RespondNow(ArgumentList(api_io::GrantInput::Results::Create(result)));
+}
