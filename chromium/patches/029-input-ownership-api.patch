+// --- Production API (K10-K13) ----------------------------------------------
+
+// K10: a target that stops being refreshed degrades to the effective ASSIST
+// mode after 30s, drops every grant, and keeps the configured mode so one
+// heartbeat restores it without a version bump.
+TEST_F(InputOwnershipDeciderTest, StaleDegradesToAssistWithoutRewritingMode) {
+  EnableFeature();
+  const base::TimeTicks t0 = T0();
+  auto applied = decider_.SetOwnership(InputOwnershipMode::kAi, 1, t0);
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted, applied.result);
+  EXPECT_EQ(InputOwnershipMode::kAi, applied.snapshot.mode);
+  EXPECT_FALSE(applied.snapshot.stale);
+
+  decider_.GrantDebuggerInput(SessionA(), 3, base::Seconds(60), t0);
+  ASSERT_EQ(3, Remaining(SessionA()));
+
+  // 30s without an accepted update: effective mode is ASSIST.
+  const base::TimeTicks stale_at = t0 + base::Seconds(31);
+  EXPECT_TRUE(decider_.IsStale(stale_at));
+  EXPECT_EQ(InputOwnershipMode::kAssist, decider_.EffectiveMode(stale_at));
+  EXPECT_FALSE(Mouse(Type::kMouseDown, stale_at));
+  EXPECT_EQ(0, Remaining(SessionA()));
+
+  // The configured mode/version are untouched.
+  const InputOwnershipSnapshot snapshot = decider_.SnapshotAt(stale_at);
+  EXPECT_EQ(InputOwnershipMode::kAi, snapshot.mode);
+  EXPECT_EQ(1u, snapshot.version);
+  EXPECT_TRUE(snapshot.stale);
+
+  // One heartbeat restores the configured mode, no version bump.
+  applied = decider_.Heartbeat(1, stale_at);
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted, applied.result);
+  EXPECT_FALSE(applied.snapshot.stale);
+  EXPECT_EQ(InputOwnershipMode::kAi, applied.snapshot.mode);
+  EXPECT_EQ(1u, applied.snapshot.version);
+  EXPECT_TRUE(Mouse(Type::kMouseDown, stale_at));
+
+  // A stale target cannot deliver unattributed or grant-based debugger input.
+  const base::TimeTicks stale_again = stale_at + base::Seconds(31);
+  EXPECT_FALSE(UnattributedDebuggerMouse(Type::kMouseDown, stale_again));
+  EXPECT_FALSE(Mouse(Type::kMouseDown, stale_again));
+}
+
+// K11: version semantics - monotonic; same version/same mode idempotent;
+// same version/different mode conflicts; lower version is stale.
+TEST_F(InputOwnershipDeciderTest, SetOwnershipVersionSemantics) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+
+  auto applied = decider_.SetOwnership(InputOwnershipMode::kAi, 5, now);
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted, applied.result);
+  EXPECT_EQ(5u, applied.snapshot.version);
+
+  // Same version, same mode: idempotent and refreshes last_update.
+  applied = decider_.SetOwnership(InputOwnershipMode::kAi, 5,
+                                  now + base::Seconds(10));
+  EXPECT_EQ(InputOwnershipWriteResult::kAccepted, applied.result);
+  EXPECT_EQ(5u, applied.snapshot.version);
+  EXPECT_EQ(now + base::Seconds(10), applied.snapshot.last_update);
+
+  // Same version, different mode: conflict, state unchanged.
+  applied = decider_.SetOwnership(InputOwnershipMode::kHuman, 5, now);
+  EXPECT_EQ(InputOwnershipWriteResult::kVersionConflict, applied.result);
+  EXPECT_EQ(InputOwnershipMode::kAi, applied.snapshot.mode);
+  EXPECT_EQ(5u, applied.snapshot.version);
+
+  // Lower version: stale, state unchanged.
+  applied = decider_.SetOwnership(InputOwnershipMode::kHuman, 4, now);
+  EXPECT_EQ(InputOwnershipWriteResult::kStaleVersion, applied.result);
+  EXPECT_EQ(InputOwnershipMode::kAi, applied.snapshot.mode);
+
+  // Higher version wins, even with the same mode, and clears grants.
+  decider_.GrantDebuggerInput(SessionA(), 3, base::Seconds(10), now);
+  ASSERT_EQ(3, Remaining(SessionA()));
+  applied = decider_.SetOwnership(InputOwnershipMode::kAi, 6, now);
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted, applied.result);
+  EXPECT_EQ(6u, applied.snapshot.version);
+  EXPECT_EQ(0, Remaining(SessionA()));
+
+  // Version zero is never valid.
+  applied = decider_.SetOwnership(InputOwnershipMode::kAi, 0, now);
+  EXPECT_EQ(InputOwnershipWriteResult::kInvalidArgument, applied.result);
+}
+
+// K11/K12: heartbeat must not advance the version, must reject an unknown
+// newer version, and must not clear a grant.
+TEST_F(InputOwnershipDeciderTest, HeartbeatDoesNotBumpVersionOrClearGrant) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAssist, 2, now).result);
+  decider_.GrantDebuggerInput(SessionA(), 2, base::Seconds(30), now);
+
+  auto applied = decider_.Heartbeat(2, now + base::Seconds(5));
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted, applied.result);
+  EXPECT_EQ(2u, applied.snapshot.version);
+  EXPECT_EQ(2, Remaining(SessionA()));
+
+  applied = decider_.Heartbeat(3, now + base::Seconds(5));
+  EXPECT_EQ(InputOwnershipWriteResult::kVersionUnknown, applied.result);
+  EXPECT_EQ(2u, applied.snapshot.version);
+
+  applied = decider_.Heartbeat(1, now + base::Seconds(5));
+  EXPECT_EQ(InputOwnershipWriteResult::kStaleVersion, applied.result);
+}
+
+// Feature off: the production write entry points report FEATURE_DISABLED and
+// change nothing.
+TEST_F(InputOwnershipDeciderTest, ProductionWritesAreInertWhenFeatureOff) {
+  DisableFeature();
+  const base::TimeTicks now = T0();
+  EXPECT_EQ(InputOwnershipWriteResult::kFeatureDisabled,
+            decider_.SetOwnership(InputOwnershipMode::kAi, 1, now).result);
+  EXPECT_EQ(InputOwnershipWriteResult::kFeatureDisabled,
+            decider_.Heartbeat(1, now).result);
+  EXPECT_FALSE(
+      decider_.GrantDebuggerInput(SessionA(), 1, base::Seconds(10), now)
+          .granted);
+  EXPECT_EQ(InputOwnershipWriteResult::kFeatureDisabled,
+            decider_.BeginCommand(SessionA(), "cmd", base::Seconds(5), now)
+                .result);
+  EXPECT_EQ(0u, decider_.snapshot().version);
+}
+
+// K12: one command scope == one grant, regardless of how many events the
+// command produces. The reserved unit stays spent after end().
+TEST_F(InputOwnershipDeciderTest, CommandScopeAuthorizesEventsForOneUnit) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAssist, 1, now).result);
+  decider_.GrantDebuggerInput(SessionA(), 2, base::Seconds(60), now);
+
+  auto scope = decider_.BeginCommand(SessionA(), "cmd-1", base::Seconds(10),
+                                     now);
+  ASSERT_TRUE(scope.ok());
+  EXPECT_FALSE(scope.scope_id.empty());
+  EXPECT_EQ(1, Remaining(SessionA()));
+
+  // A dblclick (two press/release pairs) and a burst of insertText cost
+  // nothing extra inside the scope.
+  for (int i = 0; i < 2; ++i) {
+    EXPECT_TRUE(Mouse(Type::kMouseDown, now));
+    EXPECT_TRUE(Mouse(Type::kMouseUp, now));
+  }
+  EXPECT_TRUE(Text(now));
+  EXPECT_TRUE(Text(now));
+  EXPECT_EQ(1, Remaining(SessionA()));
+
+  // Idempotent begin for the same command id does not bill again.
+  auto again = decider_.BeginCommand(SessionA(), "cmd-1",
+                                     base::Seconds(10), now);
+  ASSERT_TRUE(again.ok());
+  EXPECT_EQ(scope.scope_id, again.scope_id);
+  EXPECT_EQ(1, Remaining(SessionA()));
+
+  // Ending with outcome ok keeps the unit spent; the remaining unit is billed
+  // by the next press and then the session is exhausted.
+  EXPECT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.EndCommand(SessionA(), "cmd-1", /*cancelled=*/false, now));
+  EXPECT_TRUE(Mouse(Type::kMouseDown, now + base::Milliseconds(10)));
+  EXPECT_EQ(0, Remaining(SessionA()));
+  EXPECT_FALSE(Mouse(Type::kMouseDown, now + base::Milliseconds(20)));
+
+  // Unknown command id is idempotent/tolerant.
+  EXPECT_EQ(InputOwnershipWriteResult::kUnknownCommand,
+            decider_.EndCommand(SessionA(), "nope", false, now));
+}
+
+// K12: cancelled scopes refund their reserved unit only when no input was
+// authorized inside them.
+TEST_F(InputOwnershipDeciderTest, CancelledCommandRefundsOnlyUnusedScope) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAssist, 1, now).result);
+  decider_.GrantDebuggerInput(SessionA(), 2, base::Seconds(60), now);
+
+  ASSERT_TRUE(decider_.BeginCommand(SessionA(), "unused", base::Seconds(10),
+                                    now)
+                  .ok());
+  EXPECT_EQ(1, Remaining(SessionA()));
+  EXPECT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.EndCommand(SessionA(), "unused", /*cancelled=*/true, now));
+  EXPECT_EQ(2, Remaining(SessionA()));
+
+  ASSERT_TRUE(decider_.BeginCommand(SessionA(), "used", base::Seconds(10), now)
+                  .ok());
+  EXPECT_TRUE(Mouse(Type::kMouseMove, now));
+  EXPECT_EQ(1, Remaining(SessionA()));
+  EXPECT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.EndCommand(SessionA(), "used", /*cancelled=*/true, now));
+  EXPECT_EQ(1, Remaining(SessionA()));
+}
+
+// K12: an expired command scope stops authorizing input; the reserved unit
+// stays spent and future events need a new grant.
+TEST_F(InputOwnershipDeciderTest, CommandScopeDeadlineIsAbsolute) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAssist, 1, now).result);
+  decider_.GrantDebuggerInput(SessionA(), 1, base::Seconds(60), now);
+  ASSERT_TRUE(decider_.BeginCommand(SessionA(), "cmd", base::Seconds(2), now)
+                  .ok());
+
+  EXPECT_TRUE(Mouse(Type::kMouseDown, now + base::Milliseconds(1999)));
+  // Scope expired: the next event has no unit left.
+  EXPECT_FALSE(Mouse(Type::kMouseDown, now + base::Seconds(2)));
+  EXPECT_EQ(0, Remaining(SessionA()));
+}
+
+// K12: begin without a grant fails closed; HUMAN never accepts a scope.
+TEST_F(InputOwnershipDeciderTest, BeginRequiresGrantAndRejectsHuman) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kAssist, 1, now).result);
+  EXPECT_EQ(InputOwnershipWriteResult::kGrantRequired,
+            decider_.BeginCommand(SessionA(), "cmd", base::Seconds(5), now)
+                .result);
+
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted,
+            decider_.SetOwnership(InputOwnershipMode::kHuman, 2, now).result);
+  decider_.GrantDebuggerInput(SessionA(), 5, base::Seconds(60), now);
+  EXPECT_EQ(InputOwnershipWriteResult::kGrantRequired,
+            decider_.BeginCommand(SessionA(), "cmd", base::Seconds(5), now)
+                .result);
+  EXPECT_EQ(5, Remaining(SessionA()));
+}
