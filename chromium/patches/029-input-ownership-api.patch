+BrowserCliInputOwnershipGetOwnershipFunction::BrowserCliInputOwnershipGetOwnershipFunction() =
+    default;
+
+BrowserCliInputOwnershipGetOwnershipFunction::
+    ~BrowserCliInputOwnershipGetOwnershipFunction() = default;
+
+ExtensionFunction::ResponseAction
+BrowserCliInputOwnershipGetOwnershipFunction::Run() {
+  std::string trust_error;
+  if (!PrepareCall(this, &trust_error)) {
+    return RespondNow(Error(trust_error));
+  }
+  auto params = api_io::GetOwnership::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+  const api_io::Target& target = params->request.target;
+  if (!HasExactlyOneTarget(target)) {
+    return RespondNow(Error(kInvalidTarget));
+  }
+
+  content::InputOwnershipSnapshot snapshot;
+  bool found = false;
+  if (target.tab_id.has_value()) {
+    content::WebContents* web_contents = nullptr;
+    std::string reason;
+    if (!ResolveTab(browser_context(), include_incognito_information(), target,
+                    &web_contents, &reason)) {
+      api_io::Snapshot result;
+      result.mode = api_io::Mode::kAssist;
+      result.version = 0;
+      result.stale = true;
+      result.reason = reason;
+      return RespondNow(
+          ArgumentList(api_io::GetOwnership::Results::Create(result)));
+    }
+    snapshot = content::GetInputOwnershipSnapshot(web_contents);
+    found = true;
+  } else {
+    WindowController* window = nullptr;
+    std::string reason;
+    if (!ResolveWindow(browser_context(), include_incognito_information(),
+                       target, &window, &reason)) {
+      api_io::Snapshot result;
+      result.mode = api_io::Mode::kAssist;
+      result.version = 0;
+      result.stale = true;
+      result.reason = reason;
+      return RespondNow(
+          ArgumentList(api_io::GetOwnership::Results::Create(result)));
+    }
+    for (int i = 0; i < window->GetTabCount(); ++i) {
+      content::WebContents* web_contents = window->GetWebContentsAt(i);
+      if (!web_contents) {
+        continue;
+      }
+      snapshot = content::GetInputOwnershipSnapshot(web_contents);
+      found = true;
+      break;
+    }
+  }
+
+  api_io::Snapshot result;
+  result.mode = ToApiMode(snapshot.mode);
+  result.version = static_cast<int>(snapshot.version);
+  result.stale = snapshot.stale;
+  if (!snapshot.last_update.is_null()) {
+    result.last_update_at = static_cast<double>(ToEpochMs(snapshot.last_update));
+  }
+  if (!found) {
+    result.reason = kUnknownTarget;
+  }
+  return RespondNow(ArgumentList(api_io::GetOwnership::Results::Create(result)));
+}
