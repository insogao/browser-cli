+#include "chrome/common/extensions/api/browser_cli_input_ownership_availability.h"
+
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/feature_list.h"
+#include "content/public/common/content_features.h"
+#include "extensions/common/context_data.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/features/feature.h"
+#include "extensions/common/mojom/context_type.mojom.h"
+#include "url/gurl.h"
+
+namespace extensions::browser_cli_input_ownership_availability {
+
+namespace {
+
+// The feature (namespace) this delegated check applies to. It must be a
+// TOP-LEVEL namespace: `extensions/renderer/feature_cache.cc` skips every API
+// feature that has a parent feature (for example "browserCli.inputOwnership"
+// would be treated as a child of "browserCli" and never installed into the
+// extension bindings). Keep this in sync with the `"namespace"` in
+// browser_cli_input_ownership.json and the `_api_features.json` key.
+constexpr char kInputOwnershipFeature[] = "browserCliInputOwnership";
+
+// Mirrors `kBrowserCliBackgroundPresentationSwitch` in
+// ui/views/widget/browser_cli_presentation_policy.h. It is duplicated because
+// chrome/common must not depend on //ui/views; the switch is also propagated to
+// renderer processes (chrome_content_browser_client.cc) so extension-page
+// availability sees the same managed-mode state. If the switch is ever renamed
+// this check simply stops matching and the API stays unavailable (fail closed).
+constexpr char kManagedModeSwitch[] = "browser-cli-background-presentation";
+
+bool IsInputOwnershipNamespaceAvailable(bool feature_enabled,
+                                        bool managed_mode,
+                                        extensions::mojom::ContextType context) {
+  return feature_enabled && managed_mode &&
+         context == extensions::mojom::ContextType::kPrivilegedExtension;
+}
+
+bool AreInputOwnershipFeaturesAvailable(
+    std::string_view api_full_name,
+    const extensions::Extension* extension,
+    extensions::mojom::ContextType context,
+    const GURL& url,
+    extensions::Feature::Platform platform,
+    int context_id,
+    bool check_developer_mode,
+    const extensions::ContextData& context_data) {
+  if (api_full_name != kInputOwnershipFeature) {
+    return false;
+  }
+  return IsInputOwnershipNamespaceAvailable(
+      base::FeatureList::IsEnabled(::features::kInputOwnershipEnforcement),
+      base::CommandLine::ForCurrentProcess()->HasSwitch(kManagedModeSwitch),
+      context);
+}
+
+}  // namespace
+
+Feature::FeatureDelegatedAvailabilityCheckMap CreateAvailabilityCheckMap() {
+  Feature::FeatureDelegatedAvailabilityCheckMap map;
+  map.emplace(kInputOwnershipFeature, &AreInputOwnershipFeaturesAvailable);
+  return map;
+}
+
+}  // namespace extensions::browser_cli_input_ownership_availability
