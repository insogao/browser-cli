+// --- Controller + free-function API tests -----------------------------------
+
+class InputOwnershipApiTest : public RenderViewHostTestHarness {};
+
+// The production free functions resolve the per-WebContents controller and
+// share the same state as the controller entry points.
+TEST_F(InputOwnershipApiTest, FreeFunctionsWriteThroughTheController) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  auto applied =
+      SetInputOwnership(web_contents(), InputOwnershipMode::kAssist, 3);
+  ASSERT_EQ(InputOwnershipWriteResult::kAccepted, applied.result);
+  EXPECT_EQ(InputOwnershipMode::kAssist, applied.snapshot.mode);
+  EXPECT_EQ(3u, applied.snapshot.version);
+
+  blink::WebMouseEvent debugger_mouse(Type::kMouseDown, kDebuggerModifiers,
+                                      now);
+  // ASSIST without a grant fails closed.
+  EXPECT_TRUE(
+      static_cast<WebContentsImpl*>(web_contents())
+          ->GetInputOwnershipController()
+          ->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+
+  // The delivery check above bills one unit (one mouse press); grant a third so
+  // the command scope still has a unit to reserve.
+  const InputOwnershipGrantInfo grant =
+      GrantDebuggerInput(web_contents(), SessionA(), 3, base::Seconds(30));
+  EXPECT_TRUE(grant.granted);
+  EXPECT_EQ(3, grant.remaining);
+  EXPECT_FALSE(
+      static_cast<WebContentsImpl*>(web_contents())
+          ->GetInputOwnershipController()
+          ->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+
+  const InputOwnershipCommandScope scope = BeginInputOwnershipCommand(
+      web_contents(), SessionA(), "cmd", base::Seconds(5));
+  ASSERT_TRUE(scope.ok());
+  EXPECT_EQ(1, scope.grant_remaining);
+  EXPECT_EQ(InputOwnershipWriteResult::kAccepted,
+            EndInputOwnershipCommand(web_contents(), SessionA(), "cmd", false));
+
+  const InputOwnershipSnapshot snapshot = GetInputOwnershipSnapshot(
+      web_contents());
+  EXPECT_EQ(InputOwnershipMode::kAssist, snapshot.mode);
+  EXPECT_EQ(3u, snapshot.version);
+  EXPECT_FALSE(snapshot.stale);
+}
+
+// Feature off: the free functions never create a controller and report
+// FEATURE_DISABLED / a default fail-closed snapshot.
+TEST_F(InputOwnershipApiTest, FeatureOffFreeFunctionsAreInert) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitWithFeatureState(features::kInputOwnershipEnforcement,
+                                     false);
+  EXPECT_EQ(InputOwnershipWriteResult::kFeatureDisabled,
+            SetInputOwnership(web_contents(), InputOwnershipMode::kAi, 1)
+                .result);
+  EXPECT_EQ(InputOwnershipWriteResult::kFeatureDisabled,
+            HeartbeatInputOwnership(web_contents(), 1).result);
+  EXPECT_FALSE(GrantDebuggerInput(web_contents(), SessionA(), 1,
+                                  base::Seconds(1))
+                   .granted);
+  const InputOwnershipSnapshot snapshot = GetInputOwnershipSnapshot(
+      web_contents());
+  EXPECT_EQ(InputOwnershipMode::kAssist, snapshot.mode);
+  EXPECT_EQ(0u, snapshot.version);
+}
+
+// K13: the human presence callback fires (debounced) for human events and not
+// for debugger-injected ones.
+TEST_F(InputOwnershipApiTest, HumanPresenceCallbackFiresForHumanInputOnly) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  SetInputOwnership(web_contents(), InputOwnershipMode::kAi, 1);
+
+  int callbacks = 0;
+  InputOwnershipHumanPresenceKind last_kind =
+      InputOwnershipHumanPresenceKind::kOther;
+  SetInputOwnershipHumanPresenceCallback(base::BindRepeating(
+      [](int* callbacks, InputOwnershipHumanPresenceKind* last_kind,
+         WebContents* contents, InputOwnershipHumanPresenceKind kind,
+         base::TimeTicks at) {
+        ++*callbacks;
+        *last_kind = kind;
+        EXPECT_TRUE(contents);
+        EXPECT_FALSE(at.is_null());
+      },
+      &callbacks, &last_kind));
+
+  InputOwnershipController* controller =
+      static_cast<WebContentsImpl*>(web_contents())
+          ->GetInputOwnershipController();
+  ASSERT_TRUE(controller);
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  blink::WebMouseEvent human_mouse(Type::kMouseDown, kHumanModifiers, now);
+  EXPECT_FALSE(controller->ShouldDropEvent(human_mouse));  // paused, not dropped
+  EXPECT_EQ(1, callbacks);
+  EXPECT_EQ(InputOwnershipHumanPresenceKind::kMouse, last_kind);
+
+  // Debounced within 300ms.
+  EXPECT_FALSE(controller->ShouldDropEvent(human_mouse));
+  EXPECT_EQ(1, callbacks);
+
+  // A debugger event is not human presence.
+  blink::WebMouseEvent debugger_mouse(Type::kMouseDown, kDebuggerModifiers,
+                                      now);
+  controller->ShouldDropSessionEvent(SessionA(), debugger_mouse);
+  EXPECT_EQ(1, callbacks);
+
+  SetInputOwnershipHumanPresenceCallback(
+      InputOwnershipHumanPresenceCallback());
+}
