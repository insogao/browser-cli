+++ b/chrome/browser/extensions/api/browser_cli/browser_cli_extension_identity.h
@@ -0,0 +1,55 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_BROWSER_CLI_EXTENSION_IDENTITY_H_
+#define CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_BROWSER_CLI_EXTENSION_IDENTITY_H_
+
+#include <string>
+
+#include "extensions/common/extension_id.h"
+#include "extensions/common/mojom/manifest.mojom-forward.h"
+
+class ExtensionFunction;
+
+namespace extensions {
+
+class Extension;
+
+namespace browser_cli {
+
+// Browser CLI P3 trust boundary (design §2).
+//
+// Identity comes exclusively from Chromium's `ExtensionFunction` / `Extension`
+// objects; no request field (`extensionId`, `token`, `internal`, ...) is ever
+// consulted. The trusted automation extension is pinned by the hashes of its
+// extension id (which is itself derived from the manifest public key), so
+// replacing `manifest.key` changes the id and fails the check.
+
+// SHA-1/SHA-256 hashes of the trusted extension id. Exposed for unit tests.
+bool IsTrustedBrowserCliExtensionIdHash(const ExtensionId& extension_id);
+
+// Install locations the trusted extension may come from: the product install
+// paths (external prefs / external registry) and, in non-official builds only,
+// an unpacked or command-line loaded extension (developer / E2E harness).
+bool IsAllowedBrowserCliManifestLocation(
+    mojom::ManifestLocation location);
+
+// True when `extension` is the trusted automation extension, installed from an
+// allowed location, not in split-incognito mode, and the browser is in managed
+// mode. Does not look at the calling context (see the overload below).
+bool IsTrustedBrowserCliExtension(const Extension* extension);
+
+// Full per-call check. Returns false (and fills `error` when non-null) for:
+//  - non-extension callers (no `extension()`),
+//  - content script / web page contexts,
+//  - any extension id or install location outside the allowlist,
+//  - OTR / split-incognito profiles,
+//  - a browser that is not in managed mode.
+bool IsTrustedBrowserCliCaller(ExtensionFunction* function,
+                               std::string* error);
+
+}  // namespace browser_cli
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_BROWSER_CLI_EXTENSION_IDENTITY_H_
