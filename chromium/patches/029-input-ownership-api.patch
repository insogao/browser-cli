+  if (blink::WebInputEvent::IsMouseEventType(type) ||
+      type == blink::WebInputEvent::Type::kMouseWheel) {
+    return InputOwnershipHumanPresenceKind::kMouse;
+  }
+  if (blink::WebInputEvent::IsKeyboardEventType(type)) {
+    return InputOwnershipHumanPresenceKind::kKey;
+  }
+  if (blink::WebInputEvent::IsTouchEventType(type) ||
+      blink::WebInputEvent::IsGestureEventType(type)) {
+    return InputOwnershipHumanPresenceKind::kTouch;
+  }
+  return InputOwnershipHumanPresenceKind::kOther;
