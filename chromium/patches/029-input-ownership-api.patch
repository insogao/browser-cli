@@ -0,0 +1,845 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/browser_cli_input_ownership/browser_cli_input_ownership_api.h"
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/extensions/api/browser_cli/browser_cli_extension_identity.h"
+#include "chrome/browser/extensions/api/debugger/debugger_api_client_lookup.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/extensions/window_controller.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/extensions/api/browser_cli_input_ownership.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+#include "content/public/browser/input_ownership.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_event_histogram_value.h"
+#include "extensions/browser/extension_function.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/extension.h"
+
+namespace extensions {
+
+namespace {
+
+namespace api_io = api::browser_cli_input_ownership;
+
+// --- Result codes ----------------------------------------------------------
+
+constexpr char kInvalidTarget[] = "INVALID_TARGET";
+constexpr char kInvalidArgument[] = "INVALID_ARGUMENT";
+constexpr char kUnknownTarget[] = "UNKNOWN_TARGET";
+constexpr char kStaleVersion[] = "STALE_VERSION";
+constexpr char kVersionConflict[] = "VERSION_CONFLICT";
+constexpr char kVersionUnknown[] = "VERSION_UNKNOWN";
+constexpr char kNoDebuggerSession[] = "NO_DEBUGGER_SESSION";
+constexpr char kGrantRequired[] = "GRANT_REQUIRED";
+constexpr char kUnknownCommand[] = "UNKNOWN_COMMAND";
+
+std::string ToReason(content::InputOwnershipWriteResult result) {
+  using Result = content::InputOwnershipWriteResult;
+  switch (result) {
+    case Result::kAccepted:
+      return std::string();
+    case Result::kFeatureDisabled:
+      return std::string("FEATURE_DISABLED");
+    case Result::kInvalidArgument:
+      return kInvalidArgument;
+    case Result::kUnknownTarget:
+      return kUnknownTarget;
+    case Result::kStaleVersion:
+      return kStaleVersion;
+    case Result::kVersionConflict:
+      return kVersionConflict;
+    case Result::kVersionUnknown:
+      return kVersionUnknown;
+    case Result::kGrantRequired:
+      return kGrantRequired;
+    case Result::kUnknownCommand:
+      return kUnknownCommand;
+  }
+}
+
+api_io::Mode ToApiMode(content::InputOwnershipMode mode) {
+  switch (mode) {
+    case content::InputOwnershipMode::kAi:
+      return api_io::Mode::kAi;
+    case content::InputOwnershipMode::kAssist:
+      return api_io::Mode::kAssist;
+    case content::InputOwnershipMode::kHuman:
+      return api_io::Mode::kHuman;
+  }
+}
+
+content::InputOwnershipMode ToKernelMode(api_io::Mode mode) {
+  switch (mode) {
+    case api_io::Mode::kNone:
+      // Fail closed: an unspecified mode is never automation-owned.
+      return content::InputOwnershipMode::kAssist;
+    case api_io::Mode::kAi:
+      return content::InputOwnershipMode::kAi;
+    case api_io::Mode::kAssist:
+      return content::InputOwnershipMode::kAssist;
+    case api_io::Mode::kHuman:
+      return content::InputOwnershipMode::kHuman;
+  }
+}
+
+// Versions are exchanged as JSON integers. The generated C++ type is `int`, so
+// versions above INT_MAX are rejected instead of silently wrapping.
+constexpr int64_t kMaxVersion = 0x7fffffff;
+
+int64_t ToEpochMs(base::TimeTicks ticks) {
+  if (ticks.is_null()) {
+    return 0;
+  }
+  // Approximate wall-clock projection for diagnostics only. The authoritative
+  // deadline is always the monotonic one inside content.
+  const base::TimeDelta age = base::TimeTicks::Now() - ticks;
+  return (base::Time::Now() - age - base::Time::UnixEpoch()).InMilliseconds();
+}
+
+// --- Target resolution -----------------------------------------------------
+
+// True when `target` names exactly one of tabId/windowId.
+bool HasExactlyOneTarget(const api_io::Target& target) {
+  return target.tab_id.has_value() != target.window_id.has_value();
+}
+
+bool ResolveTab(content::BrowserContext* browser_context,
+                bool include_incognito,
+                const api_io::Target& target,
+                content::WebContents** web_contents,
+                std::string* reason) {
+  if (!target.tab_id.has_value() || target.window_id.has_value()) {
+    *reason = kInvalidTarget;
+    return false;
+  }
+  if (!ExtensionTabUtil::GetTabById(*target.tab_id, browser_context,
+                                   include_incognito, web_contents)) {
+    *reason = kUnknownTarget;
+    return false;
+  }
+  return true;
+}
+
+bool ResolveWindow(content::BrowserContext* browser_context,
+                   bool include_incognito,
+                   const api_io::Target& target,
+                   WindowController** window,
+                   std::string* reason) {
+  if (!target.window_id.has_value() || target.tab_id.has_value()) {
+    *reason = kInvalidTarget;
+    return false;
+  }
+  *window = ExtensionTabUtil::GetControllerInProfileWithId(
+      Profile::FromBrowserContext(browser_context), *target.window_id,
+      include_incognito, /*error_message=*/nullptr);
+  if (!*window) {
+    *reason = kUnknownTarget;
+    return false;
+  }
+  return true;
+}
+
+// --- Window snapshot ledger ------------------------------------------------
+//
+// The content controller is per WebContents. A window target is expanded into
+// its current tabs (and, at every heartbeat, into the tabs that exist by then).
+// The ledger below remembers the last accepted window snapshot so a tab created
+// after setOwnership() can be bound by the next heartbeat even if the observer
+// path is unavailable. It is a cache, never a second source of truth: content
+// per-tab state wins on every conflicting read.
+struct WindowRecord {
+  content::InputOwnershipMode mode = content::InputOwnershipMode::kAssist;
+  uint64_t version = 0;
+};
+
+using WindowKey = std::pair<content::BrowserContext*, int>;
+
+std::map<WindowKey, WindowRecord>& WindowRecords() {
+  static base::NoDestructor<std::map<WindowKey, WindowRecord>> records;
+  return *records;
+}
+
+// Keeps the ledger bounded if windows come and go without an explicit close
+// (window ids are recycled, so the entry is refreshed on every setOwnership).
+constexpr size_t kMaxWindowRecords = 256;
+
+void StoreWindowRecord(content::BrowserContext* context,
+                       int window_id,
+                       content::InputOwnershipMode mode,
+                       uint64_t version) {
+  auto& records = WindowRecords();
+  if (records.size() >= kMaxWindowRecords &&
+      !records.contains(WindowKey(context, window_id))) {
+    records.erase(records.begin());
+  }
+  records[WindowKey(context, window_id)] = WindowRecord{mode, version};
+}
+
+void EraseWindowRecord(content::BrowserContext* context, int window_id) {
+  WindowRecords().erase(WindowKey(context, window_id));
+}
+
+std::optional<WindowRecord> GetWindowRecord(content::BrowserContext* context,
+                                            int window_id) {
+  auto it = WindowRecords().find(WindowKey(context, window_id));
+  if (it == WindowRecords().end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+// --- Session resolution (K16) ----------------------------------------------
+
+struct ResolvedDebuggerSession {
+  raw_ptr<content::DevToolsAgentHostClient> client = nullptr;
+  content::InputOwnershipSessionToken token = nullptr;
+};
+
+// Resolves the calling extension's own chrome.debugger session on `web_contents`
+// and the DevTools session token the InputHandler will use for its events.
+// Anything the caller sends (`request.session`) is ignored on purpose: the
+// binding comes from the ExtensionDevToolsClientHost registry.
+//
+// The agent host must be the one held by the ExtensionDevToolsClientHost (the
+// host `chrome.debugger.attach` created), never
+// `DevToolsAgentHost::GetForTab`: the latter returns the tab-target host, a
+// different object whose session is not the one carrying the extension's CDP
+// commands, so `GetInputOwnershipSessionForClient` would find nothing.
+bool ResolveDebuggerSession(ExtensionFunction* function,
+                            content::WebContents* web_contents,
+                            ResolvedDebuggerSession* out,
+                            std::string* reason) {
+  const ExtensionDebuggerSession session = GetExtensionDebuggerSessionForTab(
+      function->browser_context(), function->extension()->id(), web_contents);
+  if (!session) {
+    *reason = kNoDebuggerSession;
+    return false;
+  }
+  const content::InputOwnershipSessionToken token =
+      session.agent_host->GetInputOwnershipSessionForClient(session.client);
+  if (!token) {
+    *reason = kNoDebuggerSession;
+    return false;
+  }
+  out->client = session.client;
+  out->token = token;
+  return true;
+}
+
+// --- Human presence event bridge (K13) -------------------------------------
+
+std::string PresenceKindToString(
+    content::InputOwnershipHumanPresenceKind kind) {
+  switch (kind) {
+    case content::InputOwnershipHumanPresenceKind::kMouse:
+      return "mouse";
+    case content::InputOwnershipHumanPresenceKind::kWheel:
+      return "wheel";
+    case content::InputOwnershipHumanPresenceKind::kKey:
+      return "key";
+    case content::InputOwnershipHumanPresenceKind::kText:
+      return "text";
+    case content::InputOwnershipHumanPresenceKind::kTouch:
+      return "touch";
+    case content::InputOwnershipHumanPresenceKind::kOther:
+      return "other";
+  }
+}
+
+// Dispatches `browserCliInputOwnership.onHumanPresence` to every trusted
+// Browser CLI extension installed in the WebContents' profile. It never
+// broadcasts to other extensions.
+void DispatchHumanPresence(content::WebContents* web_contents,
+                           content::InputOwnershipHumanPresenceKind kind,
+                           base::TimeTicks at) {
+  if (!web_contents) {
+    return;
+  }
+  content::BrowserContext* browser_context =
+      web_contents->GetBrowserContext();
+  if (!browser_context || browser_context->IsOffTheRecord()) {
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  if (!profile) {
+    return;
+  }
+  EventRouter* event_router = EventRouter::Get(profile);
+  if (!event_router) {
+    return;
+  }
+
+  const int tab_id = ExtensionTabUtil::GetTabId(web_contents);
+  const int window_id = ExtensionTabUtil::GetWindowIdOfTab(web_contents);
+  const std::string kind_string = PresenceKindToString(kind);
+  const double at_ms = static_cast<double>(
+      at.is_null() ? (base::Time::Now() - base::Time::UnixEpoch()).InMilliseconds()
+                   : ToEpochMs(at));
+
+  for (const auto& extension :
+       ExtensionRegistry::Get(profile)->enabled_extensions()) {
+    if (!browser_cli::IsTrustedBrowserCliExtension(extension.get())) {
+      continue;
+    }
+    base::DictValue event_args;
+    event_args.Set("tabId", tab_id);
+    if (window_id != extension_misc::kUnknownWindowId) {
+      event_args.Set("windowId", window_id);
+    }
+    event_args.Set("kind", kind_string);
+    event_args.Set("at", at_ms);
+    base::ListValue args;
+    args.Append(std::move(event_args));
+    auto event = std::make_unique<Event>(
+        events::BROWSERCLI_INPUT_OWNERSHIP_ON_HUMAN_PRESENCE,
+        api_io::OnHumanPresence::kEventName, std::move(args), profile);
+    event_router->DispatchEventToExtension(extension->id(), std::move(event));
+  }
+}
+
+void EnsureHumanPresenceBridgeRegistered() {
+  static bool registered = false;
+  if (registered) {
+    return;
+  }
+  registered = true;
+  content::SetInputOwnershipHumanPresenceCallback(
+      base::BindRepeating(&DispatchHumanPresence));
+}
+
+// --- Common request plumbing ----------------------------------------------
+
+// Runs the trust check for `function`; returns true and registers the presence
+// bridge on success.
+bool PrepareCall(ExtensionFunction* function, std::string* error) {
+  if (!browser_cli::IsTrustedBrowserCliCaller(function, error)) {
+    return false;
+  }
+  EnsureHumanPresenceBridgeRegistered();
+  return true;
+}
