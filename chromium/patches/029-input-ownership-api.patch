+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_DEBUGGER_DEBUGGER_API_CLIENT_LOOKUP_H_
+#define CHROME_BROWSER_EXTENSIONS_API_DEBUGGER_DEBUGGER_API_CLIENT_LOOKUP_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "extensions/common/extension_id.h"
+
+namespace content {
+class BrowserContext;
+class DevToolsAgentHostClient;
+class WebContents;
+}  // namespace content
+
+namespace extensions {
+
+// Browser CLI (patch 029): the chrome.debugger session of one extension on one
+// tab. `agent_host` is the exact DevToolsAgentHost the extension attached to
+// (a `WebContents`/frame-tree host, NOT the tab-target host returned by
+// `DevToolsAgentHost::GetForTab`), and `client` is the
+// `ExtensionDevToolsClientHost` registered as its client. Passing this pair to
+// `DevToolsAgentHost::GetInputOwnershipSessionForClient()` yields the same
+// `DevToolsSession*` that the extension's CDP commands reach, which is what the
+// input ownership grant has to be keyed by.
+struct ExtensionDebuggerSession {
+  scoped_refptr<content::DevToolsAgentHost> agent_host;
+  raw_ptr<content::DevToolsAgentHostClient> client = nullptr;
+
+  explicit operator bool() const { return agent_host && client; }
+};
+
+// Resolves the chrome.debugger session created by `extension_id` for
+// `web_contents`, or an empty result when the extension is not attached.
+//
+// Identity comes exclusively from the ExtensionDevToolsClientHost registry
+// (extension object + agent host); no caller-supplied id or session token is
+// consulted.
+ExtensionDebuggerSession GetExtensionDebuggerSessionForTab(
+    content::BrowserContext* browser_context,
+    const ExtensionId& extension_id,
+    content::WebContents* web_contents);
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_DEBUGGER_DEBUGGER_API_CLIENT_LOOKUP_H_
