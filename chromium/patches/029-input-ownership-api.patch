+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Trusted production entry points for input ownership arbitration (Browser CLI
+// K12). The chrome extension API layer is the only caller; it has already
+// authenticated the extension (id hash allowlist + context + location +
+// managed mode) before it reaches these functions. Content therefore performs
+// no extension identity checks here; it only resolves the per-WebContents
+// controller and fails closed when the feature is off or the tab is gone.
+
+#include "content/public/browser/input_ownership.h"
+
+#include "base/feature_list.h"
+#include "content/browser/input_ownership/input_ownership_controller.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/common/content_features.h"
+
+namespace content {
+
+namespace {
+
+InputOwnershipController* GetController(WebContents* web_contents) {
+  if (!web_contents) {
+    return nullptr;
+  }
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return nullptr;
+  }
+  // Every browser-process WebContents is a WebContentsImpl. The controller is
+  // only created while the feature is on (WebContentsImpl gate), so the second
+  // feature check above is belt-and-braces.
+  return static_cast<WebContentsImpl*>(web_contents)
+      ->GetInputOwnershipController();
+}
+
+InputOwnershipApplyResult UnknownTarget() {
+  InputOwnershipApplyResult result;
+  result.result = InputOwnershipWriteResult::kUnknownTarget;
+  result.snapshot = InputOwnershipSnapshot();
+  return result;
+}
+
+InputOwnershipWriteResult FeatureDisabledOrUnknownTarget(
+    WebContents* web_contents) {
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return InputOwnershipWriteResult::kFeatureDisabled;
+  }
+  return InputOwnershipWriteResult::kUnknownTarget;
+}
+
+}  // namespace
+
+InputOwnershipApplyResult SetInputOwnership(WebContents* web_contents,
+                                            InputOwnershipMode mode,
+                                            uint64_t version) {
+  InputOwnershipController* controller = GetController(web_contents);
+  if (!controller) {
+    if (base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+      return UnknownTarget();
+    }
+    InputOwnershipApplyResult result;
+    result.result = InputOwnershipWriteResult::kFeatureDisabled;
+    return result;
+  }
+  return controller->SetOwnership(mode, version);
+}
+
+InputOwnershipApplyResult HeartbeatInputOwnership(WebContents* web_contents,
+                                                  uint64_t version) {
+  InputOwnershipController* controller = GetController(web_contents);
+  if (!controller) {
+    if (base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+      return UnknownTarget();
+    }
+    InputOwnershipApplyResult result;
+    result.result = InputOwnershipWriteResult::kFeatureDisabled;
+    return result;
+  }
+  return controller->Heartbeat(version);
+}
+
+InputOwnershipGrantInfo GrantDebuggerInput(
+    WebContents* web_contents,
+    InputOwnershipSessionToken session,
+    int actions,
+    base::TimeDelta ttl) {
+  InputOwnershipController* controller = GetController(web_contents);
+  if (!controller) {
+    return InputOwnershipGrantInfo();
+  }
+  return controller->GrantSessionInput(session, actions, ttl);
+}
+
+InputOwnershipCommandScope BeginInputOwnershipCommand(
+    WebContents* web_contents,
+    InputOwnershipSessionToken session,
+    const std::string& command_id,
+    base::TimeDelta max_duration) {
+  InputOwnershipController* controller = GetController(web_contents);
+  if (!controller) {
+    InputOwnershipCommandScope scope;
+    scope.result = FeatureDisabledOrUnknownTarget(web_contents);
+    return scope;
+  }
+  return controller->BeginSessionCommand(session, command_id, max_duration);
+}
+
+InputOwnershipWriteResult EndInputOwnershipCommand(
+    WebContents* web_contents,
+    InputOwnershipSessionToken session,
+    const std::string& command_id,
+    bool cancelled) {
+  InputOwnershipController* controller = GetController(web_contents);
+  if (!controller) {
+    return FeatureDisabledOrUnknownTarget(web_contents);
+  }
+  return controller->EndSessionCommand(session, command_id, cancelled);
+}
+
+InputOwnershipSnapshot GetInputOwnershipSnapshot(WebContents* web_contents) {
+  InputOwnershipController* controller = GetController(web_contents);
+  if (!controller) {
+    return InputOwnershipSnapshot();
+  }
+  return controller->SnapshotNow();
+}
+
+}  // namespace content
