+// ---------------------------------------------------------------------------
+
+BrowserCliInputOwnershipBeginInputCommandFunction::BrowserCliInputOwnershipBeginInputCommandFunction() =
+    default;
+
+BrowserCliInputOwnershipBeginInputCommandFunction::
+    ~BrowserCliInputOwnershipBeginInputCommandFunction() = default;
+
+ExtensionFunction::ResponseAction
+BrowserCliInputOwnershipBeginInputCommandFunction::Run() {
+  std::string trust_error;
+  if (!PrepareCall(this, &trust_error)) {
+    return RespondNow(Error(trust_error));
+  }
+  auto params = api_io::BeginInputCommand::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+  const api_io::Target& target = params->request.target;
+  if (!target.tab_id.has_value() || target.window_id.has_value()) {
+    return RespondNow(Error(kInvalidTarget));
+  }
+  if (params->request.command_id.empty()) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+
+  api_io::CommandScopeResult result;
+  result.ok = false;
+
+  content::WebContents* web_contents = nullptr;
+  std::string reason;
+  if (!ResolveTab(browser_context(), include_incognito_information(), target,
+                  &web_contents, &reason)) {
+    result.reason = reason;
+    return RespondNow(
+        ArgumentList(api_io::BeginInputCommand::Results::Create(result)));
+  }
+
+  ResolvedDebuggerSession session;
+  if (!ResolveDebuggerSession(this, web_contents, &session, &reason)) {
+    result.reason = reason;
+    return RespondNow(
+        ArgumentList(api_io::BeginInputCommand::Results::Create(result)));
+  }
+
+  // The scope duration is decided by the kernel (kind-specific TTL on the
+  // extension side, capped here); the request carries no duration.
+  const content::InputOwnershipCommandScope scope =
+      content::BeginInputOwnershipCommand(web_contents, session.token,
+                                          params->request.command_id,
+                                          base::Minutes(2));
+  result.ok = scope.ok();
+  if (scope.ok()) {
+    if (!scope.scope_id.empty()) {
+      result.scope_id = scope.scope_id;
+    }
+    result.deadline = static_cast<double>(ToEpochMs(scope.deadline));
+    result.grant_remaining = scope.grant_remaining;
+  } else {
+    result.reason = ToReason(scope.result);
+  }
+  return RespondNow(
+      ArgumentList(api_io::BeginInputCommand::Results::Create(result)));
+}
+
+// ---------------------------------------------------------------------------
+// endInputCommand
+// ---------------------------------------------------------------------------
+
+BrowserCliInputOwnershipEndInputCommandFunction::BrowserCliInputOwnershipEndInputCommandFunction() =
+    default;
+
+BrowserCliInputOwnershipEndInputCommandFunction::
+    ~BrowserCliInputOwnershipEndInputCommandFunction() = default;
+
+ExtensionFunction::ResponseAction
+BrowserCliInputOwnershipEndInputCommandFunction::Run() {
+  std::string trust_error;
+  if (!PrepareCall(this, &trust_error)) {
+    return RespondNow(Error(trust_error));
+  }
+  auto params = api_io::EndInputCommand::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+  const api_io::Target& target = params->request.target;
+  if (!target.tab_id.has_value() || target.window_id.has_value()) {
+    return RespondNow(Error(kInvalidTarget));
+  }
+  if (params->request.command_id.empty()) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+
+  api_io::EndCommandResult result;
+  result.closed = false;
+
+  content::WebContents* web_contents = nullptr;
+  std::string reason;
+  if (!ResolveTab(browser_context(), include_incognito_information(), target,
+                  &web_contents, &reason)) {
+    result.reason = reason;
+    return RespondNow(
+        ArgumentList(api_io::EndInputCommand::Results::Create(result)));
+  }
+
+  ResolvedDebuggerSession session;
+  if (!ResolveDebuggerSession(this, web_contents, &session, &reason)) {
+    // A detached session cannot own a live scope; report it as an unknown
+    // command instead of failing the whole command result.
+    result.reason = kUnknownCommand;
+    return RespondNow(
+        ArgumentList(api_io::EndInputCommand::Results::Create(result)));
+  }
+
+  const bool cancelled =
+      params->request.outcome == api_io::CommandOutcome::kCancelled;
+  const content::InputOwnershipWriteResult end = content::EndInputOwnershipCommand(
+      web_contents, session.token, params->request.command_id, cancelled);
+  result.closed = end == content::InputOwnershipWriteResult::kAccepted;
+  if (!result.closed) {
+    result.reason = ToReason(end);
+  }
+  return RespondNow(
+      ArgumentList(api_io::EndInputCommand::Results::Create(result)));
+}
