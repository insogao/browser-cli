@@ -0,0 +1,48 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/browser_cli/browser_cli_extension_identity.h"
+
+#include "extensions/common/mojom/manifest.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace extensions::browser_cli {
+
+TEST(BrowserCliExtensionIdentityTest, TrustedIdIsPinnedBySha256Hash) {
+  // The Browser CLI automation extension (manifest "key").
+  EXPECT_TRUE(
+      IsTrustedBrowserCliExtensionIdHash("nnollghpaggbcdkkgoieneffnlijinio"));
+  // Any other id (including a one-character near miss) is rejected.
+  EXPECT_FALSE(
+      IsTrustedBrowserCliExtensionIdHash("nnollghpaggbcdkkgoienneffnlijinio"));
+  EXPECT_FALSE(IsTrustedBrowserCliExtensionIdHash("abcdefghijklmnop"));
+  EXPECT_FALSE(IsTrustedBrowserCliExtensionIdHash(""));
+}
+
+TEST(BrowserCliExtensionIdentityTest, InstallLocationAllowlist) {
+  EXPECT_TRUE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kExternalPref));
+  EXPECT_TRUE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kExternalRegistry));
+  // Everything else fails closed by default.
+  EXPECT_FALSE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kComponent));
+  EXPECT_FALSE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kExternalComponent));
+  EXPECT_FALSE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kInternal));
+  EXPECT_FALSE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kExternalPolicy));
+  EXPECT_FALSE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kInvalidLocation));
+#if !defined(OFFICIAL_BUILD)
+  // Developer / E2E installs are allowed in non-official builds only.
+  EXPECT_TRUE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kUnpacked));
+  EXPECT_TRUE(IsAllowedBrowserCliManifestLocation(
+      mojom::ManifestLocation::kCommandLine));
+#endif
+}
+
+}  // namespace extensions::browser_cli
