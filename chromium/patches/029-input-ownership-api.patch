+void InputOwnershipDecider::Refresh(base::TimeTicks now) {
+  if (last_update_.is_null()) {
+    // Never refreshed: the target is already in the fail-closed kAssist mode,
+    // there is nothing to degrade.
+    stale_ = false;
+    return;
+  }
+  const bool stale = now - last_update_ > kOwnershipStaleAfter;
+  if (stale && !stale_) {
+    // Entering the stale state drops every grant, scope and the automation
+    // window exactly once (design §3.2/§3.3). `mode_`/`version_` are kept.
+    ClearDebuggerSessions();
+    ClearAutomationEventWindow();
+  }
+  stale_ = stale;
+}
+
+bool InputOwnershipDecider::IsStale(base::TimeTicks now) const {
+  if (last_update_.is_null()) {
+    return false;
+  }
+  return now - last_update_ > kOwnershipStaleAfter;
+}
