+#ifndef CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_INPUT_OWNERSHIP_BROWSER_CLI_INPUT_OWNERSHIP_API_H_
+#define CHROME_BROWSER_EXTENSIONS_API_BROWSER_CLI_INPUT_OWNERSHIP_BROWSER_CLI_INPUT_OWNERSHIP_API_H_
+
+#include "extensions/browser/extension_function.h"
+#include "extensions/browser/extension_function_histogram_value.h"
+
+namespace extensions {
+
+// chrome.browserCliInputOwnership.* (Browser CLI P3, kernel side).
+//
+// Every function below performs the same trust check first
+// (`IsTrustedBrowserCliCaller`): the caller must be the allowlisted automation
+// extension, in a privileged extension context, on a non-OTR profile, while the
+// browser runs in managed mode. The namespace itself is only available when
+// `InputOwnershipEnforcement` is enabled (see the delegated availability check
+// in `browser_cli_input_ownership_availability.cc`), so a stock Chrome never
+// sees it.
+//
+// The extension is the single source of truth for ownership; these functions
+// only mirror its decisions into the content arbitration state.
+
+class BrowserCliInputOwnershipSetOwnershipFunction : public ExtensionFunction {
