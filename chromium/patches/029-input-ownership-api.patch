diff --git a/chrome/common/extensions/api/browser_cli_input_ownership.json b/chrome/common/extensions/api/browser_cli_input_ownership.json
new file mode 100644
index 0000000..89e3f8e
--- /dev/null
+++ b/chrome/common/extensions/api/browser_cli_input_ownership.json
@@ -0,0 +1,311 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Browser CLI input ownership API (P3, kernel side).
+//
+// This namespace is the production write path into the content-layer input
+// ownership arbitration. It exists only in a Browser CLI build with
+// `--enable-features=InputOwnershipEnforcement` and is additionally restricted
+// to the trusted automation extension (id hash allowlist, privileged extension
+// context, non-OTR profile and managed-mode runtime check), see
+// `_api_features.json` and `browser_cli_extension_identity.cc`.
+//
+// The extension remains the single source of truth for ownership: the kernel
+// stores a per-target `mode` + monotonic `version` snapshot, degrades to
+// kAssist after 30s without a heartbeat (without rewriting the configured
+// mode), and only delivers ASSIST input inside a session-bound grant.
+[
+  {
+    "namespace": "browserCliInputOwnership",
+    "description": "none",
+    "types": [
+      {
+        "id": "Mode",
+        "type": "string",
+        "enum": ["ai", "assist", "human"],
+        "description": "Ownership mode for one target. \"ai\" lets automation input through, \"assist\" requires a human-granted budget and \"human\" drops automation input entirely."
+      },
+      {
+        "id": "CommandOutcome",
+        "type": "string",
+        "enum": ["ok", "failed", "cancelled"],
+        "description": "How an automation command finished. Cancelling a scope that authorized no input refunds its reserved grant unit."
+      },
+      {
+        "id": "Target",
+        "type": "object",
+        "description": "The target of an ownership operation. Exactly one of tabId or windowId must be set. A window target expands to the window's current tabs and to tabs created later.",
+        "properties": {
+          "tabId": {
+            "type": "integer",
+            "optional": true,
+            "description": "Exact tab target. Required for grantInput, beginInputCommand and endInputCommand."
+          },
+          "windowId": {
+            "type": "integer",
+            "optional": true,
+            "description": "Browser window target. Accepted by setOwnership, heartbeat and getOwnership only."
+          }
+        }
+      },
+      {
+        "id": "SetOwnershipResult",
+        "type": "object",
+        "description": "Answer to setOwnership. On a rejection `mode`/`version` describe the kernel's current truth so the caller can adopt it.",
+        "properties": {
+          "accepted": {"type": "boolean"},
+          "mode": {"$ref": "Mode"},
+          "version": {"type": "integer"},
+          "reason": {
+            "type": "string",
+            "optional": true,
+            "description": "Stable machine code: INVALID_TARGET, INVALID_ARGUMENT, UNKNOWN_TARGET, STALE_VERSION, VERSION_CONFLICT."
+          }
+        }
+      },
+      {
+        "id": "GrantResult",
+        "type": "object",
+        "description": "Answer to grantInput.",
+        "properties": {
+          "granted": {"type": "boolean"},
+          "actions": {"type": "integer", "optional": true},
+          "expiresAt": {
+            "type": "number",
+            "optional": true,
+            "description": "Absolute deadline in milliseconds since the epoch. Never extended by input."
+          },
+          "sessionToken": {
+            "type": "string",
+            "optional": true,
+            "description": "Opaque diagnostic token of the resolved debugger session. Never an authorization input."
+          },
+          "reason": {
+            "type": "string",
+            "optional": true,
+            "description": "Stable machine code: NO_DEBUGGER_SESSION, SESSION_MISMATCH, INVALID_TARGET, INVALID_ARGUMENT."
+          }
+        }
+      },
+      {
+        "id": "CommandScopeResult",
+        "type": "object",
+        "description": "Answer to beginInputCommand.",
+        "properties": {
+          "ok": {"type": "boolean"},
+          "scopeId": {"type": "string", "optional": true},
+          "deadline": {
+            "type": "number",
+            "optional": true,
+            "description": "Absolute scope deadline in milliseconds since the epoch, capped by the grant deadline."
+          },
+          "grantRemaining": {"type": "integer", "optional": true},
+          "reason": {
+            "type": "string",
+            "optional": true,
+            "description": "Stable machine code: GRANT_REQUIRED, INVALID_TARGET, INVALID_ARGUMENT, SESSION_MISMATCH."
+          }
+        }
+      },
+      {
+        "id": "EndCommandResult",
+        "type": "object",
+        "description": "Answer to endInputCommand.",
+        "properties": {
+          "closed": {"type": "boolean"},
+          "reason": {
+            "type": "string",
+            "optional": true,
+            "description": "Stable machine code: UNKNOWN_COMMAND, INVALID_ARGUMENT."
+          }
+        }
+      },
+      {
+        "id": "HeartbeatResult",
+        "type": "object",
+        "description": "Answer to heartbeat.",
+        "properties": {
+          "ok": {"type": "boolean"},
+          "mode": {"$ref": "Mode"},
+          "version": {"type": "integer"},
+          "stale": {"type": "boolean"},
+          "grantRemaining": {"type": "integer", "optional": true},
+          "grantExpiresAt": {"type": "integer", "optional": true},
+          "reason": {
+            "type": "string",
+            "optional": true,
+            "description": "Stable machine code: STALE_VERSION, VERSION_UNKNOWN, UNKNOWN_TARGET, INVALID_TARGET."
+          }
+        }
+      },
+      {
+        "id": "Snapshot",
+        "type": "object",
+        "description": "Read-only kernel view of one target.",
+        "properties": {
+          "mode": {"$ref": "Mode"},
+          "version": {"type": "integer"},
+          "stale": {
+            "type": "boolean",
+            "description": "True when no accepted update arrived for 30s. The effective mode is then assist; the configured mode is kept."
+          },
+          "lastUpdateAt": {
+            "type": "number",
+            "optional": true,
+            "description": "Milliseconds since the epoch of the last accepted setOwnership/heartbeat (approximate; diagnostics only)."
+          },
+          "grantRemaining": {"type": "integer", "optional": true},
+          "grantExpiresAt": {"type": "integer", "optional": true},
+          "reason": {"type": "string", "optional": true}
+        }
+      },
+      {
+        "id": "HumanPresenceEvent",
+        "type": "object",
+        "description": "A human input event was observed on a tab. It never changes the mode by itself.",
+        "properties": {
+          "tabId": {"type": "integer", "optional": true},
+          "windowId": {"type": "integer", "optional": true},
+          "kind": {
+            "type": "string",
+            "description": "mouse, wheel, key, text, touch or other."
+          },
+          "at": {"type": "number", "description": "Milliseconds since the epoch."}
+        }
+      }
+    ],
+    "functions": [
+      {
+        "name": "setOwnership",
+        "type": "function",
+        "description": "Writes the configured mode for a target with a monotonically increasing version.",
+        "parameters": [
+          {
+            "name": "request",
+            "type": "object",
+            "properties": {
+              "target": {"$ref": "Target"},
+              "mode": {"$ref": "Mode"},
+              "version": {"type": "integer", "minimum": 1}
+            }
+          }
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "result", "$ref": "SetOwnershipResult"}]
+        }
+      },
+      {
+        "name": "heartbeat",
+        "type": "function",
+        "description": "Refreshes the liveness deadline of a target without changing its mode or version.",
+        "parameters": [
+          {
+            "name": "request",
+            "type": "object",
+            "properties": {
+              "target": {"$ref": "Target"},
+              "version": {"type": "integer", "minimum": 1}
+            }
+          }
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "result", "$ref": "HeartbeatResult"}]
+        }
+      },
+      {
+        "name": "getOwnership",
+        "type": "function",
+        "description": "Returns the kernel's current view of a target without changing any state.",
+        "parameters": [
+          {
+            "name": "request",
+            "type": "object",
+            "properties": {"target": {"$ref": "Target"}}
+          }
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "result", "$ref": "Snapshot"}]
+        }
+      },
+      {
+        "name": "grantInput",
+        "type": "function",
+        "description": "Issues an ASSIST input budget bound to the caller's own chrome.debugger session on the target tab.",
+        "parameters": [
+          {
+            "name": "request",
+            "type": "object",
+            "properties": {
+              "target": {"$ref": "Target"},
+              "actions": {"type": "integer", "minimum": 1},
+              "ttlMs": {"type": "integer", "minimum": 1},
+              "session": {
+                "type": "string",
+                "optional": true,
+                "description": "Opaque diagnostic token. Authorization always comes from the caller's own debugger session."
+              }
+            }
+          }
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "result", "$ref": "GrantResult"}]
+        }
+      },
+      {
+        "name": "beginInputCommand",
+        "type": "function",
+        "description": "Opens a command scope that bills one grant unit and authorizes every input event of the session until the deadline.",
+        "parameters": [
+          {
+            "name": "request",
+            "type": "object",
+            "properties": {
+              "target": {"$ref": "Target"},
+              "commandId": {"type": "string"},
+              "kind": {"type": "string"},
+              "session": {"type": "string", "optional": true}
+            }
+          }
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "result", "$ref": "CommandScopeResult"}]
+        }
+      },
+      {
+        "name": "endInputCommand",
+        "type": "function",
+        "description": "Closes a command scope. Cancelling a scope that authorized no input refunds its unit.",
+        "parameters": [
+          {
+            "name": "request",
+            "type": "object",
+            "properties": {
+              "target": {"$ref": "Target"},
+              "commandId": {"type": "string"},
+              "outcome": {"$ref": "CommandOutcome", "optional": true},
+              "session": {"type": "string", "optional": true}
+            }
+          }
+        ],
+        "returns_async": {
+          "name": "callback",
+          "parameters": [{"name": "result", "$ref": "EndCommandResult"}]
+        }
+      }
+    ],
+    "events": [
+      {
+        "name": "onHumanPresence",
+        "type": "function",
+        "description": "Fired (debounced to at most one event per 300ms) when human input is observed on a tab. Only delivered to the trusted extension.",
