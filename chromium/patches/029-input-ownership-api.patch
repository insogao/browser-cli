+// ---------------------------------------------------------------------------
+// setOwnership
+// ---------------------------------------------------------------------------
+
+BrowserCliInputOwnershipSetOwnershipFunction::BrowserCliInputOwnershipSetOwnershipFunction() =
+    default;
+
+BrowserCliInputOwnershipSetOwnershipFunction::
+    ~BrowserCliInputOwnershipSetOwnershipFunction() = default;
+
+ExtensionFunction::ResponseAction
+BrowserCliInputOwnershipSetOwnershipFunction::Run() {
+  std::string trust_error;
+  if (!PrepareCall(this, &trust_error)) {
+    return RespondNow(Error(trust_error));
+  }
+  auto params = api_io::SetOwnership::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+  const api_io::Target& target = params->request.target;
+  if (!HasExactlyOneTarget(target)) {
+    return RespondNow(Error(kInvalidTarget));
+  }
+  const int64_t version = params->request.version;
+  if (version <= 0 || version > kMaxVersion) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+  const content::InputOwnershipMode mode =
+      ToKernelMode(params->request.mode);
+
+  api_io::SetOwnershipResult result;
+  result.mode = ToApiMode(mode);
+  result.version = static_cast<int>(version);
+
+  if (target.tab_id.has_value()) {
+    content::WebContents* web_contents = nullptr;
+    std::string reason;
+    if (!ResolveTab(browser_context(), include_incognito_information(), target,
+                    &web_contents, &reason)) {
+      result.accepted = false;
+      result.reason = reason;
+      return RespondNow(
+          ArgumentList(api_io::SetOwnership::Results::Create(result)));
+    }
+    const content::InputOwnershipApplyResult apply =
+        content::SetInputOwnership(web_contents, mode,
+                                   static_cast<uint64_t>(version));
+    result.accepted =
+        apply.result == content::InputOwnershipWriteResult::kAccepted;
+    result.mode = ToApiMode(apply.snapshot.mode);
+    result.version = static_cast<int>(apply.snapshot.version);
+    if (!result.accepted) {
+      result.reason = ToReason(apply.result);
+    }
+    return RespondNow(
+        ArgumentList(api_io::SetOwnership::Results::Create(result)));
+  }
+
+  WindowController* window = nullptr;
+  std::string reason;
+  if (!ResolveWindow(browser_context(), include_incognito_information(),
+                     target, &window, &reason)) {
+    result.accepted = false;
+    result.reason = reason;
+    return RespondNow(
+        ArgumentList(api_io::SetOwnership::Results::Create(result)));
+  }
+
+  // Apply to every current tab. A rejection caused by a higher kernel version
+  // is reported back so the extension can adopt it; tabs that already accepted
+  // are idempotent on replay.
+  bool accepted = true;
+  content::InputOwnershipSnapshot highest;
+  for (int i = 0; i < window->GetTabCount(); ++i) {
+    content::WebContents* web_contents = window->GetWebContentsAt(i);
+    if (!web_contents) {
+      continue;
+    }
+    const content::InputOwnershipApplyResult apply =
+        content::SetInputOwnership(web_contents, mode,
+                                   static_cast<uint64_t>(version));
+    if (apply.snapshot.version > highest.version) {
+      highest = apply.snapshot;
+    }
+    if (apply.result != content::InputOwnershipWriteResult::kAccepted) {
+      accepted = false;
+      result.reason = ToReason(apply.result);
+      result.mode = ToApiMode(apply.snapshot.mode);
+      result.version = static_cast<int>(apply.snapshot.version);
+    }
+  }
+
+  result.accepted = accepted;
+  if (accepted) {
+    StoreWindowRecord(browser_context(), *target.window_id, mode,
+                      static_cast<uint64_t>(version));
+    result.mode = ToApiMode(mode);
+    result.version = static_cast<int>(version);
+  }
+  return RespondNow(ArgumentList(api_io::SetOwnership::Results::Create(result)));
+}
+
+// ---------------------------------------------------------------------------
+// heartbeat
+// ---------------------------------------------------------------------------
+
+BrowserCliInputOwnershipHeartbeatFunction::BrowserCliInputOwnershipHeartbeatFunction() =
+    default;
+
+BrowserCliInputOwnershipHeartbeatFunction::
+    ~BrowserCliInputOwnershipHeartbeatFunction() = default;
+
+ExtensionFunction::ResponseAction
+BrowserCliInputOwnershipHeartbeatFunction::Run() {
+  std::string trust_error;
+  if (!PrepareCall(this, &trust_error)) {
+    return RespondNow(Error(trust_error));
+  }
+  auto params = api_io::Heartbeat::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+  const api_io::Target& target = params->request.target;
+  if (!HasExactlyOneTarget(target)) {
+    return RespondNow(Error(kInvalidTarget));
+  }
+  const int64_t version = params->request.version;
+  if (version <= 0 || version > kMaxVersion) {
+    return RespondNow(Error(kInvalidArgument));
+  }
+
+  api_io::HeartbeatResult result;
+  result.ok = false;
+  result.mode = api_io::Mode::kAssist;
+  result.version = 0;
+  result.stale = true;
+
+  auto finish = [this, &result]() {
+    return RespondNow(ArgumentList(api_io::Heartbeat::Results::Create(result)));
+  };
+
+  if (target.tab_id.has_value()) {
+    content::WebContents* web_contents = nullptr;
+    std::string reason;
+    if (!ResolveTab(browser_context(), include_incognito_information(), target,
+                    &web_contents, &reason)) {
+      result.reason = reason;
+      return finish();
+    }
+    const content::InputOwnershipApplyResult apply =
+        content::HeartbeatInputOwnership(web_contents,
+                                         static_cast<uint64_t>(version));
+    result.ok =
+        apply.result == content::InputOwnershipWriteResult::kAccepted;
+    result.mode = ToApiMode(apply.snapshot.mode);
+    result.version = static_cast<int>(apply.snapshot.version);
+    result.stale = apply.snapshot.stale;
+    if (!result.ok) {
+      result.reason = ToReason(apply.result);
+    }
+    return finish();
+  }
+
+  WindowController* window = nullptr;
+  std::string reason;
+  if (!ResolveWindow(browser_context(), include_incognito_information(),
+                     target, &window, &reason)) {
+    EraseWindowRecord(browser_context(), *target.window_id);
+    result.reason = reason;
+    return finish();
+  }
+
+  const std::optional<WindowRecord> record =
+      GetWindowRecord(browser_context(), *target.window_id);
+  bool ok = true;
+  content::InputOwnershipSnapshot highest;
+  bool any_tab = false;
+  for (int i = 0; i < window->GetTabCount(); ++i) {
+    content::WebContents* web_contents = window->GetWebContentsAt(i);
+    if (!web_contents) {
+      continue;
+    }
+    any_tab = true;
+    content::InputOwnershipApplyResult apply;
+    const content::InputOwnershipSnapshot before =
+        content::GetInputOwnershipSnapshot(web_contents);
+    if (record) {
+      if (before.version == 0) {
+        // A tab created after setOwnership(): bind it to the window snapshot.
+        apply = content::SetInputOwnership(web_contents, record->mode,
+                                           record->version);
+      } else if (before.version == record->version) {
+        apply = content::HeartbeatInputOwnership(
+            web_contents, static_cast<uint64_t>(version));
+      } else {
+        // A tab-level state that does not match the window snapshot: it was
+        // set through an exact tabId target (which has priority over the
+        // window) or by another window owner. Leave it untouched and do not
+        // fail the window heartbeat.
+        if (before.version > highest.version) {
+          highest = before;
+        }
+        continue;
+      }
+    } else {
+      apply = content::HeartbeatInputOwnership(web_contents,
+                                               static_cast<uint64_t>(version));
+    }
+    if (apply.snapshot.version > highest.version) {
+      highest = apply.snapshot;
+    }
+    if (apply.result != content::InputOwnershipWriteResult::kAccepted) {
+      ok = false;
+      result.reason = ToReason(apply.result);
+    }
+  }
+  if (!any_tab) {
+    EraseWindowRecord(browser_context(), *target.window_id);
+    result.reason = kUnknownTarget;
+    return finish();
+  }
+
+  result.ok = ok;
+  result.mode = ToApiMode(highest.mode);
+  result.version = static_cast<int>(highest.version);
+  result.stale = highest.stale;
+  if (ok) {
+    result.reason = std::nullopt;
+  }
+  return finish();
+}
