diff --git a/chrome/browser/extensions/api/browser_cli/browser_cli_extension_identity.cc b/chrome/browser/extensions/api/browser_cli/browser_cli_extension_identity.cc
new file mode 100644
index 0000000..9394d1c
--- /dev/null
+++ b/chrome/browser/extensions/api/browser_cli/browser_cli_extension_identity.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/browser_cli/browser_cli_extension_identity.h"
+
+#include <array>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "crypto/hash.h"
+#include "extensions/browser/extension_function.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest.h"
+#include "extensions/common/mojom/context_type.mojom.h"
+#include "extensions/common/mojom/manifest.mojom.h"
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+
+namespace extensions::browser_cli {
+
+namespace {
+
+// SHA-256 hash of the Browser CLI automation extension id
+// (`nnollghpaggbcdkkgoieneffnlijinio`). Only the hash appears in source, never
+// the plaintext id, so a string replacement cannot redirect the trust anchor.
+// The SHA-256 of the id is independent of the hashed-id rollout feature; the
+// matching SHA-1 entry in `_api_features.json` only covers the feature-layer
+// comparison.
+constexpr std::string_view kTrustedExtensionIdSha256[] = {
+    "0FC2B72BF7525EEFA66518C54DB602118B38EB5E8AE1B2992EEB0E57911C1722",
+};
+
+std::string ToUpperHex(base::span<const uint8_t> raw) {
+  return base::ToUpperASCII(base::HexEncode(raw));
+}
+
+template <typename Range>
+bool Contains(const Range& range, std::string_view value) {
+  for (const std::string_view entry : range) {
+    if (entry == value) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+bool IsTrustedBrowserCliExtensionIdHash(const ExtensionId& extension_id) {
+  if (extension_id.empty()) {
+    return false;
+  }
+  const std::string sha256 =
+      ToUpperHex(crypto::hash::Sha256(extension_id));
+  return Contains(kTrustedExtensionIdSha256, sha256);
+}
+
+bool IsAllowedBrowserCliManifestLocation(mojom::ManifestLocation location) {
+  switch (location) {
+    case mojom::ManifestLocation::kExternalPref:
+    case mojom::ManifestLocation::kExternalRegistry:
+      return true;
+#if !defined(OFFICIAL_BUILD)
+    // Developer / E2E harness installs. Official builds must ship the extension
+    // through one of the managed install paths above.
+    case mojom::ManifestLocation::kUnpacked:
+    case mojom::ManifestLocation::kCommandLine:
+      return true;
+#endif
+    default:
+      // Everything else (component, internal, policy, unknown) is denied by
+      // default instead of being enumerated.
+      return false;
+  }
+}
+
+bool IsTrustedBrowserCliExtension(const Extension* extension) {
+  if (!extension) {
+    return false;
+  }
+  if (!IsTrustedBrowserCliExtensionIdHash(extension->id())) {
+    return false;
+  }
+  if (!IsAllowedBrowserCliManifestLocation(extension->location())) {
+    return false;
+  }
+  // Off-the-record / split-incognito profiles are rejected by the per-call
+  // check (`IsTrustedBrowserCliCaller`), which sees the browser context.
+  return views::BrowserCliPresentationPolicy::Get()->IsManagedModeEnabled();
+}
+
+bool IsTrustedBrowserCliCaller(ExtensionFunction* function,
+                               std::string* error) {
+  auto deny = [error](const char* reason) {
+    if (error) {
+      *error = reason;
+    }
+    return false;
+  };
+
+  if (!function) {
+    return deny("PERMISSION_DENIED: no extension function context");
+  }
+  const Extension* extension = function->extension();
+  if (!extension) {
+    return deny("PERMISSION_DENIED: not an extension caller");
+  }
+  // Reject content scripts and web pages: the API feature already restricts
+  // `contexts`, this is the second, independent check.
+  if (function->source_context_type() !=
+      mojom::ContextType::kPrivilegedExtension) {
+    return deny("PERMISSION_DENIED: caller is not an extension context");
+  }
+  if (function->browser_context() &&
+      function->browser_context()->IsOffTheRecord()) {
+    return deny("PERMISSION_DENIED: off-the-record profile");
+  }
+  if (!IsTrustedBrowserCliExtension(extension)) {
+    return deny("PERMISSION_DENIED: untrusted extension");
+  }
+  return true;
+}
+
+}  // namespace extensions::browser_cli
