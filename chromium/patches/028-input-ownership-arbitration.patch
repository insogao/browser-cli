+  EXPECT_TRUE(Mouse(Type::kMouseMove, now + base::Seconds(4)));
+  EXPECT_EQ(1, Remaining(SessionA()));
+  // Past the 5s gesture deadline the press is closed, so a move is a bare move
+  // and costs a unit.
+  EXPECT_TRUE(Mouse(Type::kMouseMove, now + base::Seconds(6)));
+  EXPECT_EQ(0, Remaining(SessionA()));
+  // The release of the timed-out gesture is dropped.
