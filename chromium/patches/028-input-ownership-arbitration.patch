+class InputOwnershipControllerTest : public RenderViewHostTestHarness {
+ protected:
+  WebContentsImpl* impl() {
+    return static_cast<WebContentsImpl*>(web_contents());
+  }
+};
+
+// With the feature disabled the delegate never creates a controller, so no
+// user data and no arbitration state exist at all.
+TEST_F(InputOwnershipControllerTest, FeatureOffDoesNotCreateController) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitWithFeatureState(features::kInputOwnershipEnforcement,
+                                     false);
+
+  EXPECT_EQ(nullptr, impl()->GetInputOwnershipController());
+  EXPECT_EQ(nullptr,
+            InputOwnershipController::FromWebContents(web_contents()));
+}
+
+// With the feature enabled there is exactly one controller per WebContents.
+TEST_F(InputOwnershipControllerTest, OneControllerPerWebContents) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+  EXPECT_EQ(controller, impl()->GetInputOwnershipController());
+  EXPECT_EQ(controller,
+            InputOwnershipController::FromWebContents(web_contents()));
+  // A fresh controller fails closed until a mode is reported.
+  EXPECT_EQ(InputOwnershipMode::kAssist, controller->snapshot().mode);
+}
+
+// The controller reflects the decider state through its drop APIs, and the
+// human pause is visible to InputHandler before it forwards anything.
+TEST_F(InputOwnershipControllerTest, DefaultAssistThenAiThenHuman) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+
+  const base::TimeTicks now = T0();
+  blink::WebMouseEvent debugger_mouse(Type::kMouseDown, kDebuggerModifiers,
+                                      now);
+  blink::WebMouseEvent human_mouse(Type::kMouseDown, kHumanModifiers, now);
+
+  // Default mode is kAssist with no grant: fail closed, including the
+  // session-attributed path.
+  EXPECT_TRUE(controller->ShouldDropEvent(debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropSessionTextInsert(SessionA()));
+  EXPECT_FALSE(controller->IsDebuggerInputPaused());
+
+  // kAi delivers debugger input.
+  controller->SetModeForTesting(InputOwnershipMode::kAi);
+  EXPECT_FALSE(controller->ShouldDropEvent(debugger_mouse));
+  EXPECT_FALSE(controller->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+  EXPECT_FALSE(controller->ShouldDropSessionTextInsert(SessionA()));
+
+  // kHuman drops debugger input but never human input.
+  controller->SetModeForTesting(InputOwnershipMode::kHuman);
+  EXPECT_TRUE(controller->ShouldDropEvent(debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropSessionTextInsert(SessionA()));
+  EXPECT_FALSE(controller->ShouldDropEvent(human_mouse));
+  EXPECT_EQ(InputOwnershipMode::kHuman, controller->snapshot().mode);
+}
+
+// A human event seen by the controller immediately pauses debugger input, which
+// is what InputHandler checks before it touches focus.
+TEST_F(InputOwnershipControllerTest, HumanEventPausesDebuggerInput) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+  controller->SetModeForTesting(InputOwnershipMode::kAi);
+
+  const base::TimeTicks now = T0();
+  blink::WebMouseEvent human_mouse(Type::kMouseDown, kHumanModifiers, now);
+  blink::WebMouseEvent debugger_mouse(Type::kMouseDown, kDebuggerModifiers,
+                                      now);
+  EXPECT_FALSE(controller->ShouldDropEvent(human_mouse));
+  EXPECT_TRUE(controller->IsDebuggerInputPaused());
+  EXPECT_TRUE(controller->ShouldDropEvent(debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+}
+
+// Two fake DevTools sessions are isolated at the controller level as well.
+TEST_F(InputOwnershipControllerTest, SessionGrantsAreIsolated) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+  controller->SetModeForTesting(InputOwnershipMode::kAssist);
+
+  // The controller entry points use the real clock, so the grant must be
+  // anchored at TimeTicks::Now() rather than the deterministic test origin.
+  const base::TimeTicks now = base::TimeTicks::Now();
+  blink::WebMouseEvent debugger_mouse(Type::kMouseDown, kDebuggerModifiers,
+                                      now);
+  controller->GrantDebuggerInputForTesting(SessionA(), 1, base::Seconds(10),
+                                           now);
+
+  EXPECT_FALSE(controller->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropSessionEvent(SessionB(), debugger_mouse));
+  EXPECT_EQ(0, controller->RemainingGrantForTesting(SessionA()));
+  EXPECT_EQ(0, controller->RemainingGrantForTesting(SessionB()));
+
+  controller->RevokeDebuggerSession(SessionA());
+  EXPECT_TRUE(controller->ShouldDropSessionEvent(SessionA(), debugger_mouse));
+}
+
+// The scoped authorization is what keeps RenderWidgetHostImpl from charging a
+// second grant unit for the same command. It is per controller (per
+// WebContents) and nests correctly.
+TEST_F(InputOwnershipControllerTest, ScopedAuthorizationIsPerController) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+  std::unique_ptr<WebContents> other_contents = CreateTestWebContents();
+  ASSERT_TRUE(other_contents);
+  InputOwnershipController* other =
+      static_cast<WebContentsImpl*>(other_contents.get())
+          ->GetInputOwnershipController();
+  ASSERT_NE(nullptr, other);
+  ASSERT_NE(controller, other);
+
+  EXPECT_FALSE(controller->IsDebuggerInputAuthorized());
+  EXPECT_FALSE(other->IsDebuggerInputAuthorized());
+
+  {
+    ScopedInputOwnershipAuthorization outer(controller);
+    EXPECT_TRUE(controller->IsDebuggerInputAuthorized());
+    EXPECT_FALSE(other->IsDebuggerInputAuthorized());
+    {
+      ScopedInputOwnershipAuthorization inner(controller);
+      EXPECT_TRUE(controller->IsDebuggerInputAuthorized());
+    }
+    // The inner scope ending must not clear the outer one.
+    EXPECT_TRUE(controller->IsDebuggerInputAuthorized());
+  }
+  EXPECT_FALSE(controller->IsDebuggerInputAuthorized());
+
+  // A null controller (feature disabled / no arbitration state) is a no-op.
+  {
+    ScopedInputOwnershipAuthorization none(nullptr);
+    EXPECT_FALSE(controller->IsDebuggerInputAuthorized());
+  }
+}
+
+// Command-level arbitration and the automation event window as seen by
+// InputHandler (which charges a grant, then opens the window before the
+// gesture starts).
+TEST_F(InputOwnershipControllerTest, AutomationCommandAndWindow) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+  controller->SetModeForTesting(InputOwnershipMode::kAssist);
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // ASSIST without a grant: every synthetic gesture command is rejected.
+  EXPECT_TRUE(controller->ShouldDropSessionCommand(SessionA(), Kind::kScroll));
+  EXPECT_TRUE(controller->ShouldDropSessionCommand(SessionA(), Kind::kTap));
+  EXPECT_FALSE(controller->IsAutomationEventWindowOpen());
+
+  controller->GrantDebuggerInputForTesting(SessionA(), 1, base::Seconds(10),
+                                           now);
+  EXPECT_FALSE(controller->ShouldDropSessionCommand(SessionA(), Kind::kScroll));
+  // The single unit is spent, so the next command is rejected again.
+  EXPECT_TRUE(controller->ShouldDropSessionCommand(SessionA(), Kind::kTap));
+
+  const uint64_t window_id = controller->OpenAutomationEventWindow(
+      SessionA(), now, base::Seconds(5));
+  ASSERT_NE(0u, window_id);
+  EXPECT_TRUE(controller->IsAutomationEventWindowOpen());
+  controller->CloseAutomationEventWindow(window_id);
+  EXPECT_FALSE(controller->IsAutomationEventWindowOpen());
+
+  // HUMAN rejects commands without touching the grant.
+  controller->SetModeForTesting(InputOwnershipMode::kHuman);
+  controller->GrantDebuggerInputForTesting(SessionA(), 2, base::Seconds(10),
+                                           now);
+  EXPECT_TRUE(controller->ShouldDropSessionCommand(SessionA(), Kind::kPinch));
+  EXPECT_EQ(2, controller->RemainingGrantForTesting(SessionA()));
+
+  // AI accepts without consuming.
+  controller->SetModeForTesting(InputOwnershipMode::kAi);
+  controller->GrantDebuggerInputForTesting(SessionA(), 2, base::Seconds(10),
+                                           now);
+  EXPECT_FALSE(
+      controller->ShouldDropSessionCommand(SessionA(), Kind::kEmulateTouchFromMouse));
+  EXPECT_EQ(2, controller->RemainingGrantForTesting(SessionA()));
+}
+
+}  // namespace content
