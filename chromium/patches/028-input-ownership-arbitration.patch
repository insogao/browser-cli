new file mode 100644
index 00000000..158257c2
--- /dev/null
+++ b/content/browser/input_ownership/input_ownership_controller.h
@@ -0,0 +1,75 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_INPUT_OWNERSHIP_INPUT_OWNERSHIP_CONTROLLER_H_
+#define CONTENT_BROWSER_INPUT_OWNERSHIP_INPUT_OWNERSHIP_CONTROLLER_H_
+
+#include "base/time/time.h"
+#include "content/common/content_export.h"
+#include "content/public/browser/input_ownership.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace blink {
+class WebInputEvent;
+}  // namespace blink
+
+namespace content {
+
+class WebContents;
+
+// Browser CLI (patch 028): per-WebContents input ownership arbitration.
+//
+// There is exactly one controller per WebContents (WebContentsUserData). It
+// owns the decision state and is consulted by RenderWidgetHostImpl for the
+// three `Forward*` entry points and by the DevTools InputHandler for
+// `Input.insertText`.
+//
+// The controller is only created when `features::kInputOwnershipEnforcement`
+// is enabled (see WebContentsImpl::GetInputOwnershipController), and the
+// decision engine itself returns "deliver" without touching any state while
+// the feature is disabled.
+//
+// Write entry points here are testing-only. The production write path is the
+// Browser CLI trusted-extension API, which is intentionally not part of this
+// patch.
+class CONTENT_EXPORT InputOwnershipController
+    : public WebContentsUserData<InputOwnershipController> {
+ public:
+  ~InputOwnershipController() override;
+
+  InputOwnershipController(const InputOwnershipController&) = delete;
+  InputOwnershipController& operator=(const InputOwnershipController&) = delete;
+
+  // Returns true if `event` is debugger-injected and must be discarded instead
+  // of being forwarded to the renderer. Human input always returns false.
+  bool ShouldDropAutomationEvent(const blink::WebInputEvent& event);
+
+  // Same as above for `Input.insertText`, which bypasses Forward* entirely.
+  bool ShouldDropAutomationTextInsert();
+
+  InputOwnershipSnapshot snapshot() const { return decider_.snapshot(); }
+
+  // Testing-only. These deliberately ignore
+  // `features::kInputOwnershipEnforcement` so tests can prove that stored
+  // state alone never changes delivery while the feature is off.
+  void SetModeForTesting(InputOwnershipMode mode);
+  void GrantDebuggerInputForTesting(
+      int actions,
+      base::TimeDelta ttl,
+      base::TimeTicks now = base::TimeTicks::Now());
+  void NotifyHumanPresenceForTesting(
+      base::TimeTicks now = base::TimeTicks::Now());
+
+ private:
+  explicit InputOwnershipController(WebContents* web_contents);
+  friend class WebContentsUserData<InputOwnershipController>;
+
+  InputOwnershipDecider decider_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_INPUT_OWNERSHIP_INPUT_OWNERSHIP_CONTROLLER_H_
diff --git a/content/browser/input_ownership/input_ownership_controller_unittest.cc b/content/browser/input_ownership/input_ownership_controller_unittest.cc
new file mode 100644
index 00000000..31093874
--- /dev/null
+++ b/content/browser/input_ownership/input_ownership_controller_unittest.cc
@@ -0,0 +1,451 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/input_ownership/input_ownership_controller.h"
+
+#include "base/test/scoped_feature_list.h"
+#include "base/time/time.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/common/content_features.h"
+#include "content/public/test/test_renderer_host.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_keyboard_event.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/public/common/input/web_mouse_wheel_event.h"
+
+namespace content {
+
+namespace {
+
+constexpr int kDebuggerModifiers = blink::WebInputEvent::kFromDebugger;
+constexpr int kHumanModifiers = blink::WebInputEvent::kNoModifiers;
+
+// A non-null, deterministic time origin for the decider tests.
+base::TimeTicks T0() {
+  return base::TimeTicks() + base::Seconds(1);
+}
+
+using Type = blink::WebInputEvent::Type;
+
+}  // namespace
+
+class InputOwnershipDeciderTest : public testing::Test {
+ protected:
+  void EnableFeature() {
+    feature_list_.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+  }
+  void DisableFeature() {
+    feature_list_.InitWithFeatureState(features::kInputOwnershipEnforcement,
+                                       false);
+  }
+
+  bool Mouse(Type type, int modifiers, base::TimeTicks now) {
+    blink::WebMouseEvent event(type, modifiers, now);
+    return decider_.ShouldDeliverDebuggerEvent(event, now);
+  }
+
+  bool Wheel(int modifiers, base::TimeTicks now) {
+    blink::WebMouseWheelEvent event(Type::kMouseWheel, modifiers, now);
+    return decider_.ShouldDeliverDebuggerEvent(event, now);
+  }
+
+  bool Key(Type type, int modifiers, base::TimeTicks now) {
+    blink::WebKeyboardEvent event(type, modifiers, now);
+    return decider_.ShouldDeliverDebuggerEvent(event, now);
+  }
+
+  base::test::ScopedFeatureList feature_list_;
+  InputOwnershipDecider decider_;
+};
+
+// Feature off: every decision delivers, nothing is consumed, no presence is
+// reported, regardless of the stored mode/grant. This is the default state of
+// the product build.
+TEST_F(InputOwnershipDeciderTest, FeatureOffDeliversEverything) {
+  DisableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  decider_.GrantDebuggerInputForTesting(5, base::Seconds(10), now);
+
+  EXPECT_TRUE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+  EXPECT_TRUE(Mouse(Type::kMouseMove, kDebuggerModifiers, now));
+  EXPECT_TRUE(Wheel(kDebuggerModifiers, now));
+  EXPECT_TRUE(Key(Type::kRawKeyDown, kDebuggerModifiers, now));
+  EXPECT_TRUE(Key(Type::kChar, kDebuggerModifiers, now));
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerTextInsert(now));
+
+  // Zero side effects: the grant was not consumed and no human presence was
+  // recorded (the human event below is the only human input seen).
+  EXPECT_EQ(5, decider_.remaining_grant_for_testing());
+  EXPECT_TRUE(Mouse(Type::kMouseMove, kHumanModifiers, now));
+  EXPECT_EQ(0, decider_.human_presence_count_for_testing());
+  decider_.NotifyHumanPresenceForTesting(now);
+  EXPECT_EQ(0, decider_.human_presence_count_for_testing());
+}
+
+// Feature on but no mode reported yet: arbitration must fail closed. The
+// default is kAssist with no grant, so every debugger event is dropped while
+// human input keeps working. This is the state an embedder lands in if it
+// forgets to call setOwnership.
+TEST_F(InputOwnershipDeciderTest, DefaultModeIsAssistFailClosed) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+
+  const InputOwnershipSnapshot snapshot = decider_.snapshot();
+  EXPECT_EQ(InputOwnershipMode::kAssist, snapshot.mode);
+  EXPECT_EQ(0u, snapshot.version);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+  EXPECT_FALSE(Mouse(Type::kMouseMove, kDebuggerModifiers, now));
+  EXPECT_FALSE(Wheel(kDebuggerModifiers, now));
+  EXPECT_FALSE(Key(Type::kRawKeyDown, kDebuggerModifiers, now));
+  EXPECT_FALSE(Key(Type::kChar, kDebuggerModifiers, now));
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerTextInsert(now));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+
+  // Human input is never affected by the fail-closed default.
+  EXPECT_TRUE(Mouse(Type::kMouseDown, kHumanModifiers, now));
+  EXPECT_TRUE(Key(Type::kRawKeyDown, kHumanModifiers, now));
+  EXPECT_TRUE(Wheel(kHumanModifiers, now));
+  EXPECT_EQ(1, decider_.human_presence_count_for_testing());
+}
+
+// Human input (no kFromDebugger) is never dropped, in any mode.
+TEST_F(InputOwnershipDeciderTest, HumanInputIsAlwaysDelivered) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  for (InputOwnershipMode mode : {InputOwnershipMode::kAi,
+                                  InputOwnershipMode::kAssist,
+                                  InputOwnershipMode::kHuman}) {
+    decider_.SetModeForTesting(mode);
+    EXPECT_TRUE(Mouse(Type::kMouseDown, kHumanModifiers, now))
+        << "mode=" << static_cast<int>(mode);
+    EXPECT_TRUE(Mouse(Type::kMouseMove, kHumanModifiers, now));
+    EXPECT_TRUE(Wheel(kHumanModifiers, now));
+    EXPECT_TRUE(Key(Type::kRawKeyDown, kHumanModifiers, now));
+    EXPECT_TRUE(Key(Type::kChar, kHumanModifiers, now));
+  }
+}
+
+// Human input must not consume the assist-mode grant.
+TEST_F(InputOwnershipDeciderTest, HumanInputDoesNotConsumeGrant) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(2, base::Seconds(10), now);
+
+  EXPECT_TRUE(Mouse(Type::kMouseDown, kHumanModifiers, now));
+  EXPECT_TRUE(Key(Type::kRawKeyDown, kHumanModifiers, now));
+  EXPECT_TRUE(Wheel(kHumanModifiers, now));
+  EXPECT_EQ(2, decider_.remaining_grant_for_testing());
+}
+
+// HUMAN mode drops every debugger-originated event and does not consume the
+// grant.
+TEST_F(InputOwnershipDeciderTest, HumanModeDropsDebuggerInput) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  decider_.GrantDebuggerInputForTesting(10, base::Seconds(10), now);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+  EXPECT_FALSE(Mouse(Type::kMouseMove, kDebuggerModifiers, now));
+  EXPECT_FALSE(Wheel(kDebuggerModifiers, now));
+  EXPECT_FALSE(Key(Type::kRawKeyDown, kDebuggerModifiers, now));
+  EXPECT_FALSE(Key(Type::kChar, kDebuggerModifiers, now));
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerTextInsert(now));
+  EXPECT_EQ(10, decider_.remaining_grant_for_testing());
+}
+
+// AI mode delivers everything without touching the grant. AI is never the
+// default, so it must be set explicitly.
+TEST_F(InputOwnershipDeciderTest, AiModeDeliversDebuggerInput) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAi);
+  decider_.GrantDebuggerInputForTesting(3, base::Seconds(10), now);
+
+  EXPECT_EQ(InputOwnershipMode::kAi, decider_.snapshot().mode);
+  EXPECT_TRUE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+  EXPECT_TRUE(Mouse(Type::kMouseUp, kDebuggerModifiers,
+                    now + base::Milliseconds(5)));
+  EXPECT_TRUE(Wheel(kDebuggerModifiers, now));
+  EXPECT_TRUE(Key(Type::kRawKeyDown, kDebuggerModifiers, now));
+  EXPECT_TRUE(Key(Type::kKeyUp, kDebuggerModifiers, now));
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerTextInsert(now));
+  EXPECT_EQ(3, decider_.remaining_grant_for_testing());
+}
+
+// ASSIST without any grant drops all debugger input.
+TEST_F(InputOwnershipDeciderTest, AssistWithoutGrantDropsDebuggerInput) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+  EXPECT_FALSE(Mouse(Type::kMouseMove, kDebuggerModifiers, now));
+  EXPECT_FALSE(Wheel(kDebuggerModifiers, now));
+  EXPECT_FALSE(Key(Type::kRawKeyDown, kDebuggerModifiers, now));
+  EXPECT_FALSE(Key(Type::kChar, kDebuggerModifiers, now));
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerTextInsert(now));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+}
+
+// One grant unit covers exactly one mouse gesture: press and release are
+// delivered, the next press is rejected.
+TEST_F(InputOwnershipDeciderTest, AssistGrantOneAllowsOnePointerGesture) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(1, base::Seconds(10), now);
+
+  EXPECT_TRUE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_TRUE(Mouse(Type::kMouseUp, kDebuggerModifiers,
+                    now + base::Milliseconds(10)));
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers,
+                     now + base::Milliseconds(500)));
+}
+
+// A press that is not granted must not leak its release to the page.
+TEST_F(InputOwnershipDeciderTest, AssistDroppedPressAlsoDropsRelease) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+  EXPECT_FALSE(Mouse(Type::kMouseUp, kDebuggerModifiers,
+                     now + base::Milliseconds(10)));
+}
+
+// Bare moves outside a granted gesture each cost one unit.
+TEST_F(InputOwnershipDeciderTest, AssistBareMoveCostsOneUnit) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(1, base::Seconds(10), now);
+
+  EXPECT_TRUE(Mouse(Type::kMouseMove, kDebuggerModifiers, now));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_FALSE(Mouse(Type::kMouseMove, kDebuggerModifiers,
+                     now + base::Milliseconds(1)));
+}
+
+// Every wheel tick costs one unit.
+TEST_F(InputOwnershipDeciderTest, AssistWheelCostsOneUnitPerTick) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(1, base::Seconds(10), now);
+
+  EXPECT_TRUE(Wheel(kDebuggerModifiers, now));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_FALSE(Wheel(kDebuggerModifiers, now + base::Milliseconds(1)));
+}
+
+// One grant unit covers one physical key press: RawKeyDown, Char and KeyUp are
+// delivered, the next RawKeyDown is rejected.
+TEST_F(InputOwnershipDeciderTest, AssistGrantOneAllowsOneKeyPress) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(1, base::Seconds(10), now);
+
+  EXPECT_TRUE(Key(Type::kRawKeyDown, kDebuggerModifiers, now));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_TRUE(Key(Type::kChar, kDebuggerModifiers,
+                  now + base::Milliseconds(1)));
+  EXPECT_TRUE(Key(Type::kKeyUp, kDebuggerModifiers,
+                  now + base::Milliseconds(2)));
+  // A KeyUp that does not belong to a delivered press is dropped.
+  EXPECT_FALSE(Key(Type::kKeyUp, kDebuggerModifiers,
+                   now + base::Milliseconds(3)));
+  EXPECT_FALSE(Key(Type::kRawKeyDown, kDebuggerModifiers,
+                   now + base::Milliseconds(4)));
+}
+
+// Consecutive text insertions within 300ms share one unit; a later insertion
+// needs a new unit.
+TEST_F(InputOwnershipDeciderTest, AssistTextInsertSharesOneBurst) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(1, base::Seconds(10), now);
+
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerTextInsert(now));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerTextInsert(
+      now + base::Milliseconds(100)));
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerTextInsert(
+      now + base::Milliseconds(200)));
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerTextInsert(
+      now + base::Milliseconds(900)));
+}
+
+// Expired grants are cleared and rejected.
+TEST_F(InputOwnershipDeciderTest, AssistGrantExpiry) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(5, base::Milliseconds(50), now);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers,
+                     now + base::Milliseconds(100)));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers,
+                     now + base::Milliseconds(200)));
+}
+
+// Exhausted grants are cleared (no accidental resurrection).
+TEST_F(InputOwnershipDeciderTest, AssistGrantExhaustion) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(2, base::Seconds(10), now);
+
+  EXPECT_TRUE(Wheel(kDebuggerModifiers, now));
+  EXPECT_TRUE(Wheel(kDebuggerModifiers, now + base::Milliseconds(1)));
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_FALSE(Wheel(kDebuggerModifiers, now + base::Milliseconds(2)));
+}
+
+// Grants are only valid in ASSIST mode; switching the mode clears them.
+TEST_F(InputOwnershipDeciderTest, GrantClearedOnModeChange) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(5, base::Seconds(10), now);
+  EXPECT_EQ(5, decider_.remaining_grant_for_testing());
+
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  EXPECT_EQ(0, decider_.remaining_grant_for_testing());
+  EXPECT_FALSE(Mouse(Type::kMouseDown, kDebuggerModifiers, now));
+}
+
+// The snapshot version is monotonic and only bumps on an actual mode change.
+TEST_F(InputOwnershipDeciderTest, ModeVersionIsMonotonic) {
+  EnableFeature();
+  InputOwnershipSnapshot snapshot = decider_.snapshot();
+  // Default is kAssist (fail closed), not kAi.
+  EXPECT_EQ(InputOwnershipMode::kAssist, snapshot.mode);
+  EXPECT_EQ(0u, snapshot.version);
+
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  EXPECT_EQ(0u, decider_.snapshot().version);
+
+  decider_.SetModeForTesting(InputOwnershipMode::kAi);
+  snapshot = decider_.snapshot();
+  EXPECT_EQ(InputOwnershipMode::kAi, snapshot.mode);
+  EXPECT_EQ(1u, snapshot.version);
+
+  decider_.SetModeForTesting(InputOwnershipMode::kAi);
+  EXPECT_EQ(1u, decider_.snapshot().version);
+
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  snapshot = decider_.snapshot();
+  EXPECT_EQ(InputOwnershipMode::kHuman, snapshot.mode);
+  EXPECT_EQ(2u, snapshot.version);
+}
+
+// Human presence is debounced to one report per 300ms window.
+TEST_F(InputOwnershipDeciderTest, HumanPresenceIsDebounced) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+
+  EXPECT_TRUE(Mouse(Type::kMouseMove, kHumanModifiers, now));
+  EXPECT_TRUE(Mouse(Type::kMouseMove, kHumanModifiers,
+                    now + base::Milliseconds(100)));
+  EXPECT_EQ(1, decider_.human_presence_count_for_testing());
+
+  EXPECT_TRUE(Mouse(Type::kMouseMove, kHumanModifiers,
+                    now + base::Milliseconds(400)));
+  EXPECT_EQ(2, decider_.human_presence_count_for_testing());
+
+  decider_.NotifyHumanPresenceForTesting(now + base::Milliseconds(500));
+  EXPECT_EQ(2, decider_.human_presence_count_for_testing());
+  decider_.NotifyHumanPresenceForTesting(now + base::Milliseconds(800));
+  EXPECT_EQ(3, decider_.human_presence_count_for_testing());
+}
+
+// Debugger input never counts as human presence (checked in kAi so that the
+// event is actually delivered).
+TEST_F(InputOwnershipDeciderTest, DebuggerInputIsNotHumanPresence) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAi);
+  EXPECT_TRUE(Mouse(Type::kMouseMove, kDebuggerModifiers, now));
+  EXPECT_EQ(0, decider_.human_presence_count_for_testing());
+}
+
+// --- Controller tests -------------------------------------------------------
+
+class InputOwnershipControllerTest : public RenderViewHostTestHarness {
+ protected:
+  WebContentsImpl* impl() {
+    return static_cast<WebContentsImpl*>(web_contents());
+  }
+};
+
+// With the feature disabled the delegate never creates a controller, so no
+// user data and no arbitration state exist at all.
+TEST_F(InputOwnershipControllerTest, FeatureOffDoesNotCreateController) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitWithFeatureState(features::kInputOwnershipEnforcement,
+                                     false);
+
+  EXPECT_EQ(nullptr, impl()->GetInputOwnershipController());
+  EXPECT_EQ(nullptr,
+            InputOwnershipController::FromWebContents(web_contents()));
+}
+
+// With the feature enabled there is exactly one controller per WebContents.
+TEST_F(InputOwnershipControllerTest, OneControllerPerWebContents) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+  EXPECT_EQ(controller, impl()->GetInputOwnershipController());
+  EXPECT_EQ(controller,
+            InputOwnershipController::FromWebContents(web_contents()));
+  // A fresh controller fails closed until a mode is reported.
+  EXPECT_EQ(InputOwnershipMode::kAssist, controller->snapshot().mode);
+}
+
+// The controller reflects the decider state through ShouldDropAutomationEvent.
+TEST_F(InputOwnershipControllerTest, DefaultAssistThenAiThenHuman) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+
+  InputOwnershipController* controller =
+      impl()->GetInputOwnershipController();
+  ASSERT_NE(nullptr, controller);
+
+  const base::TimeTicks now = T0();
+  blink::WebMouseEvent debugger_mouse(Type::kMouseDown, kDebuggerModifiers,
+                                      now);
+  blink::WebMouseEvent human_mouse(Type::kMouseDown, kHumanModifiers, now);
+
+  // Default mode is kAssist with no grant: fail closed.
+  EXPECT_TRUE(controller->ShouldDropAutomationEvent(debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropAutomationTextInsert());
+
+  // kAi delivers debugger input.
+  controller->SetModeForTesting(InputOwnershipMode::kAi);
+  EXPECT_FALSE(controller->ShouldDropAutomationEvent(debugger_mouse));
+  EXPECT_FALSE(controller->ShouldDropAutomationTextInsert());
+
+  // kHuman drops debugger input but never human input.
+  controller->SetModeForTesting(InputOwnershipMode::kHuman);
+  EXPECT_TRUE(controller->ShouldDropAutomationEvent(debugger_mouse));
+  EXPECT_TRUE(controller->ShouldDropAutomationTextInsert());
+  EXPECT_FALSE(controller->ShouldDropAutomationEvent(human_mouse));
+  EXPECT_EQ(InputOwnershipMode::kHuman, controller->snapshot().mode);
+}
+
+}  // namespace content
