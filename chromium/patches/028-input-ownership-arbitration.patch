new file mode 100644
index 00000000..5220210a
--- /dev/null
+++ b/content/public/browser/input_ownership.h
@@ -0,0 +1,280 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_PUBLIC_BROWSER_INPUT_OWNERSHIP_H_
+#define CONTENT_PUBLIC_BROWSER_INPUT_OWNERSHIP_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <map>
+#include <optional>
+
+#include "base/time/time.h"
+#include "content/common/content_export.h"
+
+namespace blink {
+class WebInputEvent;
+}  // namespace blink
+
+namespace content {
+
+class InputOwnershipController;
+
+// Browser CLI (patch 028): the mode the trusted embedder (the Browser CLI
+// extension, via a kernel-only API) has assigned to a WebContents.
+enum class InputOwnershipMode {
+  // Automation owns the tab: debugger input is delivered freely.
+  kAi,
+  // Automation works on behalf of a human: debugger input is delivered only
+  // while a human-granted budget is available.
+  kAssist,
+  // The human owns the tab: debugger input is dropped, human input is always
+  // delivered.
+  kHuman,
+};
+
+// Opaque identity of the DevTools session that injected a debugger input event.
+// In `content/browser` this is the `DevToolsSession*` associated with the
+// `InputHandler`; the decision engine only ever uses it as a map key and never
+// dereferences it, so it stays an opaque `const void*` here. `nullptr` means
+// "no session attribution" and is always handled conservatively (see
+// `ShouldDeliverEvent`).
+using InputOwnershipSessionToken = const void*;
+
+// Browser CLI (patch 028): CDP input commands that do not surface as an
+// arbitrated `blink::WebInputEvent` on the `Forward*` paths, and therefore need
+// a command-level decision (design §13.10).
+enum class InputOwnershipCommandKind {
+  // `Input.dispatchTouchEvent` through the synthetic pointer-action driver
+  // (used when features::kSyntheticPointerActions is enabled).
+  kTouch,
+  // `Input.emulateTouchFromMouseEvent`.
+  kEmulateTouchFromMouse,
+  // `Input.synthesizePinchGesture`.
+  kPinch,
+  // `Input.synthesizeScrollGesture`.
+  kScroll,
+  // `Input.synthesizeTapGesture`.
+  kTap,
+};
+
+// Snapshot of the arbitration state. `version` is monotonically increasing and
+// is bumped on every accepted mode change.
+//
+// The default mode is kAssist: an embedder that has not (yet) reported a mode
+// must fail closed. With no grant, kAssist drops all debugger input while
+// human input keeps working, which matches design §13.1 ("unknown -> ASSIST").
+struct CONTENT_EXPORT InputOwnershipSnapshot {
+  InputOwnershipMode mode = InputOwnershipMode::kAssist;
+  uint64_t version = 0;
+};
+
+// Pure decision engine for input ownership arbitration. It deliberately does
+// not depend on WebContents, renderers or the DevTools protocol so that it can
+// be unit tested in isolation. The controller owns one instance per
+// WebContents.
+//
+// Invariants:
+//  - With `features::kInputOwnershipEnforcement` disabled every query returns
+//    true ("deliver") and no state is read or written.
+//  - Human input (events without `blink::WebInputEvent::kFromDebugger`) is
+//    never dropped. The moment a human event is seen it pauses ALL debugger
+//    input for `kHumanInputPause` (refreshed by every human event).
+//  - The initial mode is kAssist (fail closed): before any mode is set,
+//    debugger input is dropped because there is no grant.
+//  - Debugger input is dropped in kHuman mode.
+//  - Grants are bucketed per DevTools session token. A debugger event that
+//    cannot be attributed to a session token is only delivered in kAi mode;
+//    in kAssist/kHuman it fails closed.
+//  - In kAssist mode debugger input is delivered only while the session's
+//    grant is valid; each input gesture consumes one unit of the grant. A
+//    gesture is a full mouse press/release cycle, a single wheel command, one
+//    physical key press (RawKeyDown ... KeyUp/Char) or one burst of text
+//    insertion (consecutive `Input.insertText` calls within 300ms).
+//  - The grant deadline is fixed at issuance time (`now + ttl`). No event ever
+//    extends it. Gesture windows and the text burst window are additionally
+//    capped by it: a gesture can outlive neither its own deadline (5s mouse,
+//    2s keyboard) nor the grant deadline.
+//  - Grants, gestures and text bursts are cleared when the mode changes, when
+//    the session is revoked, when the grant expires and when the owning
+//    WebContents (and therefore this object) is destroyed.
+class CONTENT_EXPORT InputOwnershipDecider {
+ public:
+  InputOwnershipDecider();
+  ~InputOwnershipDecider();
+
+  InputOwnershipDecider(const InputOwnershipDecider&) = delete;
+  InputOwnershipDecider& operator=(const InputOwnershipDecider&) = delete;
+
+  // Entry point for events that carry no session attribution; used by
+  // `RenderWidgetHostImpl`. Human input is always delivered (and noted as human
+  // presence, which pauses debugger input). Debugger input here is delivered
+  // only in kAi mode: without a session token there is no grant to bill, so
+  // kAssist/kHuman fail closed. Callers pass the local time to keep decisions
+  // deterministic in tests.
+  bool ShouldDeliverEvent(const blink::WebInputEvent& event,
+                          base::TimeTicks now = base::TimeTicks::Now());
+
+  // Entry points for debugger input injected by a specific DevTools session;
+  // used by `InputHandler`. `session` must be non-null for a session that was
+  // granted a budget.
+  bool ShouldDeliverDebuggerEvent(
+      InputOwnershipSessionToken session,
+      const blink::WebInputEvent& event,
+      base::TimeTicks now = base::TimeTicks::Now());
+  bool ShouldDeliverDebuggerTextInsert(
+      InputOwnershipSessionToken session,
+      base::TimeTicks now = base::TimeTicks::Now());
+
+  // Command-level entry point for CDP input commands whose events do not reach
+  // an arbitrated `Forward*` call with a usable `kFromDebugger` marker
+  // (synthetic gestures, emulated touch). Semantics are identical to the event
+  // path, one grant unit per accepted command:
+  //  - feature off: deliver, no state;
+  //  - human pause: drop;
+  //  - kAi: deliver without consuming;
+  //  - kHuman: drop;
+  //  - kAssist: deliver only with a valid grant for `session`, consuming one
+  //    unit;
+  //  - no session attribution: deliver only in kAi.
+  bool ShouldDeliverDebuggerCommand(
+      InputOwnershipSessionToken session,
+      InputOwnershipCommandKind kind,
+      base::TimeTicks now = base::TimeTicks::Now());
+
+  // Automation event window: while a command accepted by
+  // ShouldDeliverDebuggerCommand() is producing renderer events, the platform
+  // events it generates can lose `kFromDebugger` (they are rebuilt from
+  // `ui::Event`). Such events must not be mistaken for human input, otherwise
+  // every synthetic gesture would report human presence and pause automation.
+  // The window is bounded by `max_duration` (capped at 5s), by the grant
+  // deadline and closes explicitly when the gesture finishes. Returns an opaque
+  // window id (0 when the feature is off); pass it to
+  // CloseAutomationEventWindow().
+  uint64_t OpenAutomationEventWindow(InputOwnershipSessionToken session,
+                                     base::TimeTicks now,
+                                     base::TimeDelta max_duration);
+  void CloseAutomationEventWindow(uint64_t window_id);
+  bool IsAutomationEventWindowOpen(
+      base::TimeTicks now = base::TimeTicks::Now()) const;
+
+  // True while a recent human input event suppresses all debugger input.
+  bool IsDebuggerInputPaused(
+      base::TimeTicks now = base::TimeTicks::Now()) const;
+
+  InputOwnershipSnapshot snapshot() const { return {mode_, version_}; }
+
+  // Testing-only entry points. They are never reachable from a renderer, a
+  // web page or a DevTools client. Production writes go through the trusted
+  // Browser CLI extension API (not part of this patch); these setters exist so
+  // the decision matrix can be exercised without that API.
+  void SetModeForTesting(InputOwnershipMode mode);
+  void GrantDebuggerInputForTesting(
+      InputOwnershipSessionToken session,
+      int actions,
+      base::TimeDelta ttl,
+      base::TimeTicks now = base::TimeTicks::Now());
+  void NotifyHumanPresenceForTesting(
+      base::TimeTicks now = base::TimeTicks::Now());
+
+  // Drops everything held for `session` (grant, gesture windows, text burst).
+  // Called when a DevTools session is disabled or destroyed so that a recycled
+  // session pointer cannot inherit an old grant.
+  void RevokeDebuggerSession(InputOwnershipSessionToken session);
+  void ClearDebuggerSessions();
+
+  // Test-only introspection.
+  int human_presence_count_for_testing() const { return human_presence_count_; }
+  int remaining_grant_for_testing(InputOwnershipSessionToken session) const;
+  size_t debugger_session_count_for_testing() const {
+    return debugger_sessions_.size();
+  }
+  std::optional<InputOwnershipCommandKind> last_command_kind_for_testing()
+      const {
+    return last_command_kind_;
+  }
+
+ private:
+  struct DebuggerSessionState {
+    // Remaining grant units. 0 means "no grant" (or exhausted).
+    int grant_remaining = 0;
+    // Absolute end of the grant, fixed when the grant is issued. It is kept
+    // after the last unit is consumed so that the open gesture / text burst it
+    // paid for stays bounded by the grant itself, and it is never extended.
+    base::TimeTicks grant_deadline;
+
+    bool mouse_gesture_open = false;
+    // Absolute end of the current press. Capped by `grant_deadline`.
+    base::TimeTicks mouse_gesture_deadline;
+    base::TimeTicks mouse_grace_until;
+    bool key_gesture_open = false;
+    // Absolute end of the current key press. Capped by `grant_deadline`.
+    base::TimeTicks key_gesture_deadline;
+    // Absolute end of the current `Input.insertText` burst. Capped by
+    // `grant_deadline`, so a steady stream of insertions cannot extend it.
+    base::TimeTicks text_burst_until;
+
+    bool IsIdle() const {
+      return !mouse_gesture_open && !key_gesture_open &&
+             mouse_grace_until.is_null() && text_burst_until.is_null();
+    }
+  };
+
+  DebuggerSessionState* FindSession(InputOwnershipSessionToken session);
+  const DebuggerSessionState* FindSessionForTesting(
+      InputOwnershipSessionToken session) const;
+
+  // Clears expired grants and gesture windows. This is the only place that
+  // removes expired state, so it runs on every decision.
+  void PurgeExpired(base::TimeTicks now);
+
+  bool IsDebuggerEvent(const blink::WebInputEvent& event) const;
+  bool UnattributedDebuggerAllowed() const;
+  bool ConsumeGrant(DebuggerSessionState& session, base::TimeTicks now);
+  base::TimeTicks CapToGrant(DebuggerSessionState& session,
+                             base::TimeTicks deadline) const;
+
+  bool DecideMouse(DebuggerSessionState& session,
+                   const blink::WebInputEvent& event,
+                   base::TimeTicks now);
+  bool DecideKey(DebuggerSessionState& session,
+                 const blink::WebInputEvent& event,
+                 base::TimeTicks now);
+  bool DecideUnknown(DebuggerSessionState& session, base::TimeTicks now);
+
+  void NoteHumanPresence(base::TimeTicks now);
+
+  // Bounded window during which unmarked renderer events produced by an
+  // accepted automation command are not treated as human input.
+  struct AutomationEventWindow {
+    uint64_t id = 0;
+    InputOwnershipSessionToken session = nullptr;
+    base::TimeTicks deadline;
+  };
+  void ClearAutomationEventWindow();
+
+  // Initial mode is kAssist on purpose: until a trusted embedder reports a
+  // mode, arbitration must fail closed (no grant => debugger input is dropped).
+  InputOwnershipMode mode_ = InputOwnershipMode::kAssist;
+  uint64_t version_ = 0;
+
+  std::map<InputOwnershipSessionToken, DebuggerSessionState> debugger_sessions_;
+
+  uint64_t next_automation_window_id_ = 1;
+  AutomationEventWindow automation_window_;
+  std::optional<InputOwnershipCommandKind> last_command_kind_;
+
+  // Debugger input is discarded until this point after any human input. Set
+  // immediately when the human event arrives (never debounced) and refreshed
+  // by every human event.
+  base::TimeTicks human_pause_until_;
+
+  base::TimeTicks last_human_presence_;
+  int human_presence_count_ = 0;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_INPUT_OWNERSHIP_H_
