+++ b/content/browser/input_ownership/input_ownership_controller.h
@@ -0,0 +1,174 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_INPUT_OWNERSHIP_INPUT_OWNERSHIP_CONTROLLER_H_
+#define CONTENT_BROWSER_INPUT_OWNERSHIP_INPUT_OWNERSHIP_CONTROLLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "content/common/content_export.h"
+#include "content/public/browser/input_ownership.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace blink {
+class WebInputEvent;
+}  // namespace blink
+
+namespace content {
+
+class WebContents;
+
+// Browser CLI (patch 028): per-WebContents input ownership arbitration.
+//
+// There is exactly one controller per WebContents (WebContentsUserData). It
+// owns the arbitration state and is consulted by:
+//  - RenderWidgetHostImpl for the three `Forward*` entry points, through
+//    ShouldDropEvent() (human presence + debugger input without session
+//    attribution), and
+//  - the DevTools InputHandler for mouse/wheel/keyboard/insertText, through
+//    ShouldDropSessionEvent() / ShouldDropSessionTextInsert() (debugger input
+//    attributed to a specific DevTools session).
+//
+// Attribution and single consumption
+// ----------------------------------
+// InputHandler checks and consumes the session's grant *before* it touches
+// focus or the renderer, and then wraps the actual forward in a
+// ScopedInputOwnershipAuthorization. RenderWidgetHostImpl sees that scope and
+// skips its own arbitration for those events, so one command is charged
+// exactly once even when it produces several renderer events (a wheel command
+// forwards a real event plus a synthetic phaseEnded one).
+//
+// Events that reach RenderWidgetHostImpl without such a scope (third-party
+// injection paths, drag-controller continuations) are not attributable to a
+// session and therefore fail closed outside kAi mode.
+//
+// The controller is only created when `features::kInputOwnershipEnforcement`
+// is enabled (see WebContentsImpl::GetInputOwnershipController), and the
+// decision engine returns "deliver" without touching any state while the
+// feature is disabled.
+//
+// Write entry points here are testing-only, except for
+// RevokeDebuggerSession() which is the lifecycle hook used by InputHandler.
+// The production grant path is the Browser CLI trusted-extension API, which is
+// intentionally not part of this patch.
+class CONTENT_EXPORT InputOwnershipController
+    : public WebContentsUserData<InputOwnershipController> {
+ public:
+  ~InputOwnershipController() override;
+
+  InputOwnershipController(const InputOwnershipController&) = delete;
+  InputOwnershipController& operator=(const InputOwnershipController&) = delete;
+
+  // Returns true if `event` must be discarded instead of being forwarded to the
+  // renderer. Human input always returns false (and pauses debugger input).
+  // Debugger input without a session attribution is only delivered in kAi mode.
+  bool ShouldDropEvent(const blink::WebInputEvent& event);
+
+  // Same as above for debugger input attributed to `session`.
+  bool ShouldDropSessionEvent(InputOwnershipSessionToken session,
+                              const blink::WebInputEvent& event);
+
+  // Same as above for `Input.insertText`, which bypasses Forward* entirely.
+  bool ShouldDropSessionTextInsert(InputOwnershipSessionToken session);
+
+  // Command-level decision for CDP commands whose renderer events do not carry
+  // a usable `kFromDebugger` marker (synthetic gestures, emulated touch). One
+  // grant unit per accepted command.
+  bool ShouldDropSessionCommand(InputOwnershipSessionToken session,
+                                InputOwnershipCommandKind kind);
+
+  // Opens a bounded window during which unmarked renderer events produced by an
+  // accepted automation command are delivered but not mistaken for human input.
+  // Returns an opaque id (0 when the feature is off) for
+  // CloseAutomationEventWindow().
+  uint64_t OpenAutomationEventWindow(InputOwnershipSessionToken session,
+                                     base::TimeTicks now,
+                                     base::TimeDelta max_duration);
+  void CloseAutomationEventWindow(uint64_t window_id);
+  bool IsAutomationEventWindowOpen() const;
+
+  // True while a recent human input event suppresses all debugger input.
+  bool IsDebuggerInputPaused();
+
+  // True while a ScopedInputOwnershipAuthorization for this controller is
+  // alive. RenderWidgetHostImpl then trusts that InputHandler already decided
+  // and charged this event.
+  bool IsDebuggerInputAuthorized() const {
+    return debugger_authorization_depth_ > 0;
+  }
+
+  // Drops the grant and all gesture/text state held for `session`. Called when
+  // the DevTools session is disabled or destroyed.
+  void RevokeDebuggerSession(InputOwnershipSessionToken session);
+
+  // Weak handle for DevTools handlers, which may outlive the WebContents (and
+  // therefore this controller) during teardown.
+  base::WeakPtr<InputOwnershipController> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  InputOwnershipSnapshot snapshot() const { return decider_.snapshot(); }
+
+  // Testing-only. These deliberately ignore
+  // `features::kInputOwnershipEnforcement` so tests can prove that stored
+  // state alone never changes delivery while the feature is off.
+  void SetModeForTesting(InputOwnershipMode mode);
+  void GrantDebuggerInputForTesting(
+      InputOwnershipSessionToken session,
+      int actions,
+      base::TimeDelta ttl,
+      base::TimeTicks now = base::TimeTicks::Now());
+  void NotifyHumanPresenceForTesting(
+      base::TimeTicks now = base::TimeTicks::Now());
+  int RemainingGrantForTesting(InputOwnershipSessionToken session) const {
+    return decider_.remaining_grant_for_testing(session);
+  }
+  size_t DebuggerSessionCountForTesting() const {
+    return decider_.debugger_session_count_for_testing();
+  }
+
+ private:
+  friend class ScopedInputOwnershipAuthorization;
+
+  explicit InputOwnershipController(WebContents* web_contents);
+  friend class WebContentsUserData<InputOwnershipController>;
+
+  InputOwnershipDecider decider_;
+
+  // Depth of live ScopedInputOwnershipAuthorization objects. Input dispatch is
+  // synchronous on the UI thread, so a plain counter is sufficient; nesting
+  // only happens for the multiple renderer events of a single command.
+  int debugger_authorization_depth_ = 0;
+
+  base::WeakPtrFactory<InputOwnershipController> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// Marks a synchronous forward as already authorized by InputHandler. While one
+// of these is alive, RenderWidgetHostImpl treats debugger input for the same
+// controller as delivered and does not consult the grant again (no double
+// consumption). A null controller (feature disabled, no controller) makes this
+// a no-op.
+class CONTENT_EXPORT ScopedInputOwnershipAuthorization {
+ public:
+  explicit ScopedInputOwnershipAuthorization(
+      InputOwnershipController* controller);
+  ~ScopedInputOwnershipAuthorization();
+
+  ScopedInputOwnershipAuthorization(const ScopedInputOwnershipAuthorization&) =
+      delete;
+  ScopedInputOwnershipAuthorization& operator=(
+      const ScopedInputOwnershipAuthorization&) = delete;
+
+ private:
+  // The controller is a WebContentsUserData that outlives this stack object;
+  // the scope is created and destroyed within one synchronous dispatch.
+  raw_ptr<InputOwnershipController> controller_ = nullptr;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_INPUT_OWNERSHIP_INPUT_OWNERSHIP_CONTROLLER_H_
diff --git a/content/browser/input_ownership/input_ownership_controller_unittest.cc b/content/browser/input_ownership/input_ownership_controller_unittest.cc
new file mode 100644
index 00000000..2c72803e
--- /dev/null
+++ b/content/browser/input_ownership/input_ownership_controller_unittest.cc
@@ -0,0 +1,992 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/input_ownership/input_ownership_controller.h"
+
+#include <memory>
+
+#include "base/test/scoped_feature_list.h"
+#include "base/time/time.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/common/content_features.h"
+#include "content/public/test/test_renderer_host.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_keyboard_event.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/public/common/input/web_mouse_wheel_event.h"
+
+namespace content {
+
+namespace {
+
+constexpr int kDebuggerModifiers = blink::WebInputEvent::kFromDebugger;
+constexpr int kHumanModifiers = blink::WebInputEvent::kNoModifiers;
+
+// Two distinct fake DevTools session identities. Their addresses are only used
+// as opaque grant-bucket keys, exactly like a real DevToolsSession*.
+int g_fake_session_a;
+int g_fake_session_b;
+
+InputOwnershipSessionToken SessionA() {
+  return &g_fake_session_a;
+}
+InputOwnershipSessionToken SessionB() {
+  return &g_fake_session_b;
+}
+
+// A non-null, deterministic time origin for the decider tests.
+base::TimeTicks T0() {
+  return base::TimeTicks() + base::Seconds(1);
+}
+
+using Type = blink::WebInputEvent::Type;
+using Kind = InputOwnershipCommandKind;
+
+}  // namespace
+
+class InputOwnershipDeciderTest : public testing::Test {
+ protected:
+  void EnableFeature() {
+    feature_list_.InitAndEnableFeature(features::kInputOwnershipEnforcement);
+  }
+  void DisableFeature() {
+    feature_list_.InitWithFeatureState(features::kInputOwnershipEnforcement,
+                                       false);
+  }
+
+  bool DebuggerEvent(InputOwnershipSessionToken session,
+                     const blink::WebInputEvent& event,
+                     base::TimeTicks now) {
+    return decider_.ShouldDeliverDebuggerEvent(session, event, now);
+  }
+
+  bool Mouse(Type type, InputOwnershipSessionToken session,
+             base::TimeTicks now) {
+    blink::WebMouseEvent event(type, kDebuggerModifiers, now);
+    return DebuggerEvent(session, event, now);
+  }
+
+  bool Mouse(Type type, base::TimeTicks now) {
+    return Mouse(type, SessionA(), now);
+  }
+
+  bool Wheel(InputOwnershipSessionToken session, base::TimeTicks now) {
+    blink::WebMouseWheelEvent event(Type::kMouseWheel, kDebuggerModifiers, now);
+    return DebuggerEvent(session, event, now);
+  }
+
+  bool Wheel(base::TimeTicks now) {
+    return Wheel(SessionA(), now);
+  }
+
+  bool Key(Type type, InputOwnershipSessionToken session, base::TimeTicks now) {
+    blink::WebKeyboardEvent event(type, kDebuggerModifiers, now);
+    return DebuggerEvent(session, event, now);
+  }
+
+  bool Key(Type type, base::TimeTicks now) {
+    return Key(type, SessionA(), now);
+  }
+
+  bool Text(InputOwnershipSessionToken session, base::TimeTicks now) {
+    return decider_.ShouldDeliverDebuggerTextInsert(session, now);
+  }
+
+  bool Text(base::TimeTicks now) {
+    return Text(SessionA(), now);
+  }
+
+  bool HumanMouse(Type type, base::TimeTicks now) {
+    blink::WebMouseEvent event(type, kHumanModifiers, now);
+    return decider_.ShouldDeliverEvent(event, now);
+  }
+
+  bool HumanKey(Type type, base::TimeTicks now) {
+    blink::WebKeyboardEvent event(type, kHumanModifiers, now);
+    return decider_.ShouldDeliverEvent(event, now);
+  }
+
+  bool UnattributedDebuggerMouse(Type type, base::TimeTicks now) {
+    blink::WebMouseEvent event(type, kDebuggerModifiers, now);
+    return decider_.ShouldDeliverEvent(event, now);
+  }
+
+  int Remaining(InputOwnershipSessionToken session) const {
+    return decider_.remaining_grant_for_testing(session);
+  }
+
+  base::test::ScopedFeatureList feature_list_;
+  InputOwnershipDecider decider_;
+};
+
+// Feature off: every decision delivers, nothing is consumed, no presence is
+// reported, regardless of the stored mode/grant. This is the default state of
+// the product build.
+TEST_F(InputOwnershipDeciderTest, FeatureOffDeliversEverything) {
+  DisableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 5, base::Seconds(10), now);
+
+  EXPECT_TRUE(Mouse(Type::kMouseDown, now));
+  EXPECT_TRUE(Mouse(Type::kMouseMove, now));
+  EXPECT_TRUE(Wheel(now));
+  EXPECT_TRUE(Key(Type::kRawKeyDown, now));
+  EXPECT_TRUE(Key(Type::kChar, now));
+  EXPECT_TRUE(Text(now));
+
+  // Zero side effects: the grant was not consumed, nothing was paused and no
+  // human presence was recorded (the human event below is the only one seen).
+  EXPECT_EQ(5, Remaining(SessionA()));
+  EXPECT_FALSE(decider_.IsDebuggerInputPaused(now));
+  EXPECT_TRUE(HumanMouse(Type::kMouseMove, now));
+  EXPECT_EQ(0, decider_.human_presence_count_for_testing());
+  decider_.NotifyHumanPresenceForTesting(now);
+  EXPECT_EQ(0, decider_.human_presence_count_for_testing());
+}
+
+// Feature on but no mode reported yet: arbitration must fail closed. The
+// default is kAssist with no grant, so every debugger event is dropped while
+// human input keeps working. This is the state an embedder lands in if it
+// forgets to call setOwnership.
+TEST_F(InputOwnershipDeciderTest, DefaultModeIsAssistFailClosed) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+
+  const InputOwnershipSnapshot snapshot = decider_.snapshot();
+  EXPECT_EQ(InputOwnershipMode::kAssist, snapshot.mode);
+  EXPECT_EQ(0u, snapshot.version);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, now));
+  EXPECT_FALSE(Mouse(Type::kMouseMove, now));
+  EXPECT_FALSE(Wheel(now));
+  EXPECT_FALSE(Key(Type::kRawKeyDown, now));
+  EXPECT_FALSE(Key(Type::kChar, now));
+  EXPECT_FALSE(Text(now));
+  EXPECT_EQ(0, Remaining(SessionA()));
+  EXPECT_EQ(0u, decider_.debugger_session_count_for_testing());
+
+  // Human input is never affected by the fail-closed default.
+  EXPECT_TRUE(HumanMouse(Type::kMouseDown, now));
+  EXPECT_TRUE(HumanKey(Type::kRawKeyDown, now));
+  EXPECT_TRUE(HumanMouse(Type::kMouseMove, now));
+  EXPECT_EQ(1, decider_.human_presence_count_for_testing());
+}
+
+// Human input (no kFromDebugger) is never dropped, in any mode, and also when
+// it is delivered through the session-attributed entry point.
+TEST_F(InputOwnershipDeciderTest, HumanInputIsAlwaysDelivered) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  for (InputOwnershipMode mode :
+       {InputOwnershipMode::kAi, InputOwnershipMode::kAssist,
+        InputOwnershipMode::kHuman}) {
+    decider_.SetModeForTesting(mode);
+    ASSERT_TRUE(HumanMouse(Type::kMouseDown, now))
+        << "mode=" << static_cast<int>(mode);
+    EXPECT_TRUE(HumanMouse(Type::kMouseMove, now));
+    EXPECT_TRUE(HumanKey(Type::kRawKeyDown, now));
+    EXPECT_TRUE(HumanKey(Type::kChar, now));
+    blink::WebMouseEvent human_mouse(Type::kMouseDown, kHumanModifiers, now);
+    EXPECT_TRUE(DebuggerEvent(SessionA(), human_mouse, now));
+  }
+}
+
+// Human input must not consume the assist-mode grant.
+TEST_F(InputOwnershipDeciderTest, HumanInputDoesNotConsumeGrant) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 2, base::Seconds(10), now);
+
+  EXPECT_TRUE(HumanMouse(Type::kMouseDown, now));
+  EXPECT_TRUE(HumanKey(Type::kRawKeyDown, now));
+  EXPECT_TRUE(HumanMouse(Type::kMouseMove, now));
+  EXPECT_EQ(2, Remaining(SessionA()));
+}
+
+// HUMAN mode drops every debugger-originated event and does not consume the
+// grant.
+TEST_F(InputOwnershipDeciderTest, HumanModeDropsDebuggerInput) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 10, base::Seconds(10), now);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, now));
+  EXPECT_FALSE(Mouse(Type::kMouseMove, now));
+  EXPECT_FALSE(Wheel(now));
+  EXPECT_FALSE(Key(Type::kRawKeyDown, now));
+  EXPECT_FALSE(Key(Type::kChar, now));
+  EXPECT_FALSE(Text(now));
+  EXPECT_EQ(10, Remaining(SessionA()));
+}
+
+// AI mode delivers everything without touching the grant. AI is never the
+// default, so it must be set explicitly.
+TEST_F(InputOwnershipDeciderTest, AiModeDeliversDebuggerInput) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAi);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 3, base::Seconds(10), now);
+
+  EXPECT_EQ(InputOwnershipMode::kAi, decider_.snapshot().mode);
+  EXPECT_TRUE(Mouse(Type::kMouseDown, now));
+  EXPECT_TRUE(Mouse(Type::kMouseUp, now + base::Milliseconds(5)));
+  EXPECT_TRUE(Wheel(now));
+  EXPECT_TRUE(Key(Type::kRawKeyDown, now));
+  EXPECT_TRUE(Key(Type::kKeyUp, now));
+  EXPECT_TRUE(Text(now));
+  // Unattributed debugger input is fine in AI (the whole tab is automated).
+  EXPECT_TRUE(UnattributedDebuggerMouse(Type::kMouseMove, now));
+  EXPECT_EQ(3, Remaining(SessionA()));
+}
+
+// ASSIST without any grant drops all debugger input.
+TEST_F(InputOwnershipDeciderTest, AssistWithoutGrantDropsDebuggerInput) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, now));
+  EXPECT_FALSE(Mouse(Type::kMouseMove, now));
+  EXPECT_FALSE(Wheel(now));
+  EXPECT_FALSE(Key(Type::kRawKeyDown, now));
+  EXPECT_FALSE(Key(Type::kChar, now));
+  EXPECT_FALSE(Text(now));
+  EXPECT_EQ(0, Remaining(SessionA()));
+}
+
+// Debugger input that cannot be attributed to a session is only acceptable in
+// AI mode. In ASSIST/HUMAN it fails closed and never spends another session's
+// grant.
+TEST_F(InputOwnershipDeciderTest, UnattributedDebuggerInputFailsClosed) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 5, base::Seconds(10), now);
+
+  blink::WebMouseEvent debugger_mouse(Type::kMouseDown, kDebuggerModifiers,
+                                      now);
+  EXPECT_FALSE(decider_.ShouldDeliverEvent(debugger_mouse, now));
+  EXPECT_FALSE(DebuggerEvent(nullptr, debugger_mouse, now));
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerTextInsert(nullptr, now));
+  EXPECT_EQ(5, Remaining(SessionA()));
+
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  EXPECT_FALSE(decider_.ShouldDeliverEvent(debugger_mouse, now));
+
+  decider_.SetModeForTesting(InputOwnershipMode::kAi);
+  EXPECT_TRUE(decider_.ShouldDeliverEvent(debugger_mouse, now));
+}
+
+// One grant unit covers exactly one mouse gesture: press and release are
+// delivered, the next press is rejected.
+TEST_F(InputOwnershipDeciderTest, AssistGrantOneAllowsOnePointerGesture) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 1, base::Seconds(10), now);
+
+  EXPECT_TRUE(Mouse(Type::kMouseDown, now));
+  EXPECT_EQ(0, Remaining(SessionA()));
+  EXPECT_TRUE(Mouse(Type::kMouseUp, now + base::Milliseconds(10)));
+  EXPECT_FALSE(Mouse(Type::kMouseDown, now + base::Milliseconds(500)));
+}
+
+// A press that is not granted must not leak its release to the page.
+TEST_F(InputOwnershipDeciderTest, AssistDroppedPressAlsoDropsRelease) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+
+  EXPECT_FALSE(Mouse(Type::kMouseDown, now));
+  EXPECT_FALSE(Mouse(Type::kMouseUp, now + base::Milliseconds(10)));
+}
+
+// Bare moves outside a granted gesture each cost one unit.
+TEST_F(InputOwnershipDeciderTest, AssistBareMoveCostsOneUnit) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 1, base::Seconds(10), now);
+
+  EXPECT_TRUE(Mouse(Type::kMouseMove, now));
+  EXPECT_EQ(0, Remaining(SessionA()));
+  EXPECT_FALSE(Mouse(Type::kMouseMove, now + base::Milliseconds(1)));
+}
+
+// One wheel command costs one unit. (InputHandler performs a single decision per
+// `Input.dispatchMouseEvent` wheel command, which then forwards a real wheel
+// event plus a synthetic phaseEnded event under one authorization scope.)
+TEST_F(InputOwnershipDeciderTest, AssistWheelCostsOneUnitPerCommand) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  decider_.SetModeForTesting(InputOwnershipMode::kAssist);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 1, base::Seconds(10), now);
+
+  EXPECT_TRUE(Wheel(now));
+  EXPECT_EQ(0, Remaining(SessionA()));
+  EXPECT_FALSE(Wheel(now + base::Milliseconds(1)));
+}
+
