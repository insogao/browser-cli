+
+namespace content {
+
+InputOwnershipController::InputOwnershipController(WebContents* web_contents)
+    : WebContentsUserData<InputOwnershipController>(*web_contents) {}
+
+InputOwnershipController::~InputOwnershipController() = default;
+
+bool InputOwnershipController::ShouldDropAutomationEvent(
+    const blink::WebInputEvent& event) {
+  return !decider_.ShouldDeliverDebuggerEvent(event);
+}
