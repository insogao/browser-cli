+InputOwnershipSessionToken InputHandler::input_ownership_session_token() {
+  // One DevToolsSession == one grant bucket. The pointer is only used as an
+  // opaque key inside the decision engine (never dereferenced).
+  return static_cast<InputOwnershipSessionToken>(session());
+}
+
+InputOwnershipController* InputHandler::GetInputOwnershipController(
+    RenderWidgetHostImpl* widget_host) {
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return nullptr;
+  }
+  if (!widget_host || !widget_host->delegate()) {
+    return nullptr;
+  }
+  InputOwnershipController* controller =
+      widget_host->delegate()->GetInputOwnershipController();
+  if (controller) {
+    // Remember the controller weakly so Disable/teardown can revoke this
+    // session's grant without dereferencing a possibly-dead WebContents.
+    ownership_controller_ = controller->GetWeakPtr();
+  }
+  return controller;
+}
+
+bool InputHandler::ShouldDropDebuggerInput(
+    RenderWidgetHostImpl* widget_host,
+    const blink::WebInputEvent& event) {
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return false;
+  }
+  InputOwnershipController* controller =
+      GetInputOwnershipController(widget_host);
+  if (!controller) {
+    // Feature on but no arbitration state: a debugger command cannot be tied to
+    // a WebContents, so fail closed.
+    return true;
+  }
+  return controller->ShouldDropSessionEvent(input_ownership_session_token(),
+                                            event);
+}
+
+bool InputHandler::ShouldDropDebuggerTextInsert(
+    RenderWidgetHostImpl* widget_host) {
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return false;
+  }
+  InputOwnershipController* controller =
+      GetInputOwnershipController(widget_host);
+  if (!controller) {
+    return true;
+  }
+  return controller->ShouldDropSessionTextInsert(
+      input_ownership_session_token());
+}
+
+bool InputHandler::ShouldDropDebuggerCommand(
+    RenderWidgetHostImpl* widget_host,
+    InputOwnershipCommandKind kind) {
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return false;
+  }
+  InputOwnershipController* controller =
+      GetInputOwnershipController(widget_host);
+  if (!controller) {
+    // Fail closed: the command cannot be tied to a WebContents.
+    return true;
+  }
+  return controller->ShouldDropSessionCommand(input_ownership_session_token(),
+                                              kind);
+}
+
+uint64_t InputHandler::OpenAutomationEventWindowForCommand(
+    RenderWidgetHostImpl* widget_host) {
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return 0;
+  }
+  InputOwnershipController* controller =
+      GetInputOwnershipController(widget_host);
+  if (!controller) {
+    return 0;
+  }
+  // The command is accepted and already charged; make sure the renderer events
+  // it is about to produce are not mistaken for human input.
+  return controller->OpenAutomationEventWindow(
+      input_ownership_session_token(), base::TimeTicks::Now(),
+      kInputOwnershipAutomationWindow);
+}
+
+void InputHandler::CloseAutomationEventWindow(uint64_t automation_window_id) {
+  if (automation_window_id == 0) {
+    return;
+  }
+  if (ownership_controller_) {
+    ownership_controller_->CloseAutomationEventWindow(automation_window_id);
+  }
+}
+
+void InputHandler::RevokeInputOwnershipSession() {
+  if (!base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement)) {
+    return;
+  }
+  if (ownership_controller_) {
+    ownership_controller_->RevokeDebuggerSession(input_ownership_session_token());
   }
+  ownership_controller_ = nullptr;
 }
 
