+    : WebContentsUserData<InputOwnershipController>(*web_contents) {}
+
+InputOwnershipController::~InputOwnershipController() {
+  // The WebContents is going away: drop every grant and all gesture/text state
+  // so that nothing can outlive the tab (session tokens are revoked by their
+  // InputHandler as well, this is the belt-and-braces cleanup).
+  decider_.ClearDebuggerSessions();
+}
+
+bool InputOwnershipController::ShouldDropEvent(
+    const blink::WebInputEvent& event) {
+  return !decider_.ShouldDeliverEvent(event);
+}
+
+bool InputOwnershipController::ShouldDropSessionEvent(
+    InputOwnershipSessionToken session,
+    const blink::WebInputEvent& event) {
+  return !decider_.ShouldDeliverDebuggerEvent(session, event);
+}
+
+bool InputOwnershipController::ShouldDropSessionTextInsert(
+    InputOwnershipSessionToken session) {
+  return !decider_.ShouldDeliverDebuggerTextInsert(session);
+}
+
+bool InputOwnershipController::ShouldDropSessionCommand(
+    InputOwnershipSessionToken session,
+    InputOwnershipCommandKind kind) {
+  return !decider_.ShouldDeliverDebuggerCommand(session, kind);
+}
+
+uint64_t InputOwnershipController::OpenAutomationEventWindow(
+    InputOwnershipSessionToken session,
+    base::TimeTicks now,
+    base::TimeDelta max_duration) {
+  return decider_.OpenAutomationEventWindow(session, now, max_duration);
+}
+
+void InputOwnershipController::CloseAutomationEventWindow(uint64_t window_id) {
+  decider_.CloseAutomationEventWindow(window_id);
+}
+
+bool InputOwnershipController::IsAutomationEventWindowOpen() const {
+  return decider_.IsAutomationEventWindowOpen();
+}
+
+bool InputOwnershipController::IsDebuggerInputPaused() {
+  return decider_.IsDebuggerInputPaused();
+}
+
+void InputOwnershipController::RevokeDebuggerSession(
+    InputOwnershipSessionToken session) {
+  decider_.RevokeDebuggerSession(session);
+}
+
+void InputOwnershipController::SetModeForTesting(InputOwnershipMode mode) {
+  decider_.SetModeForTesting(mode);
+}
+
+void InputOwnershipController::GrantDebuggerInputForTesting(
+    InputOwnershipSessionToken session,
+    int actions,
+    base::TimeDelta ttl,
+    base::TimeTicks now) {
+  decider_.GrantDebuggerInputForTesting(session, actions, ttl, now);
+}
+
+void InputOwnershipController::NotifyHumanPresenceForTesting(
+    base::TimeTicks now) {
+  decider_.NotifyHumanPresenceForTesting(now);
+}
+
+ScopedInputOwnershipAuthorization::ScopedInputOwnershipAuthorization(
+    InputOwnershipController* controller)
+    : controller_(controller) {
+  if (controller_) {
+    ++controller_->debugger_authorization_depth_;
+  }
+}
+
+ScopedInputOwnershipAuthorization::~ScopedInputOwnershipAuthorization() {
+  if (controller_) {
+    --controller_->debugger_authorization_depth_;
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(InputOwnershipController);
+
+}  // namespace content
