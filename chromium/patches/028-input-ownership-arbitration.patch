index 00000000..7abe4699
--- /dev/null
+++ b/content/browser/input_ownership/input_ownership_decider.cc
@@ -0,0 +1,506 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/public/browser/input_ownership.h"
+
+#include <algorithm>
+
+#include "base/feature_list.h"
+#include "content/public/common/content_features.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+
+namespace content {
+
+namespace {
+
+// Caps mirrored from the extension-side grant constants (design §12.5/§13.5.2).
+constexpr int kMaxGrantActions = 10000;
+constexpr base::TimeDelta kMaxGrantTtl = base::Seconds(600);
+
+// A granted mouse press frees the matching release and any move/context-menu
+// event for this long after the release, and the whole press (including a drag)
+// lasts at most `kMouseGestureMaxDuration`.
+constexpr base::TimeDelta kMouseGestureGrace = base::Milliseconds(200);
+constexpr base::TimeDelta kMouseGestureMaxDuration = base::Seconds(5);
+
+// One physical key press (RawKeyDown ... Char/KeyUp) lasts at most this long.
+constexpr base::TimeDelta kKeyGestureMaxDuration = base::Seconds(2);
+
+// Consecutive `Input.insertText` calls within this window count as one grant
+// (covers `type` sending one call per character). The window is always capped
+// by the grant deadline and can therefore never be extended indefinitely.
+constexpr base::TimeDelta kTextGestureGrace = base::Milliseconds(300);
+
+// Every human input event immediately suppresses all debugger input for this
+// long (refreshed on each human event). The pause is not debounced: as soon as
+// a human touches the tab, automation must stop changing the page.
+constexpr base::TimeDelta kHumanInputPause = base::Seconds(1);
+
+// Human presence is *reported* at most once per window; this only affects the
+// reporting counter, never the pause above.
+constexpr base::TimeDelta kHumanPresenceDebounce = base::Milliseconds(300);
+
+// Upper bound for the automation event window opened by a command whose
+// renderer events lose `kFromDebugger` (synthetic gestures, emulated touch).
+// Closing explicitly when the gesture finishes is preferred; this cap only
+// keeps a leaked window from lasting forever.
+constexpr base::TimeDelta kMaxAutomationEventWindow = base::Seconds(5);
+
+bool IsFeatureEnabled() {
+  return base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement);
+}
+
+}  // namespace
+
+InputOwnershipDecider::InputOwnershipDecider() = default;
+InputOwnershipDecider::~InputOwnershipDecider() = default;
+
+bool InputOwnershipDecider::IsDebuggerEvent(
+    const blink::WebInputEvent& event) const {
+  return (event.GetModifiers() & blink::WebInputEvent::kFromDebugger) != 0;
+}
+
+bool InputOwnershipDecider::UnattributedDebuggerAllowed() const {
+  // A debugger event without a session token has no grant bucket to bill, so it
+  // is only acceptable where the whole tab is owned by automation. ASSIST and
+  // HUMAN fail closed.
+  return mode_ == InputOwnershipMode::kAi;
+}
+
+bool InputOwnershipDecider::ShouldDeliverEvent(const blink::WebInputEvent& event,
+                                               base::TimeTicks now) {
+  // Feature off: every event is delivered and no state is touched, including
+  // no human presence bookkeeping.
+  if (!IsFeatureEnabled()) {
+    return true;
+  }
+
+  // Human input is never subject to arbitration. Only events injected through
+  // DevTools carry kFromDebugger.
+  if (!IsDebuggerEvent(event)) {
+    NoteHumanPresence(now);
+    return true;
+  }
+
+  PurgeExpired(now);
+  if (IsDebuggerInputPaused(now)) {
+    return false;
+  }
+  return UnattributedDebuggerAllowed();
+}
+
+bool InputOwnershipDecider::ShouldDeliverDebuggerEvent(
+    InputOwnershipSessionToken session,
+    const blink::WebInputEvent& event,
+    base::TimeTicks now) {
+  if (!IsFeatureEnabled()) {
+    return true;
+  }
+
+  if (!IsDebuggerEvent(event)) {
+    // Defensive: an event delivered through the debugger path without the
+    // marker is still human input, so it must never be dropped (and it pauses
+    // debugger input like any other human event).
+    NoteHumanPresence(now);
+    return true;
+  }
+
+  PurgeExpired(now);
+  if (IsDebuggerInputPaused(now)) {
+    return false;
+  }
+
+  switch (mode_) {
+    case InputOwnershipMode::kAi:
+      return true;
+    case InputOwnershipMode::kHuman:
+      return false;
+    case InputOwnershipMode::kAssist:
+      break;
+  }
+
+  if (session == nullptr) {
+    return UnattributedDebuggerAllowed();
+  }
+
+  DebuggerSessionState* state = FindSession(session);
+  if (!state) {
+    return false;
+  }
+
+  const blink::WebInputEvent::Type type = event.GetType();
+
+  if (blink::WebInputEvent::IsMouseEventType(type)) {
+    return DecideMouse(*state, event, now);
+  }
+
+  if (blink::WebInputEvent::IsKeyboardEventType(type)) {
+    return DecideKey(*state, event, now);
+  }
+
+  // Wheel, touch and gesture events: one command costs one unit. (A single
+  // `Input.dispatchMouseEvent` wheel command emits two wheel events to the
+  // renderer; the InputHandler authorizes both with a single decision.)
+  return DecideUnknown(*state, now);
+}
+
+bool InputOwnershipDecider::ShouldDeliverDebuggerTextInsert(
+    InputOwnershipSessionToken session,
+    base::TimeTicks now) {
+  if (!IsFeatureEnabled()) {
+    return true;
+  }
+
+  PurgeExpired(now);
+  if (IsDebuggerInputPaused(now)) {
+    return false;
+  }
+
+  switch (mode_) {
+    case InputOwnershipMode::kAi:
+      return true;
+    case InputOwnershipMode::kHuman:
+      return false;
+    case InputOwnershipMode::kAssist:
+      break;
+  }
+
+  if (session == nullptr) {
+    return UnattributedDebuggerAllowed();
+  }
+
+  DebuggerSessionState* state = FindSession(session);
+  if (!state) {
+    return false;
+  }
+
+  // Consecutive insertions are treated as one gesture (typing). The window is
+  // capped by the absolute grant deadline, so a steady stream of insertions can
+  // never keep an expired grant alive.
+  if (!state->text_burst_until.is_null() && now < state->text_burst_until) {
+    state->text_burst_until =
+        CapToGrant(*state, now + kTextGestureGrace);
+    return true;
+  }
+
+  if (!ConsumeGrant(*state, now)) {
+    return false;
+  }
+  state->text_burst_until = CapToGrant(*state, now + kTextGestureGrace);
+  return true;
+}
+
+bool InputOwnershipDecider::IsDebuggerInputPaused(
+    base::TimeTicks now) const {
+  if (!IsFeatureEnabled()) {
+    return false;
+  }
+  return !human_pause_until_.is_null() && now < human_pause_until_;
+}
+
+bool InputOwnershipDecider::ShouldDeliverDebuggerCommand(
+    InputOwnershipSessionToken session,
+    InputOwnershipCommandKind kind,
+    base::TimeTicks now) {
+  if (!IsFeatureEnabled()) {
+    return true;
+  }
+
+  PurgeExpired(now);
+  if (IsDebuggerInputPaused(now)) {
+    return false;
+  }
+
+  switch (mode_) {
+    case InputOwnershipMode::kAi:
+      last_command_kind_ = kind;
+      return true;
+    case InputOwnershipMode::kHuman:
+      return false;
+    case InputOwnershipMode::kAssist:
+      break;
+  }
+
+  if (session == nullptr) {
+    return UnattributedDebuggerAllowed();
+  }
+
+  DebuggerSessionState* state = FindSession(session);
+  if (!state || !ConsumeGrant(*state, now)) {
+    return false;
+  }
+  last_command_kind_ = kind;
+  return true;
+}
+
+uint64_t InputOwnershipDecider::OpenAutomationEventWindow(
+    InputOwnershipSessionToken session,
+    base::TimeTicks now,
+    base::TimeDelta max_duration) {
+  if (!IsFeatureEnabled()) {
+    return 0;
+  }
+  const base::TimeDelta duration =
+      std::min(max_duration, kMaxAutomationEventWindow);
+  if (duration <= base::TimeDelta()) {
+    return 0;
+  }
+
+  // At most one window: gestures run one at a time per widget, and a new
+  // command supersedes a stale window. The old window stops matching its id, so
+  // a late completion callback cannot close the new one.
+  const uint64_t id = next_automation_window_id_++;
+  automation_window_.id = id;
+  automation_window_.session = session;
+  automation_window_.deadline = now + duration;
+  return id;
+}
+
+void InputOwnershipDecider::CloseAutomationEventWindow(uint64_t window_id) {
+  if (window_id != 0 && automation_window_.id == window_id) {
+    ClearAutomationEventWindow();
+  }
+}
+
+bool InputOwnershipDecider::IsAutomationEventWindowOpen(
+    base::TimeTicks now) const {
+  if (!IsFeatureEnabled()) {
+    return false;
+  }
+  return automation_window_.id != 0 && now < automation_window_.deadline;
+}
+
+void InputOwnershipDecider::ClearAutomationEventWindow() {
+  automation_window_ = AutomationEventWindow();
+}
+
+bool InputOwnershipDecider::DecideMouse(DebuggerSessionState& state,
+                                        const blink::WebInputEvent& event,
+                                        base::TimeTicks now) {
+  const blink::WebInputEvent::Type type = event.GetType();
+
+  if (type == blink::WebInputEvent::Type::kMouseDown) {
+    // A new press always starts a new gesture and always costs one unit.
+    state.mouse_gesture_open = false;
+    state.mouse_grace_until = base::TimeTicks();
+    if (!ConsumeGrant(state, now)) {
+      return false;
+    }
+    state.mouse_gesture_open = true;
+    state.mouse_gesture_deadline =
+        CapToGrant(state, now + kMouseGestureMaxDuration);
+    return true;
+  }
+
+  if (state.mouse_gesture_open) {
+    // Release and any follow-up event (move, drag) of a granted press are free.
+    if (type == blink::WebInputEvent::Type::kMouseUp) {
+      state.mouse_gesture_open = false;
+      state.mouse_grace_until = CapToGrant(state, now + kMouseGestureGrace);
+    }
+    return true;
+  }
+
+  if (!state.mouse_grace_until.is_null() && now < state.mouse_grace_until) {
+    return true;
+  }
+
+  if (type == blink::WebInputEvent::Type::kMouseUp) {
+    // The matching press was dropped; a lone release must not reach the page.
+    return false;
+  }
+
+  // Bare moves/hover (and any other mouse event outside a granted gesture) each
+  // cost one unit.
+  return ConsumeGrant(state, now);
+}
+
+bool InputOwnershipDecider::DecideKey(DebuggerSessionState& state,
+                                      const blink::WebInputEvent& event,
+                                      base::TimeTicks now) {
+  const blink::WebInputEvent::Type type = event.GetType();
+
+  if (type == blink::WebInputEvent::Type::kRawKeyDown ||
+      type == blink::WebInputEvent::Type::kKeyDown) {
+    // One physical key press costs one unit; its Char/KeyUp follow free.
+    state.key_gesture_open = false;
+    if (!ConsumeGrant(state, now)) {
+      return false;
+    }
+    state.key_gesture_open = true;
+    state.key_gesture_deadline =
+        CapToGrant(state, now + kKeyGestureMaxDuration);
+    return true;
+  }
+
+  // Char/KeyUp only make sense for a press that was delivered.
+  if (state.key_gesture_open) {
+    if (type == blink::WebInputEvent::Type::kKeyUp) {
+      state.key_gesture_open = false;
+    }
+    return true;
+  }
+  return false;
+}
+
+bool InputOwnershipDecider::DecideUnknown(DebuggerSessionState& state,
+                                          base::TimeTicks now) {
+  // Touch/gesture events are not wired to a separate decision point in this
+  // patch; if they reach this function they need a grant like any other
+  // automation input (fail closed).
+  return ConsumeGrant(state, now);
+}
+
+void InputOwnershipDecider::SetModeForTesting(InputOwnershipMode mode) {
+  if (mode == mode_) {
+    return;
+  }
+  mode_ = mode;
+  ++version_;
+  // A grant never survives a mode change, and stale gesture state must not leak
+  // into the new mode. The same applies to the automation event window: a mode
+  // switch must stop excusing unmarked renderer events. The human pause is
+  // deliberately kept: it is derived from a real human event and must keep
+  // suppressing automation for its remaining (at most one second) lifetime.
+  ClearDebuggerSessions();
+  ClearAutomationEventWindow();
+}
+
+void InputOwnershipDecider::GrantDebuggerInputForTesting(
+    InputOwnershipSessionToken session,
+    int actions,
+    base::TimeDelta ttl,
+    base::TimeTicks now) {
+  if (session == nullptr || actions <= 0 || ttl <= base::TimeDelta()) {
+    RevokeDebuggerSession(session);
+    return;
+  }
+  DebuggerSessionState& state = debugger_sessions_[session];
+  // A grant is a fresh, self-contained budget: the deadline is fixed here once
+  // and no subsequent input event can extend it.
+  state = DebuggerSessionState();
+  state.grant_remaining = std::min(actions, kMaxGrantActions);
+  state.grant_deadline = now + std::min(ttl, kMaxGrantTtl);
+}
+
+void InputOwnershipDecider::NotifyHumanPresenceForTesting(base::TimeTicks now) {
+  if (!IsFeatureEnabled()) {
+    return;
+  }
+  NoteHumanPresence(now);
+}
+
+void InputOwnershipDecider::RevokeDebuggerSession(
+    InputOwnershipSessionToken session) {
+  if (session == nullptr) {
+    return;
+  }
+  debugger_sessions_.erase(session);
+  if (automation_window_.session == session) {
+    ClearAutomationEventWindow();
+  }
+}
+
+void InputOwnershipDecider::ClearDebuggerSessions() {
+  debugger_sessions_.clear();
+}
+
+int InputOwnershipDecider::remaining_grant_for_testing(
+    InputOwnershipSessionToken session) const {
+  const DebuggerSessionState* state = FindSessionForTesting(session);
+  return state ? state->grant_remaining : 0;
+}
+
+InputOwnershipDecider::DebuggerSessionState*
+InputOwnershipDecider::FindSession(InputOwnershipSessionToken session) {
+  auto it = debugger_sessions_.find(session);
+  return it == debugger_sessions_.end() ? nullptr : &it->second;
+}
+
+const InputOwnershipDecider::DebuggerSessionState*
+InputOwnershipDecider::FindSessionForTesting(
+    InputOwnershipSessionToken session) const {
+  auto it = debugger_sessions_.find(session);
+  return it == debugger_sessions_.end() ? nullptr : &it->second;
+}
+
+void InputOwnershipDecider::PurgeExpired(base::TimeTicks now) {
+  for (auto it = debugger_sessions_.begin(); it != debugger_sessions_.end();) {
+    DebuggerSessionState& state = it->second;
+
+    // The grant deadline caps everything else, so an expired grant clears the
+    // whole session bucket (grant, gestures, text burst).
+    if (!state.grant_deadline.is_null() && now >= state.grant_deadline) {
+      it = debugger_sessions_.erase(it);
+      continue;
+    }
+
+    if (state.mouse_gesture_open &&
+        !state.mouse_gesture_deadline.is_null() &&
+        now >= state.mouse_gesture_deadline) {
+      state.mouse_gesture_open = false;
+      state.mouse_grace_until = base::TimeTicks();
+    }
+    if (!state.mouse_grace_until.is_null() &&
+        now >= state.mouse_grace_until) {
+      state.mouse_grace_until = base::TimeTicks();
+    }
+    if (state.key_gesture_open && !state.key_gesture_deadline.is_null() &&
+        now >= state.key_gesture_deadline) {
+      state.key_gesture_open = false;
+    }
+    if (!state.text_burst_until.is_null() && now >= state.text_burst_until) {
+      state.text_burst_until = base::TimeTicks();
+    }
+
+    // Exhausted and idle: nothing left to remember for this session, so drop
+    // the bucket (this is what keeps a leaked session token from holding an
+    // expired deadline forever).
+    if (state.grant_remaining == 0 && state.IsIdle()) {
+      it = debugger_sessions_.erase(it);
+      continue;
+    }
+
+    ++it;
+  }
+}
+
+bool InputOwnershipDecider::ConsumeGrant(DebuggerSessionState& session,
+                                         base::TimeTicks now) {
+  if (session.grant_remaining <= 0) {
+    return false;
+  }
+  if (session.grant_deadline.is_null() || now >= session.grant_deadline) {
+    return false;
+  }
+  --session.grant_remaining;
+  // `grant_deadline` is intentionally kept even when the last unit is spent:
+  // the gesture or text burst it paid for is still bounded by it. `PurgeExpired`
+  // drops the bucket once the grant is exhausted and idle.
+  return true;
+}
+
+base::TimeTicks InputOwnershipDecider::CapToGrant(
+    DebuggerSessionState& session,
+    base::TimeTicks deadline) const {
+  if (session.grant_deadline.is_null()) {
+    return deadline;
+  }
+  return std::min(deadline, session.grant_deadline);
+}
+
+void InputOwnershipDecider::NoteHumanPresence(base::TimeTicks now) {
+  // Pause is unconditional and immediate: no debounce may hide a human event
+  // from the debugger-input decision right after it happened.
+  human_pause_until_ = now + kHumanInputPause;
+
+  if (!last_human_presence_.is_null() &&
+      now - last_human_presence_ < kHumanPresenceDebounce) {
+    return;
+  }
+  last_human_presence_ = now;
+  ++human_presence_count_;
+}
+
+}  // namespace content
diff --git a/content/browser/renderer_host/render_widget_host_delegate.cc b/content/browser/renderer_host/render_widget_host_delegate.cc
index 942d2a5c..6455c1a2 100644
--- a/content/browser/renderer_host/render_widget_host_delegate.cc
+++ b/content/browser/renderer_host/render_widget_host_delegate.cc
@@ -42,6 +42,11 @@ bool RenderWidgetHostDelegate::ShouldIgnoreInputEvents() {
   return false;
 }
 
+InputOwnershipController*
+RenderWidgetHostDelegate::GetInputOwnershipController() {
+  return nullptr;
