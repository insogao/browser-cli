+// The automation event window is bounded, closes with its own id, is capped at
+// 5s, and is cleared by session revocation and by a mode change.
+TEST_F(InputOwnershipDeciderTest, AutomationEventWindowLifecycle) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+  EXPECT_FALSE(decider_.IsAutomationEventWindowOpen(now));
+
+  const uint64_t first =
+      decider_.OpenAutomationEventWindow(SessionA(), now, base::Seconds(2));
+  ASSERT_NE(0u, first);
+  EXPECT_TRUE(decider_.IsAutomationEventWindowOpen(now));
+  EXPECT_TRUE(
+      decider_.IsAutomationEventWindowOpen(now + base::Milliseconds(1999)));
+  EXPECT_FALSE(decider_.IsAutomationEventWindowOpen(now + base::Seconds(2)));
+
+  // A newer window supersedes the older one; the stale id cannot close it.
+  const uint64_t second =
+      decider_.OpenAutomationEventWindow(SessionA(), now, base::Seconds(2));
+  ASSERT_NE(first, second);
+  decider_.CloseAutomationEventWindow(first);
+  EXPECT_TRUE(decider_.IsAutomationEventWindowOpen(now));
+  decider_.CloseAutomationEventWindow(second);
+  EXPECT_FALSE(decider_.IsAutomationEventWindowOpen(now));
+
+  // The duration is capped at 5s.
+  const uint64_t capped =
+      decider_.OpenAutomationEventWindow(SessionA(), now, base::Seconds(60));
+  EXPECT_TRUE(
+      decider_.IsAutomationEventWindowOpen(now + base::Milliseconds(4999)));
+  EXPECT_FALSE(decider_.IsAutomationEventWindowOpen(now + base::Seconds(5)));
+  decider_.CloseAutomationEventWindow(capped);
+
+  // Revoking another session does not close it; revoking the owner does.
+  decider_.OpenAutomationEventWindow(SessionB(), now, base::Seconds(5));
+  decider_.RevokeDebuggerSession(SessionA());
+  EXPECT_TRUE(decider_.IsAutomationEventWindowOpen(now));
+  decider_.RevokeDebuggerSession(SessionB());
+  EXPECT_FALSE(decider_.IsAutomationEventWindowOpen(now));
+
+  // A mode change closes it.
+  decider_.OpenAutomationEventWindow(SessionA(), now, base::Seconds(5));
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  EXPECT_FALSE(decider_.IsAutomationEventWindowOpen(now));
+}
