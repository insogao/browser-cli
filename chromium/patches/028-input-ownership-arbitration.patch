--- /dev/null
+++ b/content/browser/input_ownership/input_ownership_decider.cc
@@ -0,0 +1,223 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/public/browser/input_ownership.h"
+
+#include <algorithm>
+
+#include "base/feature_list.h"
+#include "content/public/common/content_features.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+
+namespace content {
+
+namespace {
+
+// Caps mirrored from the extension-side grant constants (design §12.5/§13.5.2).
+constexpr int kMaxGrantActions = 10000;
+constexpr base::TimeDelta kMaxGrantTtl = base::Seconds(600);
+
+// A granted mouse press frees the matching release and any move/context-menu
+// event for this long after the release.
+constexpr base::TimeDelta kMouseGestureGrace = base::Milliseconds(200);
+
+// Consecutive `Input.insertText` calls within this window count as one grant
+// (covers `type` sending one call per character).
+constexpr base::TimeDelta kTextGestureGrace = base::Milliseconds(300);
+
+// Human presence is reported at most once per window.
+constexpr base::TimeDelta kHumanPresenceDebounce = base::Milliseconds(300);
+
+bool IsFeatureEnabled() {
+  return base::FeatureList::IsEnabled(features::kInputOwnershipEnforcement);
+}
+
+}  // namespace
+
+InputOwnershipDecider::InputOwnershipDecider() = default;
+InputOwnershipDecider::~InputOwnershipDecider() = default;
+
+bool InputOwnershipDecider::ShouldDeliverDebuggerEvent(
+    const blink::WebInputEvent& event,
+    base::TimeTicks now) {
+  // Feature off: every event is delivered and no state is touched, including
+  // no human presence bookkeeping.
+  if (!IsFeatureEnabled()) {
+    return true;
+  }
+
+  // Human input is never subject to arbitration. Only events injected through
+  // DevTools carry kFromDebugger.
+  if ((event.GetModifiers() & blink::WebInputEvent::kFromDebugger) == 0) {
+    NoteHumanPresence(now);
+    return true;
+  }
+
+  switch (mode_) {
+    case InputOwnershipMode::kAi:
+      return true;
+    case InputOwnershipMode::kHuman:
+      return false;
+    case InputOwnershipMode::kAssist:
+      break;
+  }
+
+  const blink::WebInputEvent::Type type = event.GetType();
+
+  if (blink::WebInputEvent::IsMouseEventType(type)) {
+    if (type == blink::WebInputEvent::Type::kMouseDown) {
+      // A new press always starts a new gesture and always costs one unit.
+      mouse_gesture_open_ = false;
+      mouse_grace_until_ = base::TimeTicks();
+      if (!ConsumeGrant(now)) {
+        return false;
+      }
+      mouse_gesture_open_ = true;
+      return true;
+    }
+    // Release and any follow-up event of a granted press are free.
+    if (mouse_gesture_open_) {
+      if (type == blink::WebInputEvent::Type::kMouseUp) {
+        mouse_gesture_open_ = false;
+        mouse_grace_until_ = now + kMouseGestureGrace;
+      }
+      return true;
+    }
+    if (!mouse_grace_until_.is_null() && now < mouse_grace_until_) {
+      return true;
+    }
+    if (type == blink::WebInputEvent::Type::kMouseUp) {
+      // The matching press was dropped; a lone release must not reach the page.
+      return false;
+    }
+    // Bare moves/hover (and any other mouse event outside a granted gesture)
+    // each cost one unit.
+    return ConsumeGrant(now);
+  }
+
+  if (type == blink::WebInputEvent::Type::kMouseWheel) {
+    // Every wheel tick costs one unit.
+    return ConsumeGrant(now);
+  }
+
+  if (blink::WebInputEvent::IsKeyboardEventType(type)) {
+    if (type == blink::WebInputEvent::Type::kRawKeyDown ||
+        type == blink::WebInputEvent::Type::kKeyDown) {
+      // One physical key press costs one unit; its Char/KeyUp follow free.
+      key_gesture_open_ = ConsumeGrant(now);
+      return key_gesture_open_;
+    }
+    // Char/KeyUp only make sense for a press that was delivered.
+    if (key_gesture_open_) {
+      if (type == blink::WebInputEvent::Type::kKeyUp) {
+        key_gesture_open_ = false;
+      }
+      return true;
+    }
+    return false;
+  }
+
+  // Touch/gesture events are not wired to this decision point in this patch.
+  // If they ever are, fail closed: they need a grant like any other automation
+  // input.
+  return ConsumeGrant(now);
+}
+
+bool InputOwnershipDecider::ShouldDeliverDebuggerTextInsert(
+    base::TimeTicks now) {
+  if (!IsFeatureEnabled()) {
+    return true;
+  }
+
+  switch (mode_) {
+    case InputOwnershipMode::kAi:
+      return true;
+    case InputOwnershipMode::kHuman:
+      return false;
+    case InputOwnershipMode::kAssist:
+      break;
+  }
+
+  // Consecutive insertions are treated as one gesture (typing), with a rolling
+  // window so that a long `type` call only costs a single unit.
+  if (!text_grace_until_.is_null() && now < text_grace_until_) {
+    text_grace_until_ = now + kTextGestureGrace;
+    return true;
+  }
+  if (!ConsumeGrant(now)) {
+    return false;
+  }
+  text_grace_until_ = now + kTextGestureGrace;
+  return true;
+}
+
+void InputOwnershipDecider::SetModeForTesting(InputOwnershipMode mode) {
+  if (mode == mode_) {
+    return;
+  }
+  mode_ = mode;
+  ++version_;
+  // A grant never survives a mode change, and stale gesture state must not leak
+  // into the new mode.
+  ClearGrant();
+  ClearGestureState();
+}
+
+void InputOwnershipDecider::GrantDebuggerInputForTesting(int actions,
+                                                         base::TimeDelta ttl,
+                                                         base::TimeTicks now) {
+  if (actions <= 0 || ttl <= base::TimeDelta()) {
+    ClearGrant();
+    return;
+  }
+  grant_remaining_ = std::min(actions, kMaxGrantActions);
+  grant_expires_at_ = now + std::min(ttl, kMaxGrantTtl);
+}
+
+void InputOwnershipDecider::NotifyHumanPresenceForTesting(base::TimeTicks now) {
+  if (!IsFeatureEnabled()) {
+    return;
+  }
+  NoteHumanPresence(now);
+}
+
+void InputOwnershipDecider::ClearGrant() {
+  grant_remaining_ = 0;
+  grant_expires_at_ = base::TimeTicks();
+}
+
+void InputOwnershipDecider::ClearGestureState() {
+  mouse_gesture_open_ = false;
+  mouse_grace_until_ = base::TimeTicks();
+  key_gesture_open_ = false;
+  text_grace_until_ = base::TimeTicks();
+}
+
+bool InputOwnershipDecider::HasValidGrant(base::TimeTicks now) const {
+  return grant_remaining_ > 0 && !grant_expires_at_.is_null() &&
+         now < grant_expires_at_;
+}
+
+bool InputOwnershipDecider::ConsumeGrant(base::TimeTicks now) {
+  if (!HasValidGrant(now)) {
+    ClearGrant();
+    return false;
+  }
+  --grant_remaining_;
+  if (grant_remaining_ == 0) {
+    grant_expires_at_ = base::TimeTicks();
+  }
+  return true;
+}
+
+void InputOwnershipDecider::NoteHumanPresence(base::TimeTicks now) {
+  if (!last_human_presence_.is_null() &&
+      now - last_human_presence_ < kHumanPresenceDebounce) {
+    return;
+  }
+  last_human_presence_ = now;
+  ++human_presence_count_;
+}
+
+}  // namespace content
