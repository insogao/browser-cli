+// --- Command-level arbitration (synthetic gestures / emulated touch) ---------
+
+// ASSIST/HUMAN/AI/pause/feature-off matrix for the command-level entry point.
+TEST_F(InputOwnershipDeciderTest, DebuggerCommandMatrix) {
+  EnableFeature();
+  const base::TimeTicks now = T0();
+
+  // ASSIST without a grant (and without a session token): rejected.
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerCommand(SessionA(), Kind::kScroll,
+                                                     now));
+  EXPECT_FALSE(
+      decider_.ShouldDeliverDebuggerCommand(nullptr, Kind::kTap, now));
+  EXPECT_EQ(0, Remaining(SessionA()));
+
+  // ASSIST with one unit: accepted exactly once.
+  decider_.GrantDebuggerInputForTesting(SessionA(), 1, base::Seconds(10), now);
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerCommand(SessionA(), Kind::kPinch,
+                                                    now));
+  EXPECT_EQ(0, Remaining(SessionA()));
+  ASSERT_TRUE(decider_.last_command_kind_for_testing().has_value());
+  EXPECT_EQ(Kind::kPinch, *decider_.last_command_kind_for_testing());
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerCommand(
+      SessionA(), Kind::kTap, now + base::Milliseconds(1)));
+
+  // HUMAN rejects without consuming the grant.
+  decider_.SetModeForTesting(InputOwnershipMode::kHuman);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 3, base::Seconds(10), now);
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerCommand(SessionA(), Kind::kScroll,
+                                                     now));
+  EXPECT_EQ(3, Remaining(SessionA()));
+
+  // AI accepts without consuming the grant.
+  decider_.SetModeForTesting(InputOwnershipMode::kAi);
+  decider_.GrantDebuggerInputForTesting(SessionA(), 3, base::Seconds(10), now);
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerCommand(SessionA(), Kind::kTouch,
+                                                    now));
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerCommand(
+      SessionA(), Kind::kEmulateTouchFromMouse, now));
+  EXPECT_EQ(3, Remaining(SessionA()));
+
+  // A human event immediately blocks commands, even in AI mode.
+  EXPECT_TRUE(HumanMouse(Type::kMouseMove, now));
+  EXPECT_FALSE(decider_.ShouldDeliverDebuggerCommand(
+      SessionA(), Kind::kTap, now + base::Milliseconds(1)));
+  // ... and the block expires with the human pause.
+  EXPECT_TRUE(decider_.ShouldDeliverDebuggerCommand(
+      SessionA(), Kind::kTap, now + base::Milliseconds(1100)));
+}
