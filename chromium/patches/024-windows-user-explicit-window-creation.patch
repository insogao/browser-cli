+// Resolves the profile an explicit `show` should use. Returns null when the
+// startup path would show a profile picker or a non-window startup, so this
+// path never invents a profile the user did not select.
+Profile* ResolveLoadedProfileForUserExplicitShow(
+    const base::CommandLine& command_line,
+    const base::FilePath& current_directory) {
+  ProfileManager* profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!profile_manager) {
+    return nullptr;
+  }
+  const StartupProfilePathInfo path_info = GetStartupProfilePath(
+      current_directory, command_line, /*ignore_profile_picker=*/true);
+  if (path_info.mode != StartupProfileMode::kBrowserWindow) {
+    return nullptr;
+  }
+  return profile_manager->GetProfileByPath(path_info.path);
+}
+
 }  // namespace
 
