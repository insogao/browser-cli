diff --git a/ui/views/widget/browser_cli_presentation_win.cc b/ui/views/widget/browser_cli_presentation_win.cc
index 5373b09c..e91a94e0 100644
--- a/ui/views/widget/browser_cli_presentation_win.cc
+++ b/ui/views/widget/browser_cli_presentation_win.cc
@@ -69,6 +69,71 @@ bool BrowserCliShouldSuppressWindowPosChange(HWND hwnd) {
       BrowserCliPresentationAction::kShowAndActivate, window_id);
 }
 
+bool BrowserCliPresentForAgentAssistAction(Widget* widget) {
+  if (!widget) {
+    return false;
+  }
+  // Only reachable after the policy granted the lease for this window. The
+  // scoped origin makes the host gates (DesktopWindowTreeHostWin::Show /
+  // Activate) re-check the same shared policy for kAgentAssist, so this never
+  // bypasses the gateway. A denial leaves the HWND untouched: no show-then-hide.
+  ScopedForegroundOrigin agent_scope(ForegroundOrigin::kAgentAssist);
+  widget->Show();
+  widget->Activate();
+  const bool visible = widget->IsVisible();
+  if (visible) {
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+              << " transition=assist-window-visible"
+              << " window_id=" << WindowIdForWidget(widget)
+              << " reason=agent-assist-lease-granted native=win-hwnd";
+  }
+  return visible;
+}
+
+bool BrowserCliHideForForegroundAssistRelease(Widget* widget,
+                                              uint64_t generation) {
+  const uint64_t window_id = WindowIdForWidget(widget);
+  if (window_id == 0) {
+    // Fail closed: an unresolvable window must not be hidden.
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+              << " transition=assist-window-background decision=refused"
+              << " window_id=0 reason=unresolvable-window native=win-hwnd";
+    return false;
+  }
+  BrowserCliPresentationPolicy* policy = BrowserCliPresentationPolicy::Get();
+  // Defense in depth: the timeout and release owners already check this, but
+  // the gateway itself must never hide a window the user owns (invariant 5.3).
+  if (policy->IsUserExplicitOwned(window_id)) {
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+              << " transition=assist-window-background decision=refused"
+              << " window_id=" << window_id
+              << " reason=human-owned-window native=win-hwnd";
+    return false;
+  }
+  // ABA guard: when a live lease (necessarily a newer generation than the one
+  // the caller released) covers the window again, a stale release must not
+  // hide it.
+  if (policy->IsForegroundAssistLeased(window_id) &&
+      policy->GetForegroundAssistLeaseGeneration(window_id) != generation) {
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+              << " transition=assist-window-background decision=refused"
+              << " window_id=" << window_id
+              << " reason=newer-lease-generation-active native=win-hwnd";
+    return false;
+  }
+  ScopedForegroundOrigin agent_scope(ForegroundOrigin::kAgentAssist);
+  widget->Hide();
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+            << " transition=assist-window-background"
+            << " window_id=" << window_id
+            << " reason=assist-lease-released native=win-hwnd";
+  return true;
+}
+
+bool BrowserCliIsEligibleForegroundAssistTarget(Widget* widget) {
+  return widget && widget->is_top_level();
+}
