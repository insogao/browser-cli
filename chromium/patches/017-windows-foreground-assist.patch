diff --git a/chrome/browser/browser_cli/foreground_assist_presentation_win.cc b/chrome/browser/browser_cli/foreground_assist_presentation_win.cc
new file mode 100644
index 00000000..865d0a74
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist_presentation_win.cc
@@ -0,0 +1,293 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/foreground_assist_presentation.h"
+
+#include <stdint.h>
+
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/notreached.h"
+#include "chrome/browser/browser_cli/foreground_assist.h"
+#include "chrome/browser/browser_cli/foreground_assist_controller.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/base_window.h"
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+#include "ui/views/widget/browser_cli_presentation_win.h"
+#include "ui/views/widget/widget.h"
+
+namespace browser_cli {
+namespace {
+
+// Structured producer log, same vocabulary as the macOS producer. `result` is
+// handled / denied / failed / noop and `reason` is the stable machine-readable
+// outcome; the shared policy and the Windows host add their own
+// BROWSER_CLI_PRESENTATION logs for every actual request, so a producer outcome
+// can always be correlated with a grant / deny / busy / timeout / release
+// decision.
+void LogProducerOutcome(const char* result,
+                        const char* reason,
+                        bool managed_mode,
+                        uint64_t window_id,
+                        const char* lease_reason) {
+  LOG(INFO) << "BROWSER_CLI_FOREGROUND_ASSIST stage=producer"
+            << " result=" << result << " reason=" << reason
+            << " window_id=" << window_id << " lease_reason=" << lease_reason
+            << " managed=" << (managed_mode ? "yes" : "no")
+            << " native=win-hwnd";
+}
+
+// Resolves the top-level views widget of the BrowserWindow identified by
+// `window_id` (the HWND-derived policy key). Only windows that belong to a
+// real BrowserWindow are considered, so child widgets, bubbles, menus and
+// non-browser top-level windows (for example dialogs) never resolve.
+views::Widget* FindWidgetForWindowId(uint64_t window_id) {
+  if (window_id == 0) {
+    return nullptr;
+  }
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  if (!collection) {
+    return nullptr;
+  }
+  views::Widget* found = nullptr;
+  collection->ForEach([&found, window_id](BrowserWindowInterface* browser) {
+    ui::BaseWindow* base_window = browser ? browser->GetWindow() : nullptr;
+    if (!base_window) {
+      return true;
+    }
+    views::Widget* widget = views::Widget::GetWidgetForNativeWindow(
+        base_window->GetNativeWindow());
+    if (!widget) {
+      return true;
+    }
+    aura::Window* native_window = widget->GetNativeWindow();
+    aura::WindowTreeHost* host =
+        native_window ? native_window->GetHost() : nullptr;
+    if (!host ||
+        views::BrowserCliWindowIdForHwnd(host->GetAcceleratedWidget()) !=
+            window_id) {
+      return true;
+    }
+    found = widget;
+    return false;
+  });
+  return found;
+}
+
+// Routes the controller's effects to the single Windows presentation gateway.
+// Every call re-resolves the window by id, so a destroyed window can never be
+// touched and a recycled HWND cannot inherit the lease (the policy releases the
+// lease on destruction). Generation-aware: each call names the lease generation
+// it acts on, and the policy/gateway re-verify it, so a stale timer or release
+// can never kill a newer lease of the same window.
+class BrowserWindowForegroundAssistDelegate
+    : public ForegroundAssistController::Delegate {
+ public:
+  bool WindowExists(uint64_t window_id) override {
+    return FindWidgetForWindowId(window_id) != nullptr;
+  }
+
+  bool WindowIsUserOwned(uint64_t window_id) override {
+    return views::BrowserCliPresentationPolicy::Get()->IsUserExplicitOwned(
+        window_id);
+  }
+
+  uint64_t CurrentLeaseGeneration(uint64_t window_id) override {
+    return views::BrowserCliPresentationPolicy::Get()
+        ->GetForegroundAssistLeaseGeneration(window_id);
+  }
+
+  bool ReleaseLeaseForTimeout(uint64_t window_id,
+                              uint64_t generation) override {
+    return views::BrowserCliPresentationPolicy::Get()->ReleaseForegroundAssist(
+        window_id, views::ForegroundAssistReleaseReason::kTimeout, generation);
+  }
+
+  void ReturnWindowToBackground(uint64_t window_id,
+                                uint64_t generation) override {
+    views::Widget* widget = FindWidgetForWindowId(window_id);
+    if (widget) {
+      views::BrowserCliHideForForegroundAssistRelease(widget, generation);
+    }
+  }
+};
+
+ForegroundAssistController* GetController() {
+  static base::NoDestructor<BrowserWindowForegroundAssistDelegate> delegate;
+  static base::NoDestructor<ForegroundAssistController> controller(
+      delegate.get(), views::kDefaultForegroundAssistLeaseTtl);
+  return controller.get();
+}
+
+// Whether `widget` is a top-level widget that belongs to a real BrowserWindow.
+// The eligibility check rejects child widgets / bubbles / menus; the collection
+// lookup rejects top-level widgets that are not browser windows (for example
+// dialogs).
+bool IsTopLevelBrowserWindow(views::Widget* widget) {
+  if (!views::BrowserCliIsEligibleForegroundAssistTarget(widget)) {
+    return false;
+  }
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  return collection &&
+         collection->FindBrowserWithWindow(widget->GetNativeWindow()) !=
+             nullptr;
+}
+
+}  // namespace
+
+ForegroundAssistController* GetForegroundAssistController() {
+  return GetController();
+}
+
+bool HandleForegroundAssistRequest(const base::CommandLine& command_line) {
+  ForegroundAssistRequest request;
+  const ForegroundAssistRequestClass request_class =
+      ClassifyForegroundAssistRequest(command_line, &request);
+  if (!ForegroundAssistRequestClassConsumesCommandLine(request_class)) {
+    // No assist switch: ordinary command-line processing continues.
+    return false;
+  }
+
+  views::BrowserCliPresentationPolicy* policy =
+      views::BrowserCliPresentationPolicy::Get();
+  const bool managed_mode = policy->IsManagedModeEnabled();
+  const char* lease_reason =
+      views::ForegroundAssistReasonToString(request.reason);
+
+  switch (request_class) {
+    case ForegroundAssistRequestClass::kBlockedByLaunchArguments:
+      // An assist invocation must never act as an ordinary URL / app /
+      // incognito / automation / headless launch: it is consumed here so the
+      // caller cannot fall through to normal command-line processing that might
+      // change a HUMAN-owned window or create a visible window.
+      LogProducerOutcome("denied", "launch-arguments-not-agent-assist",
+                         managed_mode, request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByUnsupportedTabTarget:
+      // Tab-level targeting is not implemented; reject instead of pretending
+      // the named tab was granted.
+      LogProducerOutcome("denied", "unsupported-tab-target", managed_mode,
+                         request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByConflictingSwitches:
+      LogProducerOutcome("denied", "conflicting-producer-switches",
+                         managed_mode, request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByInvalidReason:
+      LogProducerOutcome("denied", "invalid-reason", managed_mode,
+                         request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByInvalidTarget:
+      LogProducerOutcome("denied", "invalid-target", managed_mode,
+                         request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kNotRequested:
+      return false;
+    case ForegroundAssistRequestClass::kRequestLease:
+    case ForegroundAssistRequestClass::kReleaseLease:
+      break;
+  }
+
+  if (!managed_mode) {
+    // Stock Chromium has no assist: fail closed, present nothing.
+    LogProducerOutcome("noop", "unmanaged-stock-behavior", managed_mode,
+                       request.target_window, lease_reason);
+    return true;
+  }
+
+  views::Widget* widget = FindWidgetForWindowId(request.target_window);
+  if (!widget) {
+    LogProducerOutcome("denied", "target-window-not-found", managed_mode,
+                       request.target_window, lease_reason);
+    return true;
+  }
+  // Only a top-level BrowserWindow may be named: child widgets, bubbles, menus
+  // and non-browser top-level windows (for example dialogs) fail closed.
+  if (!IsTopLevelBrowserWindow(widget)) {
+    LogProducerOutcome("denied", "target-not-top-level-browser-window",
+                       managed_mode, request.target_window, lease_reason);
+    return true;
+  }
+
+  const uint64_t window_id = request.target_window;
+  if (request_class == ForegroundAssistRequestClass::kRequestLease) {
+    // Invariant 5.3: a window the user owns is never a valid assist target.
+    if (policy->IsUserExplicitOwned(window_id)) {
+      LogProducerOutcome("denied", "target-human-owned", managed_mode,
+                         window_id, lease_reason);
+      return true;
+    }
+    switch (policy->RequestForegroundAssist(
+        views::ForegroundOrigin::kAgentAssist, window_id, request.target_tab,
+        request.reason)) {
+      case views::ForegroundAssistRequestResult::kGranted: {
+        // Only a granted lease may present the window, through the single
+        // Windows visibility gateway (kAgentAssist is checked by the shared
+        // policy again).
+        const uint64_t generation =
+            policy->GetForegroundAssistLeaseGeneration(window_id);
+        if (!views::BrowserCliPresentForAgentAssistAction(widget)) {
+          // A lease must not outlive a failed presentation: release exactly the
+          // generation that was just granted.
+          policy->ReleaseForegroundAssist(
+              window_id, views::ForegroundAssistReleaseReason::kAgentRelease,
+              generation);
+          LogProducerOutcome("failed", "presentation-denied", managed_mode,
+                             window_id, lease_reason);
+          return true;
+        }
+        // Hand the controller the generation the policy actually minted, so its
+        // timer tracks the lease and not just the window id. A re-request for
+        // the same live lease reports the unchanged generation, which keeps the
+        // original deadline; a regrant reports the new one, which replaces the
+        // timer (P0 ABA fix).
+        GetController()->OnLeaseGranted(window_id, generation);
+        LogProducerOutcome("handled", "lease-granted-and-presented",
+                           managed_mode, window_id, lease_reason);
+        return true;
+      }
+      case views::ForegroundAssistRequestResult::kDenied:
+        LogProducerOutcome("denied", "lease-denied", managed_mode, window_id,
+                           lease_reason);
+        return true;
+      case views::ForegroundAssistRequestResult::kBusy:
+        LogProducerOutcome("denied", "lease-busy", managed_mode, window_id,
+                           lease_reason);
+        return true;
+      case views::ForegroundAssistRequestResult::kInvalidTarget:
+        LogProducerOutcome("denied", "invalid-target", managed_mode, window_id,
+                           lease_reason);
+        return true;
+    }
+    NOTREACHED();
+  }
+
+  // Release path: only the requested window's current lease is touched.
+  // Capture its generation first so every step below (policy release, tracking
+  // cancel, hide) names exactly that generation and a newer one can never be
+  // killed by a stale release request.
+  const uint64_t generation =
+      policy->GetForegroundAssistLeaseGeneration(window_id);
+  if (generation == 0) {
+    LogProducerOutcome("denied", "no-matching-lease", managed_mode, window_id,
+                       lease_reason);
+    return true;
+  }
+  policy->ReleaseForegroundAssist(window_id,
+                                  views::ForegroundAssistReleaseReason::
+                                      kAgentRelease,
+                                  generation);
+  GetController()->OnLeaseReleasedByAgent(window_id, generation);
+  // Never hide a window the user has taken over: the gateway re-verifies the
+  // HUMAN ownership and the lease generation before issuing Hide.
+  views::BrowserCliHideForForegroundAssistRelease(widget, generation);
+  LogProducerOutcome("handled", "lease-released", managed_mode, window_id,
+                     lease_reason);
+  return true;
+}
+
+}  // namespace browser_cli
