+TEST_F(BrowserCliPresentationWinTest,
+       HideForForegroundAssistReleaseRefusesHumanOwnedWindow) {
+  std::unique_ptr<Widget> widget = CreateWidget();
+  const uint64_t window_id = WindowIdForWidget(widget.get());
+  ASSERT_NE(window_id, 0u);
+  ASSERT_TRUE(BrowserCliPresentationPolicy::Get()->AllowPresentation(
+      ForegroundOrigin::kUserExplicit,
+      BrowserCliPresentationAction::kShowAndActivate, window_id));
+  ASSERT_TRUE(
+      BrowserCliPresentationPolicy::Get()->IsUserExplicitOwned(window_id));
+
+  // A HUMAN-owned window is never hidden by an assist release, even with a
+  // matching (here: zero) generation.
+  EXPECT_FALSE(BrowserCliHideForForegroundAssistRelease(widget.get(), 0));
+}
+
+TEST_F(BrowserCliPresentationWinTest,
+       HideForForegroundAssistReleaseRefusesNewerLeaseGeneration) {
+  std::unique_ptr<Widget> widget = CreateWidget();
+  const uint64_t window_id = WindowIdForWidget(widget.get());
+  ASSERT_NE(window_id, 0u);
+  ASSERT_EQ(ForegroundAssistRequestResult::kGranted,
+            BrowserCliPresentationPolicy::Get()->RequestForegroundAssist(
+                ForegroundOrigin::kAgentAssist, window_id, 0,
+                ForegroundAssistReason::kOther));
+  const uint64_t generation =
+      BrowserCliPresentationPolicy::Get()->GetForegroundAssistLeaseGeneration(
+          window_id);
+  ASSERT_NE(generation, 0u);
+
+  // An older release (a different or zero generation) must never hide a
+  // window that is covered by a newer live lease.
+  EXPECT_FALSE(
+      BrowserCliHideForForegroundAssistRelease(widget.get(), generation - 1));
+  EXPECT_FALSE(BrowserCliHideForForegroundAssistRelease(widget.get(), 0));
+}
