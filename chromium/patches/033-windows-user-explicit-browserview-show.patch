+
+// Presents a browser window through BrowserWindow::Show(), not only the views
+// Widget. Widget::Show() makes the HWND visible, but BrowserView::Show() is
+// what initializes/synchronizes the browser contents and their compositor
+// visibility; skipping it leaves a visible HWND with a black surface while the
+// page is fully alive (AX tree and CDP screenshots still work).
+bool PresentBrowserWindowForUserExplicitAction(BrowserWindowInterface* browser,
+                                               views::Widget* widget) {
+  ui::BaseWindow* window = browser ? browser->GetWindow() : nullptr;
+  if (!window) {
+    return views::BrowserCliPresentForUserExplicitAction(widget);
+  }
+  views::ScopedForegroundOrigin origin_scope(
+      views::ForegroundOrigin::kUserExplicit);
+  window->Show();
+  if (widget) {
+    widget->Show();
+  }
+  window->Activate();
+  if (window->IsVisible()) {
+    return true;
+  }
+  // STARTUPINFO's first ShowWindow can be swallowed (patch 030); the second
+  // BrowserView::Show()/Widget::Show() is a regular ShowWindow.
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=producer"
+            << " transition=presentation-retry"
+            << " reason=browser-view-show-not-visible native=win-hwnd";
+  window->Show();
+  if (widget) {
+    widget->Show();
+  }
+  window->Activate();
+  return window->IsVisible();
 }
 
