# Browser CLI Windows RELEASE-LIKE build configuration (out/WinRelease).
#
# WINDOWS ONLY. This file is the out/WinRelease counterpart of
# chromium/args-windows.gn (out/WinDev). It deliberately does NOT replace or
# share the WinDev args: WinDev stays a component build with its own object
# tree and its own args.gn.
#
# The only differences from chromium/args-windows.gn are:
#   * is_component_build = false  (non-component, release-like linking)
#   * the comments below that record why this is NOT a public release artifact.
# Everything else (debug level, symbols, CPU, remote exec, branding, Windows
# icons, field-trial config) is intentionally identical so the WinDev and
# WinRelease binaries can be compared without a second variable.
#
# Required toolchain environment for every gn/ninja call (see
# docs/windows-environment-2026-10-22.md and scripts/configure-windows.sh):
#   DEPOT_TOOLS_WIN_TOOLCHAIN=0
#   vs2026_install=C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools
is_debug = false
# Non-component: static linking, no runtime component DLL set. This is the
# release-like shape; it also restores the pre-start CIG block in
# chrome/browser/chrome_content_browser_client.cc, which is compiled out under
# COMPONENT_BUILD. It is NOT a substitute for signing.
is_component_build = false
# No debug info. Keeps the tree small and the link feasible on this host.
symbol_level = 0
blink_symbol_level = 0
target_cpu = "x64"
# Local-only build: never route compilation to remote execution.
use_remoteexec = false
# NOT an official build: no PGO/ThinLTO/orderfile pipeline. This build is an
# internal unsigned test artifact for release-shape validation only. A public
# artifact must additionally come from the official Builder pipeline with
# PGO + official optimizations and a Developer ID/Authenticode signing step;
# this configuration must never be described as a signed or public release.
is_official_build = false
# Product identity for Windows version resources (ProductName / FileDescription
# / CompanyName), shared with the macOS BRANDING file (patch 002).
branding_file_path = "//chrome/app/theme/browser_cli/BRANDING"
# Icon directory (relative to //chrome) consumed by chrome_dll.rc through the
# BROWSER_CLI_WIN_ICON macro (patch 025). Generated by
# scripts/configure-windows.sh before gn gen; not committed.
browser_cli_win_icon_dir = "app/theme/browser_cli/win"

# Do not apply Chromium's test-only field-trial configuration to a non-branded
# product build. On Windows that config enables BrowserDynamicCodeDisabled
# (browser ACG before TSF init; Sogou's Xbyak JIT then fails and SogouPY calls
# ExitProcess(3)) and NetworkServiceSandboxWindows. Google-branded Chrome does
# not apply this config. Tests that need the test config must opt in with
# --enable-field-trial-config; this build refuses it (FIELDTRIAL_TESTING_ENABLED
# is 0, see components/variations/service/BUILD.gn).
#
# Consequence: NetworkServiceSandbox is NOT enabled by a field trial in this
# build. It is enabled explicitly at the product launch entry point with
# --enable-features=NetworkServiceSandbox (see
# config/windows-release-runtime-flags.env and docs/windows-release-build-*.md).
# Do NOT enable BrowserDynamicCodeDisabled: it breaks Sogou TSF input.
disable_fieldtrial_testing_config = true
