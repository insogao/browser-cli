# Browser CLI Windows build configuration (out/WinDev).
#
# WINDOWS ONLY. macOS must keep using chromium/args.gn, which carries the
# macOS-only values (arm64 CPU, app icon and branding selectors). Never copy
# this file over that one and never mix the two.
#
# Values match the Windows toolchain recorded in
# docs/windows-environment-2026-10-22.md (Visual Studio BuildTools 2026 18.11.1,
# Windows SDK 10.0.28000.0). Every gn/ninja call must carry both environment
# variables (see docs/windows-environment-2026-10-22.md and
# scripts/configure-windows.sh):
#   DEPOT_TOOLS_WIN_TOOLCHAIN=0
#   vs2026_install=C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools
is_debug = false
# Component (shared-library) build, as used for out/WinDev on this host.
is_component_build = true
# No debug info. Keeps the tree small and the link fast.
symbol_level = 0
blink_symbol_level = 0
target_cpu = "x64"
# Local-only build: never route compilation to remote execution.
use_remoteexec = false
# Product identity for Windows version resources (ProductName / FileDescription
# / CompanyName). The default derives from branding_path_component, which is
# "chromium" unless the tree is Google-branded, so without this line the Windows
# binaries report "Chromium / The Chromium Authors". This file is shared with
# the macOS BRANDING file (patch 002); it contains no macOS-only keys.
# Windows .ico resources are a separate switch (browser_cli_win_icon_dir below)
# because the .rc files branch on GOOGLE_CHROME_BRANDING and cannot derive an
# icon path from this file.
branding_file_path = "//chrome/app/theme/browser_cli/BRANDING"
# Icon directory (relative to //chrome) consumed by chrome_dll.rc through the
# BROWSER_CLI_WIN_ICON macro (patch 025). The .ico files are generated by
# scripts/generate-windows-icons.py and are NOT committed; run
# scripts/configure-windows.sh, which generates them before gn gen.
browser_cli_win_icon_dir = "app/theme/browser_cli/win"
